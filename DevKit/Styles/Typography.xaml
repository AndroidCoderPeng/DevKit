<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        ===== 全局字体规范 =====
        字体族：正文使用系统默认字体，图标使用 iconfont（DevKitIconFontFamily）。
        字号刻度：Key 直接以数值命名；系统默认字号即 12，需要 12 的地方不设 FontSize 即可。
        字重：Normal 为默认无需设置，SemiBold 直接写字面量，不定义资源。
    -->

    <!--  ===== 字体族 =====  -->
    <FontFamily x:Key="DevKitIconFontFamily">/DevKit;component/Fonts/#iconfont</FontFamily>

    <!--  ===== 字号刻度 =====  -->
    <sys:Double x:Key="DevKitFontSize10">10</sys:Double>
    <sys:Double x:Key="DevKitFontSize11">11</sys:Double>
    <sys:Double x:Key="DevKitFontSize13">13</sys:Double>
    <sys:Double x:Key="DevKitFontSize14">14</sys:Double>
    <sys:Double x:Key="DevKitFontSize15">15</sys:Double>
    <sys:Double x:Key="DevKitFontSize16">16</sys:Double>
    <sys:Double x:Key="DevKitFontSize18">18</sys:Double>
    <sys:Double x:Key="DevKitFontSize24">24</sys:Double>
    <sys:Double x:Key="DevKitFontSize32">32</sys:Double>
    <sys:Double x:Key="DevKitFontSize40">40</sys:Double>
</ResourceDictionary>
