<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <RootNamespace>DevKit</RootNamespace>
        <AssemblyName>DevKit</AssemblyName>
        <ApplicationIcon>Images\launcher.ico</ApplicationIcon>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <PlatformTarget Condition="'$(Platform)' == 'x64'">x64</PlatformTarget>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.161" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Prism.DryIoc" Version="8.1.97"/>
        <PackageReference Include="System.IO.Ports" Version="10.0.13" />
        <PackageReference Include="TouchSocket" Version="4.3.10"/>
        <PackageReference Include="TouchSocket.Core" Version="4.3.10"/>
        <PackageReference Include="TouchSocket.Http" Version="4.3.10"/>
        <PackageReference Include="TouchSocket.SerialPorts" Version="4.3.10"/>
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Fonts\iconfont.ttf"/>
        <Resource Include="Images\launcher.ico"/>
    </ItemGroup>
</Project>
