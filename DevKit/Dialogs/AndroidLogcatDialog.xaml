<UserControl
    x:Class="DevKit.Dialogs.AndroidLogcatDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:DevKit.ViewModels"
    Width="900"
    Height="640"
    d:DataContext="{d:DesignInstance Type=vm:AndroidLogcatDialogViewModel}"
    Background="White"
    mc:Ignorable="d">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <SolidColorBrush x:Key="TextBlockForegroundBrush" Color="#5f6b7a" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#93a0ae" />

        <SolidColorBrush x:Key="LevelVBrush" Color="#93A0AE" />
        <SolidColorBrush x:Key="LevelDBrush" Color="#2E7CF6" />
        <SolidColorBrush x:Key="LevelIBrush" Color="#16A34A" />
        <SolidColorBrush x:Key="LevelWBrush" Color="#F2994A" />
        <SolidColorBrush x:Key="LevelEBrush" Color="#E5484D" />

        <!--  普通按钮：白底灰框，hover 蓝（对应设计稿 .btn）  -->
        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DFE3EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource DevKitTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonContainerBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="#EAF1FE" />
                                <Setter TargetName="ButtonContainerBorder" Property="BorderBrush" Value="#2E7CF6" />
                                <Setter Property="TextElement.Foreground" Value="#2E7CF6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="#D9E7FD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  级别过滤 chip：未选中半透明，选中按 Background 着底色  -->
        <Style x:Key="LevelChipStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="#2E7CF6" />
            <Setter Property="Foreground" Value="#93A0AE" />
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border
                                x:Name="ColorBg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ColorBg" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AutoScrollToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Track"
                            Background="#DFE3EA"
                            CornerRadius="12">
                            <Ellipse
                                x:Name="Thumb"
                                Width="18"
                                Height="18"
                                Margin="3,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Fill="White"
                                RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect
                                        BlurRadius="4"
                                        Direction="270"
                                        Opacity="0.25"
                                        ShadowDepth="1"
                                        Color="#13223D" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2E7CF6" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="Thumb"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                To="12"
                                                Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="Thumb"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                To="0"
                                                Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  日志级别徽标：按 Level 着底色  -->
        <Style x:Key="LevelBadgeStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#2E7CF6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="V">
                    <Setter Property="Background" Value="#93A0AE" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="D">
                    <Setter Property="Background" Value="#16A34A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="I">
                    <Setter Property="Background" Value="#2E7CF6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="W">
                    <Setter Property="Background" Value="#F2994A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="E">
                    <Setter Property="Background" Value="#E5484D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ============ 工具条 ============  -->
        <Grid Grid.Row="0" Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Command="{Binding ClearCommand}"
                Style="{StaticResource CompactButtonStyle}">
                <Button.Content>
                    <StackPanel Margin="16,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="/DevKit;component/Fonts/#iconfont"
                            FontSize="16"
                            Text="&#xe666;" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{DynamicResource DevKitTextBrush}"
                            Text="清除" />
                    </StackPanel>
                </Button.Content>
            </Button>

            <Button
                Grid.Column="1"
                Margin="8,0,0,0"
                Command="{Binding PauseCommand}"
                Style="{StaticResource CompactButtonStyle}">
                <Button.Content>
                    <StackPanel Margin="16,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="/DevKit;component/Fonts/#iconfont"
                            FontSize="16"
                            Text="&#xe6fc;" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{DynamicResource DevKitTextBrush}"
                            Text="暂停" />
                    </StackPanel>
                </Button.Content>
            </Button>

            <!--  级别过滤 chips  -->
            <Border
                Grid.Column="3"
                Padding="3"
                Background="#F7F9FC"
                BorderBrush="{DynamicResource DevKitBorderBrush}"
                BorderThickness="1"
                CornerRadius="17">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton
                        Margin="2,0,0,0"
                        Background="{StaticResource LevelVBrush}"
                        Command="{Binding ToggleLevelCommand}"
                        CommandParameter="V"
                        Content="V"
                        Style="{StaticResource LevelChipStyle}" />

                    <ToggleButton
                        Margin="8,0"
                        Background="{StaticResource LevelDBrush}"
                        Command="{Binding ToggleLevelCommand}"
                        CommandParameter="D"
                        Content="D"
                        IsChecked="True"
                        Style="{StaticResource LevelChipStyle}" />

                    <ToggleButton
                        Background="{StaticResource LevelIBrush}"
                        Command="{Binding ToggleLevelCommand}"
                        CommandParameter="I"
                        Content="I"
                        IsChecked="True"
                        Style="{StaticResource LevelChipStyle}" />

                    <ToggleButton
                        Margin="8,0"
                        Background="{StaticResource LevelWBrush}"
                        Command="{Binding ToggleLevelCommand}"
                        CommandParameter="W"
                        Content="W"
                        IsChecked="True"
                        Style="{StaticResource LevelChipStyle}" />

                    <ToggleButton
                        Margin="0,0,2,0"
                        Background="{StaticResource LevelEBrush}"
                        Command="{Binding ToggleLevelCommand}"
                        CommandParameter="E"
                        Content="E"
                        IsChecked="True"
                        Style="{StaticResource LevelChipStyle}" />
                </StackPanel>
            </Border>

            <!--  搜索框  -->
            <Border
                Grid.Column="4"
                Height="34"
                Margin="16,0"
                Background="#F7F9FC"
                BorderThickness="1"
                CornerRadius="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource DevKitBorderBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=LogSearchTextBox}" Value="True">
                                <Setter Property="BorderBrush" Value="#2E7CF6" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect
                                            BlurRadius="6"
                                            Opacity="0.18"
                                            ShadowDepth="0"
                                            Color="#2E7CF6" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontFamily="/DevKit;component/Fonts/#iconfont"
                        FontSize="18"
                        Foreground="#93A0AE"
                        Text="&#xe6cc;" />

                    <Grid Grid.Column="1">
                        <TextBox
                            x:Name="LogSearchTextBox"
                            Width="196"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            Foreground="{DynamicResource DevKitTextBrush}"
                            Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="#93A0AE"
                            IsHitTestVisible="False"
                            Text="搜索 tag 或内容">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=LogSearchTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!--  自动滚动开关  -->
            <StackPanel
                Grid.Column="5"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    Foreground="{StaticResource TextBlockForegroundBrush}"
                    Text="自动滚动" />
                <ToggleButton
                    Margin="8,0,0,0"
                    IsChecked="{Binding AutoScroll}"
                    Style="{StaticResource AutoScrollToggleStyle}" />
            </StackPanel>
        </Grid>

        <!--  ============ 日志主体 ============  -->
        <Border
            Grid.Row="1"
            Margin="16"
            Background="White"
            BorderBrush="{DynamicResource DevKitBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <ListBox
                    Padding="6"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding LogsView}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border
                                            x:Name="ItemBorder"
                                            Padding="8,3"
                                            Background="Transparent"
                                            CornerRadius="6">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#EAF1FE" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  时间  -->
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontFamily="微软雅黑"
                                    Foreground="{StaticResource TextBlockForegroundBrush}"
                                    Text="{Binding Time}" />

                                <!--  级别徽标  -->
                                <Border
                                    Grid.Column="1"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LevelBadgeStyle}">
                                    <TextBlock
                                        Margin="5,1"
                                        HorizontalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding Level}" />
                                </Border>

                                <!--  进程 / 线程  -->
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="微软雅黑"
                                    Foreground="{StaticResource TextBlockForegroundBrush}"
                                    Text="{Binding Pid}" />

                                <!--  Tag  -->
                                <TextBlock
                                    Grid.Column="3"
                                    MaxWidth="180"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="微软雅黑"
                                    Foreground="{StaticResource TextBlockForegroundBrush}"
                                    Text="{Binding Tag}"
                                    TextTrimming="CharacterEllipsis" />

                                <!--  消息  -->
                                <TextBlock
                                    Grid.Column="4"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="微软雅黑"
                                    Foreground="Black"
                                    Text="{Binding Message}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Message}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!--  空态  -->
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="暂无日志">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Logs.Count, Mode=OneWay}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!--  ============ 底部状态栏 ============  -->
        <Grid Grid.Row="2" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border
                    Width="13"
                    Height="13"
                    VerticalAlignment="Center"
                    Background="#2E3DDC84"
                    CornerRadius="7">
                    <Border
                        Width="7"
                        Height="7"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#FF16A34A"
                        CornerRadius="4" />
                </Border>
                <TextBlock
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="11.5"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="正在监听 · adb logcat" />
            </StackPanel>

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="11.5"
                Foreground="{StaticResource TextMutedBrush}"
                Text="Debug 及以上级别" />
        </Grid>
    </Grid>
</UserControl>
