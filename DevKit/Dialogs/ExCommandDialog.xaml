<UserControl
    x:Class="DevKit.Dialogs.ExCommandDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:DevKit.ViewModels"
    Width="472"
    Height="318"
    d:DataContext="{d:DesignInstance Type=vm:ExCommandDialogViewModel}"
    mc:Ignorable="d">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <!--  分段控件内的单选按钮  -->
        <Style x:Key="SegmentRadioStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource DevKitTextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="SegmentBorder"
                            Background="Transparent"
                            CornerRadius="8"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DevKitAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{StaticResource DevKitAccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  普通按钮：白底灰框，hover 蓝  -->
        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource DevKitBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource DevKitTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonContainerBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="{StaticResource DevKitAccentSoftBrush}" />
                                <Setter TargetName="ButtonContainerBorder" Property="BorderBrush" Value="{StaticResource DevKitAccentBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource DevKitAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="{StaticResource DevKitAccentPressedSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  主按钮：蓝底白字  -->
        <Style x:Key="PrimaryCompactButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{StaticResource DevKitAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonContainerBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="{StaticResource DevKitAccentHoverBrush}" />
                                <Setter TargetName="ButtonContainerBorder" Property="BorderBrush" Value="{StaticResource DevKitAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="{StaticResource DevKitAccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource DevKitBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,24,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontFamily="/DevKit;component/Fonts/#iconfont"
                    FontSize="14"
                    Foreground="{StaticResource DevKitTextSecondaryBrush}"
                    Text="&#xe8a7;" />

                <TextBlock
                    Grid.Column="1"
                    Margin="8,0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource DevKitTextSecondaryBrush}"
                    Text="指令值" />

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="Red"
                    Text="*" />

                <Border
                    Grid.Column="3"
                    Margin="8,0"
                    Padding="2"
                    VerticalAlignment="Center"
                    Background="{StaticResource DevKitSurfaceBrush}"
                    BorderBrush="{DynamicResource DevKitBorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            Command="{Binding ComboBoxItemSelectedCommand}"
                            CommandParameter="0"
                            Content="HEX"
                            GroupName="LogDisplayEncoding"
                            IsChecked="True"
                            Style="{StaticResource SegmentRadioStyle}"
                            ToolTip="把指令内容转为 16 进制显示" />

                        <RadioButton
                            Command="{Binding ComboBoxItemSelectedCommand}"
                            CommandParameter="1"
                            Content="ASCII"
                            GroupName="LogDisplayEncoding"
                            Style="{StaticResource SegmentRadioStyle}"
                            ToolTip="把指令内容转为 ASCII 显示" />
                    </StackPanel>
                </Border>

                <TextBlock
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource DevKitTextMutedBrush}"
                    Text="{Binding Tips, FallbackValue='HEX 字节，空格分隔'}" />

                <Border
                    Grid.Column="5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    BorderBrush="{StaticResource DevKitBorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <TextBlock
                        Margin="8,1"
                        FontFamily="Consolas"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DevKitTextSecondaryBrush}"
                        Text="{Binding ExCommandValue.Length, StringFormat={}{0} B}" />
                </Border>

                <Button
                    Grid.Column="6"
                    Margin="8,0,0,0"
                    Command="{Binding FormatStyleCommand}"
                    Content="&#xe6f6;"
                    FontFamily="/DevKit;component/Fonts/#iconfont"
                    FontSize="10">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Width" Value="20" />
                            <Setter Property="Height" Value="20" />
                            <Setter Property="Background" Value="{StaticResource DevKitSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DevKitBorderStrongBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource DevKitTextMutedBrush}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="MiniBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4"
                                            TextElement.Foreground="{TemplateBinding Foreground}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MiniBorder" Property="Background" Value="{StaticResource DevKitAccent12Brush}" />
                                                <Setter TargetName="MiniBorder" Property="BorderBrush" Value="{StaticResource DevKitAccentBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource DevKitAccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="MiniBorder" Property="Opacity" Value="0.7" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CommandType}" Value="ASCII">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <TextBox Grid.Row="1" Text="{Binding ExCommandValue, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Height" Value="102" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Margin" Value="16,0" />
                        <Setter Property="Padding" Value="8" />
                        <Setter Property="VerticalContentAlignment" Value="Top" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="Foreground" Value="{DynamicResource DevKitTextBrush}" />
                        <Setter Property="Background" Value="{StaticResource DevKitSurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource DevKitBorderStrongBrush}" />
                        <Setter Property="CaretBrush" Value="{StaticResource DevKitAccentBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                    <Border
                                        x:Name="FieldBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="True">
                                        <Grid>
                                            <TextBlock
                                                x:Name="PlaceholderText"
                                                Padding="12,8"
                                                VerticalAlignment="Top"
                                                FontSize="13"
                                                Foreground="{StaticResource DevKitTextMutedBrush}"
                                                IsHitTestVisible="False"
                                                Text="{Binding CommandPlaceHolder, FallbackValue='如 aa550101，点格式化 → AA 55 01 01 '}"
                                                Visibility="Collapsed" />
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Top" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                                        </Trigger>

                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="FieldBorder" Property="Background" Value="White" />
                                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource DevKitAccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.6" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <Grid Grid.Row="2" Margin="16,16,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontFamily="/DevKit;component/Fonts/#iconfont"
                    FontSize="14"
                    Foreground="{StaticResource DevKitTextSecondaryBrush}"
                    Text="&#xe8dd;" />

                <TextBlock
                    Grid.Column="1"
                    Margin="8,0"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource DevKitTextSecondaryBrush}"
                    Text="备注" />

                <TextBlock
                    Grid.Column="2"
                    FontSize="12"
                    Foreground="{StaticResource DevKitTextMutedBrush}"
                    Text="可选，便于在指令列表中识别" />
            </Grid>

            <TextBox Grid.Row="3" Text="{Binding CommandMemo, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Margin" Value="16,0" />
                        <Setter Property="Padding" Value="8" />
                        <Setter Property="VerticalContentAlignment" Value="Top" />
                        <Setter Property="TextWrapping" Value="NoWrap" />
                        <Setter Property="Foreground" Value="{DynamicResource DevKitTextBrush}" />
                        <Setter Property="Background" Value="{StaticResource DevKitSurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource DevKitBorderStrongBrush}" />
                        <Setter Property="CaretBrush" Value="{StaticResource DevKitAccentBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                    <Border
                                        x:Name="FieldBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="True">
                                        <Grid>
                                            <TextBlock
                                                x:Name="PlaceholderText"
                                                Padding="12,8"
                                                VerticalAlignment="Top"
                                                FontSize="13"
                                                Foreground="{StaticResource DevKitTextMutedBrush}"
                                                IsHitTestVisible="False"
                                                Text="{Binding MemoPlaceHolder, FallbackValue='例如：握手请求 '}"
                                                Visibility="Collapsed" />
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Top" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                                        </Trigger>

                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="FieldBorder" Property="Background" Value="White" />
                                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource DevKitAccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.6" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Grid>

        <UniformGrid
            Grid.Row="1"
            Background="White"
            Columns="2"
            Rows="1">
            <Button
                Margin="16,16,8,16"
                Command="{Binding CancelDialogCommand}"
                Style="{StaticResource CompactButtonStyle}">
                <Button.Content>
                    <StackPanel Margin="12,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="/DevKit;component/Fonts/#iconfont"
                            FontSize="16"
                            Text="&#xe668;" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Text="取消" />
                    </StackPanel>
                </Button.Content>
            </Button>

            <Button Margin="8,16,16,16" Command="{Binding CommandSaveCommand}">
                <Button.Style>
                    <Style BasedOn="{StaticResource PrimaryCompactButtonStyle}" TargetType="Button">
                        <Setter Property="IsEnabled" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ExCommandValue.Length}" Value="0">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Content>
                    <StackPanel Margin="12,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="/DevKit;component/Fonts/#iconfont"
                            FontSize="16"
                            Text="&#xe648;" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Text="保存" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </UniformGrid>
    </Grid>
</UserControl>
