<Window
    x:Class="DevKit.Dialogs.ScreenshotExportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:DevKit.ViewModels"
    Title="截屏导出"
    Width="850"
    Height="520"
    d:DataContext="{d:DesignInstance Type=vm:ScreenshotExportDialogViewModel}"
    Background="White"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <LinearGradientBrush x:Key="ExportProgressForegroundBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0.0" Color="{StaticResource DevKitAccentColor}" />
            <GradientStop Offset="1.0" Color="{StaticResource DevKitAccentLightColor}" />
        </LinearGradientBrush>

        <Style x:Key="ShotCardStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border
                                x:Name="CardBorder"
                                Margin="4"
                                Padding="8"
                                Background="White"
                                BorderBrush="{StaticResource DevKitBorderBrush}"
                                BorderThickness="2"
                                CornerRadius="8">
                                <ContentPresenter />
                            </Border>

                            <!--  勾选圆点  -->
                            <Border
                                x:Name="CheckDot"
                                Width="20"
                                Height="20"
                                Margin="8,8,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="#38000000"
                                BorderBrush="#E6FFFFFF"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                Opacity="0">
                                <Path
                                    x:Name="CheckMark"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M 2,5 L 5,8 L 12,3"
                                    Opacity="0"
                                    Stroke="White"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="2" />
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#9CC0F7" />
                                <Setter TargetName="CheckDot" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource DevKitAccentBrush}" />
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource DevKitAccentSoftBrush}" />
                                <Setter TargetName="CheckDot" Property="Opacity" Value="1" />
                                <Setter TargetName="CheckDot" Property="Background" Value="{StaticResource DevKitAccentBrush}" />
                                <Setter TargetName="CheckDot" Property="BorderBrush" Value="White" />
                                <Setter TargetName="CheckMark" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  hover 操作按钮：半透明白胶囊，删除按钮 hover 变红  -->
        <Style x:Key="HoverActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Background" Value="#2EFFFFFF" />
            <Setter Property="BorderBrush" Value="#59FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource DevKitOnAccentBrush}" />
            <Setter Property="FontSize" Value="{StaticResource DevKitFontSize11}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="HoverButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverButtonBorder" Property="Background" Value="#57FFFFFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="Danger" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="HoverButtonBorder" Property="Background" Value="{StaticResource DevKitDangerBrush}" />
                                <Setter TargetName="HoverButtonBorder" Property="BorderBrush" Value="{StaticResource DevKitDangerBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  工具栏  -->
        <Grid Grid.Row="0" Margin="16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Command="{Binding ReLoadScreenshotsCommand}"
                Style="{StaticResource DevKitButtonStyle}">
                <Button.Content>
                    <StackPanel Margin="16,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DevKitIconFontFamily}"
                            FontSize="{StaticResource DevKitFontSize16}"
                            Text="&#xe602;" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Text="刷新" />
                    </StackPanel>
                </Button.Content>
            </Button>

            <Button
                Grid.Column="1"
                Margin="8,0"
                Command="{Binding SortScreenshotsCommand}"
                Style="{StaticResource DevKitButtonStyle}">
                <Button.Content>
                    <StackPanel Margin="16,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DevKitIconFontFamily}"
                            FontSize="{StaticResource DevKitFontSize16}"
                            Text="&#xe614;" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Text="排序" />
                    </StackPanel>
                </Button.Content>
            </Button>

            <Button
                Grid.Column="2"
                Command="{Binding SelectAllCommand}"
                Style="{StaticResource DevKitButtonStyle}">
                <Button.Content>
                    <StackPanel Margin="16,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DevKitIconFontFamily}"
                            FontSize="{StaticResource DevKitFontSize16}"
                            Text="&#xe602;" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Text="全选" />
                    </StackPanel>
                </Button.Content>
            </Button>

            <Button
                Grid.Column="3"
                Margin="8,0"
                Command="{Binding DeleteSelectedCommand}"
                Style="{StaticResource DevKitDangerButtonStyle}">
                <Button.Content>
                    <TextBlock
                        Margin="16,0"
                        VerticalAlignment="Center"
                        Text="删除选中" />
                </Button.Content>
            </Button>

            <Button
                Grid.Column="5"
                Command="{Binding CaptureScreenCommand}"
                Style="{StaticResource DevKitPrimaryButtonStyle}">
                <Button.Content>
                    <StackPanel Margin="16,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DevKitIconFontFamily}"
                            FontSize="{StaticResource DevKitFontSize16}"
                            Text="&#xe635;" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource DevKitFontSize13}"
                            Foreground="{StaticResource DevKitOnAccentBrush}"
                            Text="截取屏幕" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>

        <!--  网格 / 加载态 / 空态  -->
        <Grid Grid.Row="2" Background="{StaticResource DevKitBackgroundBrush}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl Margin="8" ItemsSource="{Binding Screenshots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton
                                Command="{Binding DataContext.ImageItemClickedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                Style="{StaticResource ShotCardStyle}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseDoubleClick">
                                        <i:InvokeCommandAction Command="{Binding DataContext.ImageItemDoubleClickedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                                <StackPanel>
                                    <Grid Width="132">
                                        <Border Background="#F0F3F7" CornerRadius="8">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                        </Border>

                                        <!--  hover 操作层  -->
                                        <Grid VerticalAlignment="Bottom">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <Border CornerRadius="0,0,10,10">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Offset="0" Color="Transparent" />
                                                        <GradientStop Offset="1" Color="#B30A121F" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <StackPanel
                                                Margin="0,8"
                                                HorizontalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Button
                                                    Command="{Binding DataContext.ImageItemDoubleClickedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource HoverActionButtonStyle}">
                                                    <Button.Content>
                                                        <TextBlock Margin="8,0" Text="预览" />
                                                    </Button.Content>
                                                </Button>
                                                <Button
                                                    Command="{Binding DataContext.DeleteSingleImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource HoverActionButtonStyle}"
                                                    Tag="Danger">
                                                    <Button.Content>
                                                        <TextBlock Margin="8,0" Text="删除" />
                                                    </Button.Content>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontSize="{StaticResource DevKitFontSize11}"
                                        Foreground="{StaticResource DevKitTextMutedBrush}"
                                        Text="{Binding TimeText}"
                                        TextTrimming="CharacterEllipsis" />

                                    <TextBlock
                                        FontSize="{StaticResource DevKitFontSize11}"
                                        Foreground="{StaticResource DevKitTextMutedBrush}"
                                        Text="{Binding SizeText}" />
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="加载中…">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="{StaticResource DevKitFontSize14}"
                FontWeight="SemiBold"
                Foreground="{StaticResource DevKitTextSecondaryBrush}"
                Text="设备上还没有截屏，点「截取屏幕」试试"
                Visibility="{Binding EmptyVisibility}" />
        </Grid>

        <!--  底部  -->
        <Grid Grid.Row="3" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{StaticResource DevKitTextSecondaryBrush}"
                    Text="保存到" />

                <Border
                    Width="320"
                    Height="32"
                    Margin="8,0"
                    Background="{StaticResource DevKitSurfaceBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource DevKitBorderStrongBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=SaveDirectoryTextBox}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource DevKitAccentBrush}" />
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect
                                                BlurRadius="6"
                                                Opacity="0.18"
                                                ShadowDepth="0"
                                                Color="{StaticResource DevKitAccentColor}" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBox
                        x:Name="SaveDirectoryTextBox"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="{StaticResource DevKitFontSize14}"
                        Foreground="{StaticResource DevKitTextBrush}"
                        Text="{Binding SaveDirectory}" />
                </Border>

                <Button Command="{Binding FolderBrowserCommand}" Style="{StaticResource DevKitButtonStyle}">
                    <Button.Content>
                        <TextBlock Margin="16,0" Text="浏览" />
                    </Button.Content>
                </Button>
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Margin="0,0,16,0"
                Orientation="Horizontal">
                <ProgressBar
                    Width="120"
                    Height="8"
                    Margin="8,0"
                    Visibility="{Binding ExportProgressVisibility}"
                    Value="{Binding ExportProgress}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Height" Value="6" />
                            <Setter Property="Width" Value="92" />
                            <Setter Property="Background" Value="{StaticResource DevKitSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource DevKitBorderBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource ExportProgressForegroundBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid>
                                            <Border
                                                x:Name="PART_Track"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3" />
                                            <Border
                                                x:Name="PART_Indicator"
                                                Margin="1"
                                                HorizontalAlignment="Left"
                                                Background="{TemplateBinding Foreground}"
                                                CornerRadius="2" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{StaticResource DevKitTextSecondaryBrush}"
                    Text="{Binding SelectedCount, StringFormat=已选 {0} 张}" />
            </StackPanel>

            <Button
                Grid.Column="2"
                Command="{Binding ExportScreenshotsCommand}"
                Style="{StaticResource DevKitPrimaryButtonStyle}">
                <Button.Content>
                    <TextBlock Margin="16,0" Text="导出选中" />
                </Button.Content>
            </Button>
        </Grid>
    </Grid>
</Window>