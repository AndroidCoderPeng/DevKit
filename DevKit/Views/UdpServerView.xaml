<UserControl
    x:Class="DevKit.Views.UdpServerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:bhv="clr-namespace:DevKit.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:DevKit.ViewModels"
    Width="1024"
    Height="760"
    d:DataContext="{d:DesignInstance Type=vm:UdpServerViewModel}"
    Background="{DynamicResource DevKitBackgroundBrush}"
    mc:Ignorable="d">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Foreground" Value="{StaticResource DevKitTextBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border
                            x:Name="ItemBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource DevKitAccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource DevKitAccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LocalHostComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource DevKitTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!--  外框：底色 / 边框 / 圆角  -->
                            <Border
                                x:Name="RootBorder"
                                Background="{StaticResource DevKitSurfaceBrush}"
                                BorderBrush="{StaticResource DevKitBorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                SnapsToDevicePixels="True" />

                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  左侧图标  -->
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontFamily="/DevKit;component/Fonts/#iconfont"
                                    FontSize="18"
                                    Foreground="{StaticResource DevKitTextMutedBrush}"
                                    Text="&#xe8b2;" />

                                <!--  选中项文本  -->
                                <ContentPresenter
                                    x:Name="ContentSite"
                                    Grid.Column="1"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    IsHitTestVisible="False"
                                    SnapsToDevicePixels="True" />

                                <!--  右侧箭头  -->
                                <Path
                                    x:Name="Arrow"
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Data="M 0,0 L 5,5 L 10,0"
                                    Stroke="{StaticResource DevKitTextSecondaryBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1" />
                            </Grid>

                            <!--  点击层：放在最上层捕获鼠标、驱动 IsDropDownOpen  -->
                            <ToggleButton
                                ClickMode="Press"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!--  下拉浮层（POPUP 名称必须保留为 PART_Popup）  -->
                            <Popup
                                x:Name="PART_Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="Slide">
                                <Border
                                    x:Name="DropDownBorder"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,4,0,0"
                                    Padding="2"
                                    Background="White"
                                    BorderBrush="{StaticResource DevKitBorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <ScrollViewer
                                        CanContentScroll="True"
                                        SnapsToDevicePixels="True"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!--  hover：边框变主色  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource DevKitAccentBrush}" />
                            </Trigger>

                            <!--  展开：箭头翻转  -->
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Arrow" Property="Data" Value="M 0,5 L 5,0 L 10,5" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{StaticResource DevKitSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DevKitBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="FieldBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource DevKitAccentBrush}" />
                                <Setter TargetName="FieldBorder" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource DevKitTextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" TextElement.Foreground="{TemplateBinding Foreground}">
                            <Border
                                x:Name="SwitchTrack"
                                Width="36"
                                Height="24"
                                Background="{StaticResource DevKitBorderStrongBrush}"
                                CornerRadius="12">
                                <Ellipse
                                    x:Name="SwitchThumb"
                                    Width="18"
                                    Height="18"
                                    Margin="3,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Fill="White"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Effect>
                                        <DropShadowEffect
                                            BlurRadius="4"
                                            Direction="270"
                                            Opacity="0.25"
                                            ShadowDepth="1"
                                            Color="{StaticResource DevKitShadowColor}" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource DevKitAccentBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="SwitchThumb"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                To="12"
                                                Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="SwitchThumb"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                To="0"
                                                Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  主按钮：蓝底白字  -->
        <Style x:Key="PrimaryCompactButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{StaticResource DevKitAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonContainerBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="{StaticResource DevKitAccentHoverBrush}" />
                                <Setter TargetName="ButtonContainerBorder" Property="BorderBrush" Value="{StaticResource DevKitAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="{StaticResource DevKitAccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  危险操作按钮：默认红字红框、悬浮红底白字  -->
        <Style x:Key="DangerOutlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource DevKitDanger40Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource DevKitDangerBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="DangerBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            TextBlock.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DangerBorder" Property="Background" Value="{StaticResource DevKitDangerBrush}" />
                                <Setter TargetName="DangerBorder" Property="BorderBrush" Value="{StaticResource DevKitDangerBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DangerBorder" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClientMiniButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontFamily" Value="/DevKit;component/Fonts/#iconfont" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource DevKitBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource DevKitTextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="CmdMiniBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CmdMiniBorder" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  复制：悬浮蓝色描边  -->
        <Style
            x:Key="ClientCopyButtonStyle"
            BasedOn="{StaticResource ClientMiniButtonStyle}"
            TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DevKitAccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DevKitAccentBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  移除：悬浮红底白字  -->
        <Style
            x:Key="ClientRemoveButtonStyle"
            BasedOn="{StaticResource ClientMiniButtonStyle}"
            TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DevKitDangerBrush}" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  分段控件内的单选按钮  -->
        <Style x:Key="SegmentRadioStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource DevKitTextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="SegmentBorder"
                            Background="Transparent"
                            CornerRadius="14"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DevKitAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{StaticResource DevKitAccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  紧凑按钮：白底灰框、悬浮蓝  -->
        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource DevKitBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource DevKitTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="CompactBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CompactBorder" Property="BorderBrush" Value="{StaticResource DevKitAccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource DevKitAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CompactBorder" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  消息条上的「复制」小按钮：默认透明、悬浮出现  -->
        <Style x:Key="CopyMiniButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource DevKitTextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="CopyBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CopyBorder" Property="Background" Value="{StaticResource DevKitAccent12Brush}" />
                                <Setter Property="Foreground" Value="{StaticResource DevKitAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  发送区输入框：多行、可换行  -->
        <Style x:Key="ComposerTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Background" Value="{StaticResource DevKitSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DevKitBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="ComposerBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ComposerBorder" Property="BorderBrush" Value="{StaticResource DevKitAccentBrush}" />
                                <Setter TargetName="ComposerBorder" Property="Background" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="14"
                Background="{Binding StateOuterBackgroundColor}"
                BorderBrush="{Binding StateOuterBorderColor}"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Margin="10,6" Orientation="Horizontal">
                    <Border
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Background="{Binding StateInnerBackgroundColor}"
                        CornerRadius="10">
                        <Border
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{Binding StateInnerBorderColor}"
                            CornerRadius="5" />
                    </Border>

                    <TextBlock
                        Margin="8,0,4,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{Binding StateTextColor}"
                        Text="{Binding StateText, FallbackValue=未监听}" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Margin="0,20"
                Background="{StaticResource DevKitBorderBrush}" />

            <ComboBox
                Grid.Column="2"
                Margin="14,8"
                ItemsSource="{Binding LocalHostSource}"
                SelectedItem="{Binding SelectedIp, Mode=TwoWay}"
                Style="{StaticResource LocalHostComboBoxStyle}" />

            <TextBlock
                Grid.Column="3"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Foreground="{StaticResource DevKitTextSecondaryBrush}"
                Text=":" />

            <TextBox
                Grid.Column="4"
                Width="100"
                Height="36"
                Margin="14,0"
                HorizontalContentAlignment="Center"
                MaxLength="6"
                Style="{StaticResource FieldTextBoxStyle}"
                Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}" />

            <Border
                Grid.Column="5"
                Margin="0,20"
                Background="{StaticResource DevKitBorderBrush}" />

            <TextBlock
                Grid.Column="6"
                Margin="14,0"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{StaticResource DevKitTextSecondaryBrush}"
                Text="空闲超时" />

            <TextBox
                Grid.Column="7"
                Width="60"
                Height="36"
                HorizontalContentAlignment="Center"
                MaxLength="3"
                Style="{StaticResource FieldTextBoxStyle}"
                Text="{Binding IdleTimeout, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock
                Grid.Column="8"
                Margin="14,0"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{StaticResource DevKitTextSecondaryBrush}"
                Text="s" />

            <Button
                Grid.Column="9"
                Margin="14,0"
                HorizontalAlignment="Right"
                Command="{Binding ListenPortCommand}"
                Style="{StaticResource PrimaryCompactButtonStyle}">
                <Button.Content>
                    <StackPanel Margin="12,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="/DevKit;component/Fonts/#iconfont"
                            FontSize="16"
                            Text="&#xe714;" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Text="{Binding ListenButtonText}" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  会话统计  -->
                    <Border
                        Grid.Row="0"
                        Background="White"
                        BorderBrush="{DynamicResource DevKitBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Margin="14,12">
                            <!--  标题 + 分隔线  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource DevKitTextBrush}"
                                    Text="监听概览" />

                                <Border
                                    Grid.Column="1"
                                    Height="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource DevKitBorderBrush}" />
                            </Grid>

                            <!--  运行时长  -->
                            <Border
                                Margin="0,12,0,0"
                                Padding="12,10"
                                Background="{StaticResource DevKitSurfaceBrush}"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{StaticResource DevKitTextMutedBrush}"
                                        Text="运行时长" />

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource DevKitTextBrush}"
                                        Text="{Binding RunningTime, FallbackValue=--:--:--}" />
                                </Grid>
                            </Border>

                            <UniformGrid
                                Margin="0,12,0,4"
                                Columns="2"
                                Rows="2">
                                <!--  活跃来源 / 未读消息  -->
                                <Border
                                    Margin="0,0,6,6"
                                    Padding="12,10"
                                    Background="{StaticResource DevKitSurfaceBrush}"
                                    CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{StaticResource DevKitTextMutedBrush}"
                                            Text="活跃来源" />

                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource DevKitSuccessBrush}"
                                                Text="{Binding ActiveClientCount, FallbackValue=0}" />

                                            <TextBlock
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Bottom"
                                                FontSize="11"
                                                Foreground="{StaticResource DevKitTextMutedBrush}"
                                                Text="{Binding ClientCount, StringFormat={}共 {0} 个}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border
                                    Margin="6,0,0,6"
                                    Padding="12,10"
                                    Background="{StaticResource DevKitSurfaceBrush}"
                                    CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{StaticResource DevKitTextMutedBrush}"
                                            Text="未读消息" />

                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource DevKitWarningBrush}"
                                                Text="{Binding UnReadMessageCount, FallbackValue=0}" />

                                            <TextBlock
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Bottom"
                                                FontSize="11"
                                                Foreground="{StaticResource DevKitTextMutedBrush}"
                                                Text="待查看" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!--  发送 / 接收  -->
                                <Border
                                    Margin="0,6,6,0"
                                    Padding="12,10"
                                    Background="{StaticResource DevKitSurfaceBrush}"
                                    CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{StaticResource DevKitTextMutedBrush}"
                                            Text="发送" />

                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource DevKitAccentBrush}"
                                                Text="{Binding SendCount, FallbackValue=0}" />

                                            <TextBlock
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Bottom"
                                                FontSize="11"
                                                Foreground="{StaticResource DevKitTextMutedBrush}"
                                                Text="{Binding SendByteSize, StringFormat={}共 {0} B}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border
                                    Margin="6,6,0,0"
                                    Padding="12,10"
                                    Background="{StaticResource DevKitSurfaceBrush}"
                                    CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{StaticResource DevKitTextMutedBrush}"
                                            Text="接收" />

                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource DevKitSuccessBrush}"
                                                Text="{Binding ReceiveCount, FallbackValue=0}" />

                                            <TextBlock
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Bottom"
                                                FontSize="11"
                                                Foreground="{StaticResource DevKitTextMutedBrush}"
                                                Text="{Binding ReceiveByteSize, StringFormat={}共 {0} B}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!--  客户端列表  -->
                    <Border
                        Grid.Row="1"
                        Margin="0,16,0,0"
                        Background="White"
                        BorderBrush="{DynamicResource DevKitBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <DockPanel Margin="14,12">
                            <!--  标题 + 数量 + 分隔线 + 新增  -->
                            <Grid DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource DevKitTextBrush}"
                                    Text="已发现客户端" />

                                <Border
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Padding="8,4"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource DevKitAccent12Brush}"
                                    CornerRadius="10">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DevKitAccentBrush}"
                                        Text="{Binding ClientItems.Count, FallbackValue=0}" />
                                </Border>

                                <Border
                                    Grid.Column="2"
                                    Height="1"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource DevKitBorderBrush}" />

                                <Button
                                    Grid.Column="3"
                                    Height="28"
                                    Command="{Binding ClearAllClientCommand}"
                                    Content="清空列表"
                                    ToolTip="清空已发现来源列表">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource DangerOutlineButtonStyle}" TargetType="Button">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ClientItems.Count}" Value="0">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <!--  客户端列表 + 空态  -->
                            <Grid Margin="0,12,0,0">
                                <ListBox
                                    x:Name="ClientListBox"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding ClientItems}"
                                    ScrollViewer.CanContentScroll="False"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Grid.Column="0"
                                                    Width="20"
                                                    Height="20"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="10">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E7EBF0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Background" Value="#BEE7D1" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Border
                                                        Width="10"
                                                        Height="10"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="5">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#93A0AE" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Background" Value="#16A34A" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </Border>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    Margin="8,0"
                                                    Orientation="Vertical">
                                                    <TextBlock
                                                        FontFamily="Consolas"
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource DevKitTextBrush}">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0}:{1}">
                                                                <Binding Path="Ip" />
                                                                <Binding Path="Port" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>

                                                    <TextBlock Margin="0,4,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding LastActiveTime, StringFormat={}静默 · {0} 分钟前收到的数据}" />
                                                                <Setter Property="Foreground" Value="{StaticResource DevKitTextMutedBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Text" Value="{Binding LastMessageTime, StringFormat={}活跃 · {0} 秒前收到的数据}" />
                                                                        <Setter Property="Foreground" Value="{StaticResource DevKitSuccessBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <Border
                                                    Grid.Column="2"
                                                    Padding="8,4"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource DevKitDangerBorderBrush}"
                                                    CornerRadius="12">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding UnreadLogCount}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <TextBlock Foreground="{StaticResource DevKitDangerBrush}" Text="{Binding UnreadLogCount, FallbackValue=0}" />
                                                </Border>

                                                <StackPanel
                                                    x:Name="ButtonPanel"
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Visibility="Collapsed">
                                                    <Button
                                                        Command="{Binding DataContext.CopyAddressCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="&#xe66c;"
                                                        Style="{StaticResource ClientCopyButtonStyle}"
                                                        ToolTip="复制地址" />

                                                    <Button
                                                        Command="{Binding DataContext.RemoveClientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="&#xe666;"
                                                        Style="{StaticResource ClientRemoveButtonStyle}"
                                                        ToolTip="移除来源" />
                                                </StackPanel>
                                            </Grid>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter TargetName="ButtonPanel" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>

                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border
                                                            x:Name="ClientItemBorder"
                                                            Margin="0,0,0,4"
                                                            Padding="8"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="2"
                                                            CornerRadius="8">
                                                            <ContentPresenter />
                                                        </Border>

                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ClientItemBorder" Property="Background" Value="{StaticResource DevKitAccent12Brush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ClientItemBorder" Property="BorderBrush" Value="{StaticResource DevKitAccent35Brush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <!--  点击切换客户端消息界面  -->
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="SelectionChanged">
                                            <b:InvokeCommandAction Command="{Binding ClientItemSelectedCommand}" CommandParameter="{Binding SelectedItem, ElementName=ClientListBox}" />
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                </ListBox>

                                <!--  空态：无指令时覆盖显示  -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ClientItems.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Rectangle
                                        Fill="{StaticResource DevKitSurfaceBrush}"
                                        RadiusX="8"
                                        RadiusY="8"
                                        Stroke="{StaticResource DevKitBorderStrongBrush}"
                                        StrokeDashArray="3 3" />

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{StaticResource DevKitTextMutedBrush}"
                                            Text="尚未发现客户端" />

                                        <TextBlock
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Center"
                                            Foreground="{StaticResource DevKitTextMutedBrush}"
                                            Text="启动后，会自动显示已发现的客户端"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="0,16,16,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  消息记录  -->
                    <Border
                        Grid.Row="0"
                        Background="White"
                        BorderBrush="{DynamicResource DevKitBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <DockPanel Margin="12">
                            <!--  工具条  -->
                            <Grid DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource DevKitTextBrush}"
                                    Text="消息记录" />

                                <Border
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Padding="8,4"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource DevKitAccent12Brush}"
                                    CornerRadius="10">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DevKitAccentBrush}"
                                        Text="{Binding Logs.Count}" />
                                </Border>

                                <Border
                                    Grid.Column="2"
                                    Margin="8,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="#EFEBFF"
                                    CornerRadius="8">
                                    <TextBlock
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Foreground="#7C5CFF">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}:{1}">
                                                <Binding Path="SelectedClient.Ip" />
                                                <Binding Path="SelectedClient.Port" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>

                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource DevKitTextMutedBrush}"
                                    Text="显示" />

                                <Border
                                    Grid.Column="4"
                                    Margin="8,0"
                                    Padding="2"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource DevKitSurfaceBrush}"
                                    BorderBrush="{DynamicResource DevKitBorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton
                                            Command="{Binding DisplayRadioChangedCommand}"
                                            CommandParameter="0"
                                            Content="HEX"
                                            GroupName="LogDisplayEncoding"
                                            IsChecked="{Binding IsLogHexSelected}"
                                            Style="{StaticResource SegmentRadioStyle}"
                                            ToolTip="把消息内容转为 16 进制显示" />

                                        <RadioButton
                                            Command="{Binding DisplayRadioChangedCommand}"
                                            CommandParameter="1"
                                            Content="ASCII"
                                            GroupName="LogDisplayEncoding"
                                            IsChecked="{Binding IsLogAsciiSelected}"
                                            Style="{StaticResource SegmentRadioStyle}"
                                            ToolTip="把消息内容转为 ASCII 显示" />
                                    </StackPanel>
                                </Border>

                                <Button
                                    Grid.Column="5"
                                    Command="{Binding SaveLogCommand}"
                                    Style="{StaticResource CompactButtonStyle}"
                                    ToolTip="保存消息记录到文件">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="/DevKit;component/Fonts/#iconfont"
                                            FontSize="13"
                                            Text="&#xe60c;" />

                                        <TextBlock
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Text="保存" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    Grid.Column="6"
                                    Margin="8,0,0,0"
                                    Command="{Binding ClearLogCommand}"
                                    Style="{StaticResource DangerOutlineButtonStyle}"
                                    ToolTip="清空消息记录">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="/DevKit;component/Fonts/#iconfont"
                                            FontSize="13"
                                            Text="&#xe666;" />

                                        <TextBlock
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Text="清空" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!--  消息列表 + 空态  -->
                            <Grid Margin="0,16,0,0">
                                <ListBox
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding Logs}"
                                    ScrollViewer.CanContentScroll="False"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                x:Name="MessageRow"
                                                MaxWidth="620"
                                                HorizontalAlignment="Left">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid x:Name="MessageHeader" Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border
                                                        x:Name="TagBorder"
                                                        Grid.Column="0"
                                                        Padding="8,2"
                                                        Background="{StaticResource DevKitSuccess12Brush}"
                                                        CornerRadius="8">
                                                        <TextBlock
                                                            x:Name="TagText"
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource DevKitSuccessBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="发送" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSend}" Value="0">
                                                                            <Setter Property="Text" Value="接收" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <TextBlock
                                                        x:Name="MessageTime"
                                                        Grid.Column="1"
                                                        Margin="8,0"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Consolas"
                                                        Foreground="{StaticResource DevKitTextMutedBrush}"
                                                        Text="{Binding Time}" />

                                                    <Button
                                                        x:Name="CopyMessageButton"
                                                        Grid.Column="2"
                                                        Command="{Binding DataContext.CopyLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Content}"
                                                        Style="{StaticResource CopyMiniButtonStyle}"
                                                        ToolTip="复制本条内容">
                                                        <Button.Content>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontFamily="/DevKit;component/Fonts/#iconfont"
                                                                    Text="&#xe66c;" />
                                                                <TextBlock Margin="4,0,0,0" Text="复制" />
                                                            </StackPanel>
                                                        </Button.Content>
                                                    </Button>
                                                </Grid>

                                                <Border
                                                    x:Name="MessageBubble"
                                                    Grid.Row="1"
                                                    Margin="0,4,0,0"
                                                    Padding="12,8"
                                                    Background="White"
                                                    BorderBrush="{DynamicResource DevKitBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12 12 12 2">
                                                    <TextBlock
                                                        FontFamily="Consolas"
                                                        FontSize="13"
                                                        Foreground="{DynamicResource DevKitTextBrush}"
                                                        Text="{Binding Content}"
                                                        TextWrapping="Wrap" />
                                                </Border>
                                            </Grid>

                                            <DataTemplate.Triggers>
                                                <!--  发送：右对齐、蓝底气泡  -->
                                                <DataTrigger Binding="{Binding IsSend}" Value="1">
                                                    <Setter TargetName="MessageHeader" Property="HorizontalAlignment" Value="Right" />
                                                    <Setter TargetName="CopyMessageButton" Property="Grid.Column" Value="0" />
                                                    <Setter TargetName="MessageTime" Property="Grid.Column" Value="1" />
                                                    <Setter TargetName="TagBorder" Property="Grid.Column" Value="2" />
                                                    <Setter TargetName="MessageRow" Property="HorizontalAlignment" Value="Right" />
                                                    <Setter TargetName="TagBorder" Property="Background" Value="{StaticResource DevKitAccent12Brush}" />
                                                    <Setter TargetName="TagText" Property="Foreground" Value="{StaticResource DevKitAccentBrush}" />
                                                    <Setter TargetName="MessageBubble" Property="Background" Value="{StaticResource DevKitAccent12Brush}" />
                                                    <Setter TargetName="MessageBubble" Property="BorderBrush" Value="{StaticResource DevKitAccent35Brush}" />
                                                    <Setter TargetName="MessageBubble" Property="CornerRadius" Value="12,12,2,12" />
                                                </DataTrigger>

                                                <!--  悬浮整条消息时显示「复制」  -->
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter TargetName="CopyMessageButton" Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>

                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border Padding="0,0,0,16" Background="Transparent">
                                                            <ContentPresenter />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <!--  新消息自动滚动到底部  -->
                                    <b:Interaction.Behaviors>
                                        <bhv:AutoScrollToBottomBehavior />
                                    </b:Interaction.Behaviors>
                                </ListBox>

                                <!--  空态：无消息时覆盖显示  -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Logs.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Rectangle
                                        Fill="{StaticResource DevKitSurfaceBrush}"
                                        RadiusX="8"
                                        RadiusY="8"
                                        Stroke="{StaticResource DevKitBorderStrongBrush}"
                                        StrokeDashArray="3 3" />

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource DevKitTextSecondaryBrush}"
                                            Text="尚未选择客户端" />

                                        <TextBlock
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{StaticResource DevKitTextMutedBrush}"
                                            Text="在左侧「已发现客户端」中点击一个客户端，即可查看它的收发记录；悬浮单条消息可复制。"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!--  发送区  -->
                    <Border
                        Grid.Row="1"
                        Margin="0,16,0,0"
                        Background="White"
                        BorderBrush="{DynamicResource DevKitBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  输入框（含占位提示）  -->
                            <Grid Grid.Row="0">
                                <TextBox
                                    x:Name="MessageInputTextBox"
                                    Style="{StaticResource ComposerTextBoxStyle}"
                                    Text="{Binding UserInputText, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalScrollBarVisibility="Auto">
                                    <TextBox.InputBindings>
                                        <KeyBinding
                                            Key="Return"
                                            Command="{Binding SendMessageCommand}"
                                            Modifiers="Control" />
                                    </TextBox.InputBindings>
                                </TextBox>

                                <TextBlock
                                    Margin="10,8,10,0"
                                    VerticalAlignment="Top"
                                    FontSize="12"
                                    Foreground="{StaticResource DevKitTextMutedBrush}"
                                    IsHitTestVisible="False"
                                    Text="{Binding PlaceHolderText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=MessageInputTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!--  操作条  -->
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource DevKitTextMutedBrush}"
                                        Text="发送" />

                                    <Border
                                        Margin="8,0,0,0"
                                        Padding="2"
                                        Background="{StaticResource DevKitSurfaceBrush}"
                                        BorderBrush="{DynamicResource DevKitBorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton
                                                Command="{Binding SendRadioChangedCommand}"
                                                CommandParameter="0"
                                                Content="HEX"
                                                GroupName="SendEncoding"
                                                IsChecked="{Binding IsSendHexSelected}"
                                                Style="{StaticResource SegmentRadioStyle}"
                                                ToolTip="按 16 进制解析发送内容" />

                                            <RadioButton
                                                Command="{Binding SendRadioChangedCommand}"
                                                CommandParameter="1"
                                                Content="ASCII"
                                                GroupName="SendEncoding"
                                                IsChecked="{Binding IsSendAsciiSelected}"
                                                Style="{StaticResource SegmentRadioStyle}"
                                                ToolTip="按 ASCII/UTF8 文本发送" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <CheckBox
                                    x:Name="LoopSendSwitch"
                                    Grid.Column="1"
                                    Margin="16,0,0,0"
                                    Command="{Binding LoopSendSwitchCommand}"
                                    CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                    Content="循环发送"
                                    IsChecked="{Binding IsLoopSendEnabled, Mode=TwoWay}"
                                    Style="{StaticResource ToggleSwitchStyle}" />

                                <StackPanel
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBox
                                        Width="64"
                                        Height="32"
                                        HorizontalContentAlignment="Center"
                                        Text="{Binding Interval}">
                                        <TextBox.Style>
                                            <Style BasedOn="{StaticResource FieldTextBoxStyle}" TargetType="TextBox">
                                                <Setter Property="IsEnabled" Value="True" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=LoopSendSwitch}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="Foreground" Value="{StaticResource DevKitTextMutedBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <TextBlock
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource DevKitTextMutedBrush}"
                                        Text="ms / 次" />
                                </StackPanel>

                                <CheckBox
                                    Grid.Column="4"
                                    Content="广播全部"
                                    IsChecked="{Binding IsBroadcastAllEnabled, Mode=TwoWay}"
                                    Style="{StaticResource ToggleSwitchStyle}" />

                                <Button
                                    Grid.Column="5"
                                    Margin="8,0,0,0"
                                    Command="{Binding SendMessageCommand}"
                                    ToolTip="Ctrl + Enter 快速发送">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource PrimaryCompactButtonStyle}" TargetType="Button">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ClientItems.Count}" Value="0">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>

                                    <StackPanel Margin="12,0" Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="/DevKit;component/Fonts/#iconfont"
                                            FontSize="14"
                                            Text="&#xe6cd;" />

                                        <TextBlock
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Text="发送" />

                                        <Border
                                            Margin="8,0,0,0"
                                            Padding="5,1"
                                            VerticalAlignment="Center"
                                            Background="#33FFFFFF"
                                            CornerRadius="5">
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="#D9FFFFFF"
                                                Text="Ctrl + Enter" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="16"
                Foreground="{Binding StateTextColor}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} {1}:{2}">
                        <Binding Path="StateText" />
                        <Binding Path="SelectedIp" />
                        <Binding Path="LocalPort" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <Border
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Panel.ZIndex="999"
                Background="{StaticResource DevKitToastBrush}"
                CornerRadius="16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsToastVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock
                    Margin="18,9"
                    FontSize="13"
                    Foreground="White"
                    Text="{Binding ToastMessage}" />
            </Border>

            <TextBlock
                Grid.Column="2"
                Margin="16"
                HorizontalAlignment="Right"
                Foreground="{StaticResource DevKitTextSecondaryBrush}"
                Text="{Binding LastDataTime, StringFormat={}{0} · 消息列表自动滚动, FallbackValue=消息列表自动滚动}" />
        </Grid>
    </Grid>
</UserControl>
