<Window
    x:Class="DevKit.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:DevKit.ViewModels"
    Title="DevKit（开发者工具集）"
    Width="418"
    Height="754"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    Background="{DynamicResource DevKitBackgroundBrush}"
    ResizeMode="CanMinimize"
    WindowStartupLocation="Manual"
    mc:Ignorable="d">

    <Window.Resources>
        <SolidColorBrush x:Key="TextBlockForegroundBrush" Color="#5f6b7a" />

        <Style x:Key="TopmostSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Track"
                            Background="#DFE3EA"
                            CornerRadius="12">
                            <Ellipse
                                x:Name="Thumb"
                                Width="18"
                                Height="18"
                                Margin="3,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Fill="White"
                                RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect
                                        BlurRadius="4"
                                        Direction="270"
                                        Opacity="0.25"
                                        ShadowDepth="1"
                                        Color="#13223D" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2E7CF6" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="Thumb"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                To="12"
                                                Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="Thumb"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                To="0"
                                                Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ListBoxItemStyleKey" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Orientation="Vertical">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="White"
                BorderBrush="{DynamicResource DevKitBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontFamily="/DevKit;component/Fonts/#iconfont"
                        FontSize="16"
                        Foreground="{DynamicResource TextBlockForegroundBrush}"
                        Text="&#xe654;" />

                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextBlockForegroundBrush}"
                        Text="置顶显示" />

                    <ToggleButton
                        Grid.Column="2"
                        Checked="TopmostToggleButton_Checked"
                        Style="{StaticResource TopmostSwitchStyle}"
                        Unchecked="TopmostToggleButton_Unchecked" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="4,16,4,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    FontFamily="微软雅黑"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="Black"
                    Text="Android工具" />

                <Border
                    Grid.Column="1"
                    Margin="8,0"
                    Background="#1A2E7CF6"
                    CornerRadius="12">
                    <TextBlock
                        Margin="8,2"
                        FontFamily="微软雅黑"
                        Foreground="#FF2E7CF6"
                        Text="{Binding AndroidTools.Count}" />
                </Border>

                <Border
                    Grid.Column="2"
                    Height="1"
                    Background="{DynamicResource DevKitBorderBrush}" />
            </Grid>

            <ListBox
                Grid.Row="2"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding AndroidTools}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border
                            x:Name="Card"
                            Width="114"
                            Height="104"
                            Margin="4"
                            Background="White"
                            BorderBrush="#EEEFF0"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel VerticalAlignment="Center">
                                <Border
                                    Width="48"
                                    Height="48"
                                    HorizontalAlignment="Center"
                                    Background="#1F17A95C"
                                    CornerRadius="12">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="24"
                                        Foreground="#17A95C"
                                        Text="{Binding MenuIcon}" />
                                </Border>

                                <TextBlock
                                    x:Name="Name"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#5F6B7A"
                                    Text="{Binding MenuName}" />
                            </StackPanel>
                        </Border>

                        <DataTemplate.Triggers>
                            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#1F17A95C" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#5917A95C" />
                                <Setter TargetName="Name" Property="Foreground" Value="#17A95C" />
                                <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ListBoxItemStyleKey}" TargetType="ListBoxItem">
                        <EventSetter Event="PreviewMouseDown" Handler="AndroidToolsListBox_ListBoxItem_PreviewMouseDown" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Grid Grid.Row="3" Margin="4,16,4,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    FontFamily="微软雅黑"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="Black"
                    Text="Socket通信工具" />

                <Border
                    Grid.Column="1"
                    Margin="8,0"
                    Background="#1A2E7CF6"
                    CornerRadius="12">
                    <TextBlock
                        Margin="8,2"
                        FontFamily="微软雅黑"
                        Foreground="#FF2E7CF6"
                        Text="{Binding SocketTools.Count}" />
                </Border>

                <Border
                    Grid.Column="2"
                    Height="1"
                    Background="{DynamicResource DevKitBorderBrush}" />
            </Grid>

            <ListBox
                Grid.Row="4"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding SocketTools}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border
                            x:Name="Card"
                            Width="114"
                            Height="104"
                            Margin="4"
                            Background="White"
                            BorderBrush="#EEEFF0"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel VerticalAlignment="Center">
                                <Border
                                    Width="48"
                                    Height="48"
                                    HorizontalAlignment="Center"
                                    Background="#1F2E7CF6"
                                    CornerRadius="12">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="24"
                                        Foreground="#2E7CF6"
                                        Text="{Binding MenuIcon}" />
                                </Border>

                                <TextBlock
                                    x:Name="Name"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#5F6B7A"
                                    Text="{Binding MenuName}" />
                            </StackPanel>
                        </Border>

                        <DataTemplate.Triggers>
                            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#1F2E7CF6" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#592E7CF6" />
                                <Setter TargetName="Name" Property="Foreground" Value="#2E7CF6" />
                                <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ListBoxItemStyleKey}" TargetType="ListBoxItem">
                        <EventSetter Event="PreviewMouseDown" Handler="SocketToolsListBox_ListBoxItem_PreviewMouseDown" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Grid Grid.Row="5" Margin="4,16,4,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    FontFamily="微软雅黑"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="Black"
                    Text="其他工具" />

                <Border
                    Grid.Column="1"
                    Margin="8,0"
                    Background="#1A2E7CF6"
                    CornerRadius="12">
                    <TextBlock
                        Margin="8,2"
                        FontFamily="微软雅黑"
                        Foreground="#FF2E7CF6"
                        Text="{Binding OtherTools.Count}" />
                </Border>

                <Border
                    Grid.Column="2"
                    Height="1"
                    Background="{DynamicResource DevKitBorderBrush}" />
            </Grid>

            <ListBox
                Grid.Row="6"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding OtherTools}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border
                            x:Name="Card"
                            Width="114"
                            Height="104"
                            Margin="4"
                            Background="White"
                            BorderBrush="#EEEFF0"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel VerticalAlignment="Center">
                                <Border
                                    Width="48"
                                    Height="48"
                                    HorizontalAlignment="Center"
                                    Background="#1F2E7CF6"
                                    CornerRadius="12">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="24"
                                        Foreground="#7C5CFF"
                                        Text="{Binding MenuIcon}" />
                                </Border>

                                <TextBlock
                                    x:Name="Name"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#5F6B7A"
                                    Text="{Binding MenuName}" />
                            </StackPanel>
                        </Border>

                        <DataTemplate.Triggers>
                            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#1F7C5CFF" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#597C5CFF" />
                                <Setter TargetName="Name" Property="Foreground" Value="#7C5CFF" />
                                <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ListBoxItemStyleKey}" TargetType="ListBoxItem">
                        <EventSetter Event="PreviewMouseDown" Handler="OtherToolsListBox_ListBoxItem_PreviewMouseDown" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>

        <DockPanel Background="White" LastChildFill="True">
            <TextBlock
                Margin="16"
                Foreground="{StaticResource TextBlockForegroundBrush}"
                Text="DevKit · 已就绪" />

            <TextBlock
                Margin="16"
                HorizontalAlignment="Right"
                Foreground="{StaticResource TextBlockForegroundBrush}"
                Text="点击工具卡片即可打开" />
        </DockPanel>
    </StackPanel>
</Window>