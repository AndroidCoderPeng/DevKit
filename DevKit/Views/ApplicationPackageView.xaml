<UserControl
    x:Class="DevKit.Views.ApplicationPackageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:utils="clr-namespace:DevKit.Utils"
    xmlns:vm="clr-namespace:DevKit.ViewModels"
    Width="720"
    Height="776"
    d:DataContext="{d:DesignInstance Type=vm:ApplicationPackageViewModel}"
    Background="{DynamicResource DevKitBackgroundBrush}"
    mc:Ignorable="d">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <SolidColorBrush x:Key="TextBlockForegroundBrush" Color="#5f6b7a" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#93a0ae" />
        <SolidColorBrush x:Key="ApkBrush" Color="#17a95c" />

        <!--  APK 图标渐变（绿色）  -->
        <LinearGradientBrush x:Key="ApkIconBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#6fe0a5" />
            <GradientStop Offset="1.0" Color="#17a95c" />
        </LinearGradientBrush>

        <!--  普通按钮：白底灰框，hover 蓝  -->
        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DFE3EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource DevKitTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonContainerBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="#EAF1FE" />
                                <Setter TargetName="ButtonContainerBorder" Property="BorderBrush" Value="#2E7CF6" />
                                <Setter Property="TextElement.Foreground" Value="#2E7CF6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="#D9E7FD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  主按钮：蓝底白字  -->
        <Style x:Key="PrimaryCompactButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="#2E7CF6" />
            <Setter Property="BorderBrush" Value="#2E7CF6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonContainerBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="#1C6AE0" />
                                <Setter TargetName="ButtonContainerBorder" Property="BorderBrush" Value="#1C6AE0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="#1556C0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  APK 卡片按钮：点击打开所在文件夹  -->
        <Style x:Key="ApkCardButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="64" />
            <Setter Property="Background" Value="#F7F9FC" />
            <Setter Property="BorderBrush" Value="{DynamicResource DevKitBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="CardBorder"
                            Padding="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#E9F7F0" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#17A95C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  圆角输入框  -->
        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#F7F9FC" />
            <Setter Property="BorderBrush" Value="#DFE3EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="FieldBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#2E7CF6" />
                                <Setter TargetName="FieldBorder" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ============ 签名配置 ============  -->
        <Border
            Grid.Row="0"
            Padding="16"
            Background="White"
            BorderBrush="{DynamicResource DevKitBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="Black"
                        Text="签名配置" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="用于 keytool 查看 SHA1" />
                </StackPanel>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2">
                        <TextBlock Foreground="{StaticResource TextBlockForegroundBrush}" Text="证书路径" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Column="0"
                                Style="{StaticResource FieldTextBoxStyle}"
                                Text="{Binding KeyFilePath}" />

                            <Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Command="{Binding SelectKeyCommand}"
                                Style="{StaticResource CompactButtonStyle}">
                                <Button.Content>
                                    <TextBlock
                                        Margin="16,0"
                                        FontSize="13"
                                        Text="选择" />
                                </Button.Content>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!--  签名别名  -->
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,16,8,0">
                        <TextBlock Foreground="{StaticResource TextBlockForegroundBrush}" Text="签名别名" />

                        <TextBox
                            Margin="0,8,0,0"
                            Style="{StaticResource FieldTextBoxStyle}"
                            Text="{Binding KeyAlias}" />
                    </StackPanel>

                    <!--  密码  -->
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="8,16,0,0">
                        <TextBlock Foreground="{StaticResource TextBlockForegroundBrush}" Text="密码" />

                        <PasswordBox
                            Height="34"
                            Margin="0,8,0,0"
                            VerticalContentAlignment="Center"
                            utils:PasswordAttachAttribute.Attach="True"
                            utils:PasswordAttachAttribute.Password="{Binding KeyPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Background="#F7F9FC"
                            BorderBrush="#DFE3EA"
                            BorderThickness="1"
                            FontSize="14" />
                    </StackPanel>
                </Grid>

                <!--  查看 SHA1 + 终端  -->
                <StackPanel Margin="0,18,0,0">
                    <Button
                        HorizontalAlignment="Left"
                        Command="{Binding ShowSha1Command}"
                        Style="{StaticResource PrimaryCompactButtonStyle}">
                        <Button.Content>
                            <StackPanel Margin="16,0" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="/DevKit;component/Fonts/#iconfont"
                                    FontSize="16"
                                    Text="&#xe60c;" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="White"
                                    Text="查看 SHA1" />
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Border
                        Height="144"
                        Margin="0,8,0,0"
                        Background="#0C0C0C"
                        CornerRadius="10">
                        <TextBox
                            Margin="4,12"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            FontFamily="微软雅黑"
                            FontSize="14"
                            Foreground="#4ADE80"
                            HorizontalScrollBarVisibility="Auto"
                            IsReadOnly="True"
                            Text="{Binding OutputResult}"
                            TextWrapping="NoWrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  ============ APK 归档 ============  -->
        <Border
            Grid.Row="1"
            Margin="0,16,0,0"
            Padding="16"
            Background="White"
            BorderBrush="{DynamicResource DevKitBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="Black"
                        Text="APK 归档" />

                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TextBlockForegroundBrush}">
                        <Run Text="共 " />
                        <Run
                            FontWeight="SemiBold"
                            Foreground="#17A95C"
                            Text="{Binding ApkFileCollection.Count, Mode=OneWay}" />
                        <Run Text=" 个安装包" />
                    </TextBlock>
                </Grid>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TextBlockForegroundBrush}"
                        Text="根目录" />

                    <TextBox
                        Grid.Column="1"
                        Margin="8,0"
                        Style="{StaticResource FieldTextBoxStyle}"
                        Text="{Binding ApkRootFolderPath}" />

                    <Button
                        Grid.Column="2"
                        Command="{Binding SelectApkRootFolderCommand}"
                        Style="{StaticResource CompactButtonStyle}">
                        <Button.Content>
                            <TextBlock
                                Margin="16,0"
                                FontSize="13"
                                Text="浏览" />
                        </Button.Content>
                    </Button>

                    <Button
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        Command="{Binding RefreshApkFilesCommand}"
                        Style="{StaticResource CompactButtonStyle}">
                        <Button.Content>
                            <StackPanel Margin="12,0" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="/DevKit;component/Fonts/#iconfont"
                                    FontSize="16"
                                    Text="&#xe602;" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Text="刷新" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>

                <!--  APK 卡片列表  -->
                <ListBox
                    Grid.Row="2"
                    Margin="0,16,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding ApkFileCollection}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="4,0,4,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Command="{Binding DataContext.OpenFileFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding FullName}"
                                Style="{StaticResource ApkCardButtonStyle}">
                                <Button.Content>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--  图标  -->
                                        <Border
                                            Width="42"
                                            Height="42"
                                            Background="{StaticResource ApkIconBackgroundBrush}"
                                            CornerRadius="10">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="/DevKit;component/Fonts/#iconfont"
                                                FontSize="20"
                                                Foreground="White"
                                                Text="&#xe608;" />
                                        </Border>

                                        <!--  信息  -->
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="Black"
                                                Text="{Binding FileName}"
                                                TextTrimming="CharacterEllipsis" />

                                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                                <Border
                                                    Padding="4,2"
                                                    Background="#EAF1FE"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        Margin="2,1"
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="#2E7CF6"
                                                        Text="{Binding Version}" />
                                                </Border>

                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    Foreground="{StaticResource TextMutedBrush}"
                                                    Text="{Binding FileSize}" />

                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    Foreground="{StaticResource TextMutedBrush}"
                                                    Text="{Binding ModifyTime}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Button.Content>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
