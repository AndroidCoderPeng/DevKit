<UserControl
    x:Class="DevKit.Views.ApplicationPackageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:utils="clr-namespace:DevKit.Utils"
    xmlns:vm="clr-namespace:DevKit.ViewModels"
    Width="860"
    Height="872"
    d:DataContext="{d:DesignInstance Type=vm:ApplicationPackageViewModel}"
    Background="{DynamicResource DevKitBackgroundBrush}"
    mc:Ignorable="d">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <SolidColorBrush x:Key="TextBlockForegroundBrush" Color="#5f6b7a" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#93a0ae" />

        <!--  APK 图标渐变（绿色）  -->
        <LinearGradientBrush x:Key="ApkIconBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#6fe0a5" />
            <GradientStop Offset="1.0" Color="#17a95c" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ScanProgressForegroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#6fe0a5" />
            <GradientStop Offset="1.0" Color="#17a95c" />
        </LinearGradientBrush>

        <!--  普通按钮：白底灰框，hover 蓝  -->
        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DFE3EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource DevKitTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonContainerBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="#EAF1FE" />
                                <Setter TargetName="ButtonContainerBorder" Property="BorderBrush" Value="#2E7CF6" />
                                <Setter Property="TextElement.Foreground" Value="#2E7CF6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="#D9E7FD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  主按钮：蓝底白字  -->
        <Style x:Key="PrimaryCompactButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="#2E7CF6" />
            <Setter Property="BorderBrush" Value="#2E7CF6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonContainerBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="#1C6AE0" />
                                <Setter TargetName="ButtonContainerBorder" Property="BorderBrush" Value="#1C6AE0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="#1556C0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  APK 卡片按钮：点击打开所在文件夹  -->
        <Style x:Key="ApkCardButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="64" />
            <Setter Property="Background" Value="#F7F9FC" />
            <Setter Property="BorderBrush" Value="{DynamicResource DevKitBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="CardBorder"
                            Padding="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#E9F7F0" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#17A95C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  圆角输入框  -->
        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#F7F9FC" />
            <Setter Property="BorderBrush" Value="#DFE3EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="FieldBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#2E7CF6" />
                                <Setter TargetName="FieldBorder" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  圆角密码框，和 TextBox 保持一致  -->
        <Style x:Key="FieldPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#F7F9FC" />
            <Setter Property="BorderBrush" Value="#DFE3EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border
                            x:Name="FieldBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#2E7CF6" />
                                <Setter TargetName="FieldBorder" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ============ APK 归档 ============  -->
        <Border
            Grid.Row="0"
            Padding="16"
            Background="White"
            BorderBrush="{DynamicResource DevKitBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            FontFamily="Consolas"
                            FontWeight="SemiBold"
                            Foreground="#2e7cf6"
                            Text="ARCHIVE WORKSPACE" />

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,2"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="Black"
                            Text="安装包归档" />

                        <TextBlock
                            Grid.Row="2"
                            Foreground="{StaticResource TextBlockForegroundBrush}"
                            Text="检索目录中的APK，排除debug与隐藏文件" />
                    </Grid>

                    <Border
                        Grid.Column="1"
                        Background="#104ADE80"
                        BorderBrush="#FF4ADE80"
                        BorderThickness="3,0,0,0">
                        <Grid Margin="16,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="#17A95C"
                                Text="{Binding ApkFileCollection.Count, FallbackValue=0}" />

                            <TextBlock
                                Grid.Row="1"
                                Margin="0,2"
                                FontSize="10"
                                Foreground="#17A95C"
                                Text="个安装包" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource DevKitBorderBrush}" />

                <Border
                    Grid.Row="2"
                    Margin="0,16,0,0"
                    BorderBrush="{StaticResource DevKitBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="/DevKit;component/Fonts/#iconfont"
                            FontSize="18"
                            Foreground="#2E7CF6"
                            Text="&#xe680;" />

                        <TextBox Grid.Column="1" Text="{Binding ApkRootFolderPath}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Height" Value="34" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost" Margin="4,0" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Button
                            Grid.Column="2"
                            Margin="8,0"
                            Command="{Binding SelectApkRootFolderCommand}"
                            Style="{StaticResource CompactButtonStyle}">
                            <Button.Content>
                                <TextBlock
                                    Margin="16,0"
                                    FontSize="13"
                                    Text="选择目录" />
                            </Button.Content>
                        </Button>

                        <Button
                            Grid.Column="3"
                            Command="{Binding RefreshApkFilesCommand}"
                            Style="{StaticResource PrimaryCompactButtonStyle}">
                            <Button.Content>
                                <StackPanel Margin="12,0" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="16"
                                        Text="&#xe602;" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="扫描目录" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="256"
                        Height="34"
                        Margin="0,8"
                        HorizontalAlignment="Left"
                        Background="#F7F9FC"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource DevKitBorderBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=ApkSearchTextBox}" Value="True">
                                        <Setter Property="BorderBrush" Value="#2E7CF6" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect
                                                    BlurRadius="6"
                                                    Opacity="0.18"
                                                    ShadowDepth="0"
                                                    Color="#2E7CF6" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontFamily="/DevKit;component/Fonts/#iconfont"
                                FontSize="18"
                                Foreground="#93A0AE"
                                Text="&#xe6cc;" />

                            <Grid Grid.Column="1">
                                <TextBox
                                    x:Name="ApkSearchTextBox"
                                    Width="196"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="13"
                                    Foreground="{DynamicResource DevKitTextBrush}"
                                    Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="#93A0AE"
                                    IsHitTestVisible="False"
                                    Text="按名称或版本筛选">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=ApkSearchTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Visibility="{Binding ScanVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="13"
                            Height="13"
                            VerticalAlignment="Center"
                            Background="#2E3DDC84"
                            CornerRadius="7">
                            <Border
                                Width="7"
                                Height="7"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#FF16A34A"
                                CornerRadius="4" />
                        </Border>

                        <TextBlock
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextBlockForegroundBrush}"
                            Text="扫描中" />

                        <ProgressBar
                            Grid.Column="2"
                            Width="192"
                            Margin="8,0"
                            Value="{Binding ScanProgress}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Height" Value="6" />
                                    <Setter Property="Width" Value="92" />
                                    <Setter Property="Background" Value="#F7F9FC" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource DevKitBorderBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource ScanProgressForegroundBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Grid>
                                                    <Border
                                                        x:Name="PART_Track"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="3" />
                                                    <Border
                                                        x:Name="PART_Indicator"
                                                        Margin="1"
                                                        HorizontalAlignment="Left"
                                                        Background="{TemplateBinding Foreground}"
                                                        CornerRadius="2" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>

                        <TextBlock
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Foreground="#17a95c"
                            Text="{Binding ScanProgress, StringFormat={}{0}%}" />
                    </Grid>
                </Grid>

                <!--  APK 卡片列表  -->
                <ListBox
                    Grid.Row="4"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding ApkFileCollection}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <!--  空状态模板  -->
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <Grid>
                                <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                    <ItemsPresenter />
                                </ScrollViewer>

                                <StackPanel
                                    x:Name="EmptyHint"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="40"
                                        Foreground="#C6CDD6"
                                        Text="&#xe700;" />
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="13"
                                        Foreground="#93A0AE"
                                        Text="暂无安装包，请先选择 APK 归档目录" />
                                </StackPanel>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter TargetName="EmptyHint" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ListBox.Template>

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,8,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Command="{Binding DataContext.OpenFileFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding FullName}"
                                Style="{StaticResource ApkCardButtonStyle}">
                                <Button.Content>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--  图标  -->
                                        <Border
                                            Width="44"
                                            Height="44"
                                            Background="{StaticResource ApkIconBackgroundBrush}"
                                            CornerRadius="8">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="/DevKit;component/Fonts/#iconfont"
                                                FontSize="20"
                                                Foreground="White"
                                                Text="&#xe700;" />
                                        </Border>

                                        <!--  信息  -->
                                        <StackPanel Grid.Column="1" Margin="8,4,0,0">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="Black"
                                                Text="{Binding FileName}"
                                                TextTrimming="CharacterEllipsis" />

                                            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                                <Border
                                                    Padding="4,2"
                                                    Background="#1A2E7CF6"
                                                    CornerRadius="8">
                                                    <TextBlock
                                                        Margin="2,1"
                                                        FontSize="10"
                                                        Foreground="#2E7CF6"
                                                        Text="{Binding Version}" />
                                                </Border>

                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    Foreground="{StaticResource TextMutedBrush}"
                                                    Text="{Binding FileSize}" />

                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    Foreground="{StaticResource TextMutedBrush}"
                                                    Text="{Binding ModifyTime}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Button.Content>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!--  ============ 签名配置 ============  -->
        <Border
            Grid.Row="1"
            Margin="0,16,0,0"
            Padding="16"
            Background="White"
            BorderBrush="{DynamicResource DevKitBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="Black"
                        Text="签名配置" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Bottom"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="配置 JKS 与 JDK 后读取证书 SHA1 / SHA256。" />
                </StackPanel>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2">
                        <TextBlock Foreground="{StaticResource TextBlockForegroundBrush}" Text="证书路径" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Column="0"
                                Style="{StaticResource FieldTextBoxStyle}"
                                Text="{Binding KeyFilePath}" />

                            <Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Command="{Binding SelectKeyCommand}"
                                Style="{StaticResource CompactButtonStyle}">
                                <Button.Content>
                                    <TextBlock
                                        Margin="16,0"
                                        FontSize="13"
                                        Text="选择" />
                                </Button.Content>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,16,8,0">
                        <TextBlock Foreground="{StaticResource TextBlockForegroundBrush}" Text="签名别名" />

                        <TextBox
                            Margin="0,4,0,0"
                            Style="{StaticResource FieldTextBoxStyle}"
                            Text="{Binding KeyAlias}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="8,16,0,0">
                        <TextBlock Foreground="{StaticResource TextBlockForegroundBrush}" Text="密码" />

                        <PasswordBox
                            Margin="0,4,0,0"
                            utils:PasswordAttachAttribute.Attach="True"
                            utils:PasswordAttachAttribute.Password="{Binding KeyPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="14"
                            Style="{StaticResource FieldPasswordBoxStyle}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,16,0,0">
                        <TextBlock Foreground="{StaticResource TextBlockForegroundBrush}" Text="JDK路径" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Column="0"
                                Style="{StaticResource FieldTextBoxStyle}"
                                Text="{Binding JdkPath}" />

                            <Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Command="{Binding SelectJdkCommand}"
                                Style="{StaticResource CompactButtonStyle}">
                                <Button.Content>
                                    <TextBlock
                                        Margin="16,0"
                                        FontSize="13"
                                        Text="选择" />
                                </Button.Content>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!--  查看 SHA1 + 终端  -->
                <StackPanel Margin="0,18,0,0">
                    <Button
                        HorizontalAlignment="Left"
                        Command="{Binding ShowSha1Command}"
                        Style="{StaticResource PrimaryCompactButtonStyle}">
                        <Button.Content>
                            <StackPanel Margin="16,0" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="/DevKit;component/Fonts/#iconfont"
                                    FontSize="16"
                                    Text="&#xe80f;" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="White"
                                    Text="查看 SHA1" />
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Border
                        Height="144"
                        Margin="0,8,0,0"
                        Background="#0C0C0C"
                        CornerRadius="10">
                        <TextBox
                            Margin="4,8"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            FontFamily="微软雅黑"
                            FontSize="14"
                            Foreground="#4ADE80"
                            HorizontalScrollBarVisibility="Auto"
                            IsReadOnly="True"
                            Text="{Binding OutputResult}"
                            TextWrapping="NoWrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
