<UserControl
    x:Class="DevKit.Views.AndroidDebugBridgeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:DevKit.ViewModels"
    Width="900"
    Height="790"
    d:DataContext="{d:DesignInstance Type=vm:AndroidDebugBridgeViewModel}"
    Background="{DynamicResource DevKitBackgroundBrush}"
    mc:Ignorable="d">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <SolidColorBrush x:Key="TextBlockForegroundBrush" Color="#5f6b7a" />

        <LinearGradientBrush x:Key="GradientForegroundBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0.0" Color="#3ddc84" />
            <GradientStop Offset="1.0" Color="#17a95c" />
        </LinearGradientBrush>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="72" />
            <Setter Property="Background" Value="#F7F9FC" />
            <Setter Property="BorderBrush" Value="{DynamicResource DevKitBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBlockForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ActionButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  普通 hover：蓝色  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionButtonBorder" Property="Background" Value="#EAF1FE" />
                                <Setter TargetName="ActionButtonBorder" Property="BorderBrush" Value="#2E7CF6" />
                                <Setter Property="TextElement.Foreground" Value="#2E7CF6" />
                                <Setter TargetName="ActionButtonBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-2" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <!--  危险 hover：红色（声明在后，覆盖上面的蓝色）  -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="Danger" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ActionButtonBorder" Property="Background" Value="#FDEBEC" />
                                <Setter TargetName="ActionButtonBorder" Property="BorderBrush" Value="#E5484D" />
                                <Setter Property="TextElement.Foreground" Value="#E5484D" />
                                <Setter TargetName="ActionButtonBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-2" />
                                    </Setter.Value>
                                </Setter>
                            </MultiTrigger>

                            <!--  按下：复位  -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionButtonBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="0" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <!--  禁用：半透明  -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExportProgressStyle" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExporting}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Margin="16"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextBlockForegroundBrush}"
                Text="当前设备" />

            <Border
                Grid.Column="1"
                Height="36"
                Margin="16,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="White"
                BorderBrush="#DFE3EA"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel
                    Margin="12,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Width="13"
                        Height="13"
                        VerticalAlignment="Center"
                        Background="#2E3DDC84"
                        CornerRadius="7">
                        <Border
                            Width="7"
                            Height="7"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#FF16A34A"
                            CornerRadius="4" />
                    </Border>

                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource DevKitTextBrush}"
                        TextTrimming="CharacterEllipsis">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} · {1} {2}">
                                <Binding Path="CurrentDevice" />
                                <Binding Path="DeviceBrand" />
                                <Binding Path="DeviceModel" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                Command="{Binding RefreshDeviceCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Background" Value="White" />
                        <Setter Property="BorderBrush" Value="#DFE3EA" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Foreground" Value="{DynamicResource DevKitTextBrush}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="ButtonContainerBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ButtonContainerBorder" Property="Background" Value="#EAF1FE" />
                                            <Setter TargetName="ButtonContainerBorder" Property="BorderBrush" Value="#2E7CF6" />
                                            <Setter Property="TextElement.Foreground" Value="#2E7CF6" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="ButtonContainerBorder" Property="Background" Value="#D9E7FD" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <Button.Content>
                    <StackPanel Margin="16,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="/DevKit;component/Fonts/#iconfont"
                            FontSize="16"
                            Text="&#xe602;" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{DynamicResource DevKitTextBrush}"
                            Text="刷新" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource DevKitBorderBrush}" />

        <Grid Grid.Row="2" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="0,0,8,0"
                Background="White"
                BorderBrush="{DynamicResource DevKitBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Background="{StaticResource DevKitBackgroundBrush}"
                            CornerRadius="16">
                            <TextBlock
                                Margin="12"
                                FontFamily="/DevKit;component/Fonts/#iconfont"
                                FontSize="32"
                                Foreground="#2E7CF6"
                                Text="&#xe6bf;" />
                        </Border>

                        <Grid Grid.Column="1" Margin="12,4,0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="Black">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="DeviceBrand" />
                                        <Binding Path="DeviceModel" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <StackPanel
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource TextBlockForegroundBrush}"
                                    Text="{Binding CurrentDevice}" />

                                <Border
                                    Margin="8,0,0,0"
                                    Background="#1F3DDC84"
                                    BorderBrush="#593DDC84"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <TextBlock
                                        Margin="8,2"
                                        Foreground="#FF16A34A"
                                        Text="{Binding ConnectionType}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1" Margin="16,0">
                        <Line
                            SnapsToDevicePixels="True"
                            Stroke="{DynamicResource DevKitBorderBrush}"
                            StrokeDashArray="4,3"
                            StrokeThickness="1"
                            X1="0"
                            X2="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                            Y1="0.5"
                            Y2="0.5" />
                    </Grid>

                    <UniformGrid
                        Grid.Row="2"
                        Margin="16"
                        Columns="2"
                        Rows="4">
                        <Border
                            Margin="0,0,4,4"
                            Background="#F7F9FC"
                            CornerRadius="8">
                            <StackPanel Margin="12" Orientation="Vertical">
                                <TextBlock Foreground="{StaticResource TextBlockForegroundBrush}" Text="设备品牌" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontFamily="微软雅黑"
                                    FontSize="13"
                                    Foreground="Black"
                                    Text="{Binding DeviceBrand}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="4,0,0,4"
                            Background="#F7F9FC"
                            CornerRadius="8">
                            <StackPanel Margin="12" Orientation="Vertical">
                                <TextBlock Foreground="{StaticResource TextBlockForegroundBrush}" Text="Android版本" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontFamily="微软雅黑"
                                    FontSize="13"
                                    Foreground="Black">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}（API {1}）">
                                            <Binding Path="AndroidVersion" />
                                            <Binding Path="ApiCode" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="0,4,4,4"
                            Background="#F7F9FC"
                            CornerRadius="8">
                            <StackPanel Margin="12" Orientation="Vertical">
                                <TextBlock Foreground="{StaticResource TextBlockForegroundBrush}" Text="CPU型号" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontFamily="微软雅黑"
                                    FontSize="13"
                                    Foreground="Black"
                                    Text="{Binding CpuType}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="4,4,0,4"
                            Background="#F7F9FC"
                            CornerRadius="8">
                            <StackPanel Margin="12" Orientation="Vertical">
                                <TextBlock Foreground="{StaticResource TextBlockForegroundBrush}" Text="电池容量" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontFamily="微软雅黑"
                                    FontSize="13"
                                    Foreground="Black"
                                    Text="{Binding BatteryCapacity}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="0,4,4,4"
                            Background="#F7F9FC"
                            CornerRadius="8">
                            <StackPanel Margin="12" Orientation="Vertical">
                                <TextBlock Foreground="{StaticResource TextBlockForegroundBrush}" Text="屏幕分辨率" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontFamily="微软雅黑"
                                    FontSize="13"
                                    Foreground="Black">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} · {1} dpi">
                                            <Binding Path="DeviceSize" />
                                            <Binding Path="DeviceDpi" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="4,4,0,4"
                            Background="#F7F9FC"
                            CornerRadius="8">
                            <StackPanel Margin="12" Orientation="Vertical">
                                <TextBlock Foreground="{StaticResource TextBlockForegroundBrush}" Text="ABI架构" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontFamily="微软雅黑"
                                    FontSize="13"
                                    Foreground="Black"
                                    Text="{Binding DeviceAbi}" />
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="AndroidIdItem"
                            Margin="0,4,4,0"
                            CornerRadius="8"
                            Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F7F9FC" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#EAF1FE" />
                                            <Setter Property="BorderBrush" Value="#2E7CF6" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="MouseLeftButtonUp">
                                    <b:InvokeCommandAction Command="{Binding AndroidIdLabelClickCommand}" CommandParameter="{Binding AndroidId}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>

                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Vertical">
                                    <TextBlock Foreground="{StaticResource TextBlockForegroundBrush}" Text="Android ID" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontFamily="微软雅黑"
                                        FontSize="13"
                                        Foreground="Black"
                                        Text="{Binding AndroidId}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontFamily="/DevKit;component/Fonts/#iconfont"
                                    FontSize="24"
                                    Foreground="#2E7CF6"
                                    Text="&#xe66c;">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=AndroidIdItem}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="DeviceIpItem"
                            Margin="4,4,0,0"
                            CornerRadius="8"
                            Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F7F9FC" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#EAF1FE" />
                                            <Setter Property="BorderBrush" Value="#2E7CF6" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="MouseLeftButtonUp">
                                    <b:InvokeCommandAction Command="{Binding DeviceIpLabelClickCommand}" CommandParameter="{Binding DeviceIp}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>

                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Vertical">
                                    <TextBlock Foreground="{StaticResource TextBlockForegroundBrush}" Text="本机 IP 地址" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontFamily="微软雅黑"
                                        FontSize="13"
                                        Foreground="Black"
                                        Text="{Binding DeviceIp}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontFamily="/DevKit;component/Fonts/#iconfont"
                                    FontSize="24"
                                    Foreground="#2E7CF6"
                                    Text="&#xe66c;">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=DeviceIpItem}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <Border
                        Grid.Row="3"
                        Margin="16,0"
                        Background="#F7F9FC"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid Margin="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border
                                    Width="50"
                                    Height="20"
                                    BorderBrush="#DFE3EA"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <ProgressBar
                                        Height="16"
                                        Margin="2"
                                        VerticalAlignment="Center"
                                        Background="White"
                                        BorderThickness="0"
                                        Foreground="{StaticResource GradientForegroundBrush}"
                                        Style="{x:Null}"
                                        Value="{Binding BatteryProgress}" />
                                </Border>

                                <Border
                                    Width="3"
                                    Height="10"
                                    Background="#DFE3EA" />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0"
                                VerticalAlignment="Center"
                                FontFamily="微软雅黑"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="Black"
                                Text="{Binding BatteryProgress, StringFormat={}{0}%}" />

                            <Border
                                Grid.Column="2"
                                Margin="8,0"
                                HorizontalAlignment="Right"
                                Background="White"
                                BorderBrush="#593DDC84"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="12,4,6,4"
                                        VerticalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="14"
                                        Foreground="#FF16A34A"
                                        Text="&#xe61d;" />

                                    <TextBlock
                                        Margin="0,4,12,4"
                                        VerticalAlignment="Center"
                                        Foreground="#FF16A34A"
                                        Text="{Binding BatteryState}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Column="3"
                                Background="White"
                                BorderBrush="#DFE3EA"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="12,4,6,4"
                                        VerticalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="14"
                                        Foreground="{StaticResource TextBlockForegroundBrush}"
                                        Text="&#xe6f8;" />

                                    <TextBlock
                                        Margin="0,4,12,4"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource TextBlockForegroundBrush}"
                                        Text="{Binding BatteryTemperature}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <UniformGrid
                        Grid.Row="4"
                        Margin="16"
                        Columns="3"
                        IsEnabled="{Binding HasSelectedDevice}"
                        Rows="2">

                        <Button
                            Margin="0,0,4,4"
                            HorizontalAlignment="Stretch"
                            Command="{Binding OutputImageCommand}"
                            Style="{StaticResource ActionButtonStyle}">
                            <Button.Content>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="18"
                                        Text="&#xe60c;" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Foreground="{StaticResource TextBlockForegroundBrush}"
                                        Text="导出截屏" />
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <Button
                            Margin="4,0,4,4"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ScreenshotCommand}"
                            Style="{StaticResource ActionButtonStyle}">
                            <Button.Content>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="18"
                                        Text="&#xe635;" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Foreground="{StaticResource TextBlockForegroundBrush}"
                                        Text="截取屏幕" />
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <Button
                            Margin="4,0,0,4"
                            HorizontalAlignment="Stretch"
                            Command="{Binding GetLogCommand}"
                            Style="{StaticResource ActionButtonStyle}">
                            <Button.Content>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="18"
                                        Text="&#xe62c;" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Foreground="{StaticResource TextBlockForegroundBrush}"
                                        Text="查看日志" />
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <Button
                            Margin="0,4,4,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding InstallCommand}"
                            Style="{StaticResource ActionButtonStyle}">
                            <Button.Content>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="18"
                                        Text="&#xe608;" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Foreground="{StaticResource TextBlockForegroundBrush}"
                                        Text="安装软件" />
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <Button
                            Margin="4,4,4,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding RebootDeviceCommand}"
                            Style="{StaticResource ActionButtonStyle}">
                            <Button.Content>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="18"
                                        Text="&#xe60a;" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Foreground="{StaticResource TextBlockForegroundBrush}"
                                        Text="重启设备" />
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <Button
                            Margin="4,4,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ShutdownDeviceCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            Tag="Danger">
                            <Button.Content>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="18"
                                        Text="&#xe6f1;" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Foreground="{StaticResource TextBlockForegroundBrush}"
                                        Text="设备关机" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Margin="8,0,0,0"
                Background="White"
                BorderBrush="{DynamicResource DevKitBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="微软雅黑"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="Black"
                            Text="第三方软件" />

                        <Border
                            Grid.Column="1"
                            Margin="8,0"
                            Background="AliceBlue"
                            CornerRadius="12">
                            <TextBlock
                                Margin="8,2"
                                FontFamily="微软雅黑"
                                Foreground="Blue"
                                Text="{Binding ApplicationPackages.Count}" />
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource ExportProgressStyle}">
                            <ProgressBar
                                Height="8"
                                Style="{x:Null}"
                                Value="{Binding ExportProgress}" />
                        </Border>
                    </Grid>

                    <!--  "搜索包名，如 com.tencent"  -->
                    <TextBox
                        Grid.Row="1"
                        Margin="0,8"
                        BorderBrush="{DynamicResource DevKitBorderBrush}" />

                    <ListBox
                        x:Name="PackageListBox"
                        Grid.Row="2"
                        BorderBrush="{DynamicResource DevKitBorderBrush}"
                        BorderThickness="1"
                        ItemsSource="{Binding ApplicationPackages}"
                        ScrollViewer.CanContentScroll="False">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="SelectionChanged">
                                <b:InvokeCommandAction Command="{Binding PackageSelectedCommand}" CommandParameter="{Binding ElementName=PackageListBox, Path=SelectedItem}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem
                                    Width="128"
                                    Command="{Binding ExportPackageCommand}"
                                    Header="导出安装包" />
                                <MenuItem
                                    Width="128"
                                    Command="{Binding UninstallCommand}"
                                    Header="卸载应用" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <UniformGrid
                        Grid.Row="3"
                        Margin="0,12,0,0"
                        Rows="1">
                        <Button
                            Margin="0,0,4,0"
                            HorizontalAlignment="Stretch"
                            BorderBrush="{DynamicResource DevKitBorderBrush}"
                            Command="{Binding SortApplicationCommand}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="14"
                                        Text="&#xe614;" />
                                    <TextBlock Margin="8,0,0,0" Text="排序" />
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <Button
                            Margin="4,0,0,0"
                            HorizontalAlignment="Stretch"
                            BorderBrush="{DynamicResource DevKitBorderBrush}"
                            Command="{Binding RefreshApplicationCommand}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="14"
                                        Text="&#xe602;" />
                                    <TextBlock Margin="8,0,0,0" Text="刷新" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <DockPanel
            Grid.Row="3"
            Margin="16,0,16,16"
            LastChildFill="True">
            <TextBlock Foreground="{StaticResource TextBlockForegroundBrush}" Text="{Binding AdbVision, StringFormat={}{0} · 已就绪, TargetNullValue=adb · 已就绪, FallbackValue=adb · 已就绪}" />

            <TextBlock
                HorizontalAlignment="Right"
                Foreground="{StaticResource TextBlockForegroundBrush}"
                Text="右键包名可导出安装包 / 卸载应用" />
        </DockPanel>

        <Border
            Grid.Row="0"
            Grid.RowSpan="4"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Panel.ZIndex="999"
            Background="#CC2B2B2B"
            CornerRadius="16">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsToastVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock
                Margin="18,9"
                FontSize="13"
                Foreground="White"
                Text="{Binding ToastMessage}" />
        </Border>
    </Grid>
</UserControl>