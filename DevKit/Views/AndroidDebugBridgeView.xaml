<UserControl
    x:Class="DevKit.Views.AndroidDebugBridgeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:DevKit.ViewModels"
    Width="900"
    Height="694"
    d:DataContext="{d:DesignInstance Type=vm:AndroidDebugBridgeViewModel}"
    Background="{DynamicResource DevKitBackgroundBrush}"
    mc:Ignorable="d">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <SolidColorBrush x:Key="TextBlockForegroundBrush" Color="#5f6b7a" />

        <Style x:Key="ExportProgressStyle" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExporting}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <LinearGradientBrush x:Key="GradientForegroundBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0.0" Color="#3ddc84" />
            <GradientStop Offset="1.0" Color="#17a95c" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Margin="16"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextBlockForegroundBrush}"
                Text="选择设备" />

            <ComboBox
                x:Name="DeviceComboBox"
                Grid.Column="1"
                Margin="16,0"
                BorderBrush="{DynamicResource DevKitBorderBrush}"
                ItemsSource="{Binding DeviceItems}">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="SelectionChanged">
                        <b:InvokeCommandAction Command="{Binding DeviceSelectedCommand}" CommandParameter="{Binding ElementName=DeviceComboBox, Path=SelectedItem}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </ComboBox>

            <Button
                Grid.Column="2"
                BorderBrush="{DynamicResource DevKitBorderBrush}"
                Command="{Binding RefreshDeviceCommand}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="/DevKit;component/Fonts/#iconfont"
                            FontSize="14"
                            Text="&#xe602;" />
                        <TextBlock Margin="8,0,0,0" Text="刷新" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource DevKitBorderBrush}" />

        <Grid Grid.Row="2" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="0,0,8,0"
                Background="White"
                BorderBrush="{DynamicResource DevKitBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Background="{StaticResource DevKitBackgroundBrush}"
                            CornerRadius="16">
                            <TextBlock
                                Margin="12"
                                FontFamily="/DevKit;component/Fonts/#iconfont"
                                FontSize="32"
                                Foreground="{StaticResource PrimaryBrush}"
                                Text="&#xe6bf;" />
                        </Border>

                        <Grid Grid.Column="1" Margin="12,4,0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="Black"
                                Text="WDY-AN00" />

                            <StackPanel
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource TextBlockForegroundBrush}"
                                    Text="9f2ac8d1" />

                                <Border
                                    Margin="8,0,0,0"
                                    Background="#1F3DDC84"
                                    BorderBrush="#593DDC84"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <TextBlock
                                        Margin="8,2"
                                        Foreground="#FF16A34A"
                                        Text="有线连接" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1" Margin="16,0">
                        <Line
                            SnapsToDevicePixels="True"
                            Stroke="{DynamicResource DevKitBorderBrush}"
                            StrokeDashArray="4,3"
                            StrokeThickness="1"
                            X1="0"
                            X2="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                            Y1="0.5"
                            Y2="0.5" />
                    </Grid>

                    <UniformGrid
                        Grid.Row="2"
                        Margin="16"
                        Columns="2"
                        Rows="3">
                        <Border
                            Margin="0,0,4,4"
                            Background="#F7F9FC"
                            CornerRadius="8">
                            <StackPanel Margin="12" Orientation="Vertical">
                                <TextBlock Foreground="{StaticResource TextBlockForegroundBrush}" Text="设备品牌" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontFamily="微软雅黑"
                                    FontSize="13"
                                    Foreground="Black"
                                    Text="{Binding DeviceBrand}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="4,0,0,4"
                            Background="#F7F9FC"
                            CornerRadius="8">
                            <StackPanel Margin="12" Orientation="Vertical">
                                <TextBlock Foreground="{StaticResource TextBlockForegroundBrush}" Text="Android版本" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontFamily="微软雅黑"
                                    FontSize="13"
                                    Foreground="Black"
                                    Text="{Binding AndroidVersion}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="0,4,4,4"
                            Background="#F7F9FC"
                            CornerRadius="8">
                            <StackPanel Margin="12" Orientation="Vertical">
                                <TextBlock Foreground="{StaticResource TextBlockForegroundBrush}" Text="ABI架构" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontFamily="微软雅黑"
                                    FontSize="13"
                                    Foreground="Black"
                                    Text="{Binding DeviceAbi}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="4,4,0,4"
                            Background="#F7F9FC"
                            CornerRadius="8">
                            <StackPanel Margin="12" Orientation="Vertical">
                                <TextBlock Foreground="{StaticResource TextBlockForegroundBrush}" Text="屏幕分辨率" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontFamily="微软雅黑"
                                    FontSize="13"
                                    Foreground="Black"
                                    Text="{Binding DeviceSize}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="0,4,4,0"
                            Background="#F7F9FC"
                            CornerRadius="8">
                            <StackPanel Margin="12" Orientation="Vertical">
                                <TextBlock Foreground="{StaticResource TextBlockForegroundBrush}" Text="Android ID" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontFamily="微软雅黑"
                                    FontSize="13"
                                    Foreground="Black"
                                    Text="{Binding AndroidId}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="4,4,0,0"
                            Background="#F7F9FC"
                            CornerRadius="8">
                            <StackPanel Margin="12" Orientation="Vertical">
                                <TextBlock Foreground="{StaticResource TextBlockForegroundBrush}" Text="本机 IP 地址" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontFamily="微软雅黑"
                                    FontSize="13"
                                    Foreground="Black"
                                    Text="{Binding DeviceIp}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border
                        Grid.Row="3"
                        Margin="16,0"
                        Background="#F7F9FC"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid Margin="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border
                                    Width="50"
                                    Height="20"
                                    BorderBrush="#DFE3EA"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <ProgressBar
                                        Height="16"
                                        Margin="2"
                                        VerticalAlignment="Center"
                                        Background="White"
                                        BorderThickness="0"
                                        Foreground="{StaticResource GradientForegroundBrush}"
                                        Style="{x:Null}"
                                        Value="{Binding BatteryProgress}" />
                                </Border>

                                <Border
                                    Width="3"
                                    Height="10"
                                    Background="#DFE3EA" />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="1"
                                Margin="16,0"
                                VerticalAlignment="Center"
                                FontFamily="微软雅黑"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="Black"
                                Text="{Binding BatteryProgress, StringFormat={}{0}%}" />

                            <Border
                                Grid.Column="2"
                                Margin="8,0"
                                HorizontalAlignment="Right"
                                Background="White"
                                BorderBrush="#593DDC84"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="12,4,6,4"
                                        VerticalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="14"
                                        Foreground="#FF16A34A"
                                        Text="&#xe61d;" />

                                    <TextBlock
                                        Margin="0,4,12,4"
                                        VerticalAlignment="Center"
                                        Foreground="#FF16A34A"
                                        Text="{Binding BatteryState}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Column="3"
                                Background="White"
                                BorderBrush="#DFE3EA"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="12,4,6,4"
                                        VerticalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="14"
                                        Foreground="{StaticResource TextBlockForegroundBrush}"
                                        Text="&#xe6f8;" />

                                    <TextBlock
                                        Margin="0,4,12,4"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource TextBlockForegroundBrush}"
                                        Text="{Binding BatteryTemperature}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <UniformGrid
                        Grid.Row="4"
                        Margin="16"
                        Columns="3"
                        IsEnabled="{Binding HasSelectedDevice}"
                        Rows="2">

                        <Button
                            Height="64"
                            Margin="0,0,4,4"
                            HorizontalAlignment="Stretch"
                            hc:BorderElement.CornerRadius="8"
                            Background="#F7F9FC"
                            BorderBrush="{DynamicResource DevKitBorderBrush}"
                            Command="{Binding OutputImageCommand}">
                            <Button.Content>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="18"
                                        Text="&#xe60c;" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Foreground="{StaticResource TextBlockForegroundBrush}"
                                        Text="导出截屏" />
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <Button
                            Height="64"
                            Margin="4,0,4,4"
                            HorizontalAlignment="Stretch"
                            hc:BorderElement.CornerRadius="8"
                            Background="#F7F9FC"
                            BorderBrush="{DynamicResource DevKitBorderBrush}"
                            Command="{Binding ScreenshotCommand}">
                            <Button.Content>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="18"
                                        Text="&#xe635;" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Foreground="{StaticResource TextBlockForegroundBrush}"
                                        Text="截取屏幕" />
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <Button
                            Height="64"
                            Margin="4,0,0,4"
                            HorizontalAlignment="Stretch"
                            hc:BorderElement.CornerRadius="8"
                            Background="#F7F9FC"
                            BorderBrush="{DynamicResource DevKitBorderBrush}"
                            Command="{Binding InstallCommand}">
                            <Button.Content>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="18"
                                        Text="&#xe608;" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Foreground="{StaticResource TextBlockForegroundBrush}"
                                        Text="安装软件" />
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <Button
                            Height="64"
                            Margin="0,4,4,0"
                            HorizontalAlignment="Stretch"
                            hc:BorderElement.CornerRadius="8"
                            Background="#F7F9FC"
                            BorderBrush="{DynamicResource DevKitBorderBrush}"
                            Command="{Binding RebootDeviceCommand}">
                            <Button.Content>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="18"
                                        Text="&#xe60a;" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Foreground="{StaticResource TextBlockForegroundBrush}"
                                        Text="重启设备" />
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <Button
                            Height="64"
                            Margin="4,4,4,0"
                            HorizontalAlignment="Stretch"
                            hc:BorderElement.CornerRadius="8"
                            Background="#F7F9FC"
                            BorderBrush="{DynamicResource DevKitBorderBrush}"
                            Command="{Binding ShutdownDeviceCommand}">
                            <Button.Content>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="18"
                                        Text="&#xe6f1;" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Foreground="{StaticResource TextBlockForegroundBrush}"
                                        Text="设备关机" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Margin="8,0,0,0"
                Background="White"
                BorderBrush="{DynamicResource DevKitBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="微软雅黑"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="Black"
                            Text="第三方软件" />

                        <Border
                            Grid.Column="1"
                            Margin="8,0"
                            Background="AliceBlue"
                            CornerRadius="12">
                            <TextBlock
                                Margin="8,2"
                                FontFamily="微软雅黑"
                                Foreground="Blue"
                                Text="10" />
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource ExportProgressStyle}">
                            <ProgressBar
                                Height="8"
                                Style="{x:Null}"
                                Value="{Binding ExportProgress}" />
                        </Border>
                    </Grid>

                    <hc:TextBox
                        Grid.Row="1"
                        Margin="0,8"
                        hc:InfoElement.Placeholder="搜索包名，如 com.tencent"
                        BorderBrush="{DynamicResource DevKitBorderBrush}" />

                    <ListBox
                        x:Name="PackageListBox"
                        Grid.Row="2"
                        hc:BorderElement.CornerRadius="8"
                        BorderBrush="{DynamicResource DevKitBorderBrush}"
                        BorderThickness="1"
                        ItemsSource="{Binding ApplicationPackages}"
                        ScrollViewer.CanContentScroll="False">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="SelectionChanged">
                                <b:InvokeCommandAction Command="{Binding PackageSelectedCommand}" CommandParameter="{Binding ElementName=PackageListBox, Path=SelectedItem}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem
                                    Width="128"
                                    Command="{Binding ExportPackageCommand}"
                                    Header="导出安装包" />
                                <MenuItem
                                    Width="128"
                                    Command="{Binding UninstallCommand}"
                                    Header="卸载应用" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <UniformGrid
                        Grid.Row="3"
                        Margin="0,12,0,0"
                        Rows="1">
                        <Button
                            Margin="0,0,4,0"
                            HorizontalAlignment="Stretch"
                            BorderBrush="{DynamicResource DevKitBorderBrush}"
                            Command="{Binding SortApplicationCommand}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="14"
                                        Text="&#xe614;" />
                                    <TextBlock Margin="8,0,0,0" Text="排序" />
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <Button
                            Margin="4,0,0,0"
                            HorizontalAlignment="Stretch"
                            BorderBrush="{DynamicResource DevKitBorderBrush}"
                            Command="{Binding RefreshApplicationCommand}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="14"
                                        Text="&#xe602;" />
                                    <TextBlock Margin="8,0,0,0" Text="刷新" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <DockPanel
            Grid.Row="3"
            Margin="16,0,16,16"
            LastChildFill="True">
            <TextBlock Foreground="{StaticResource TextBlockForegroundBrush}" Text="{Binding AdbVision, StringFormat={}{0} · 已就绪, TargetNullValue=adb · 已就绪, FallbackValue=adb · 已就绪}" />

            <TextBlock
                HorizontalAlignment="Right"
                Foreground="{StaticResource TextBlockForegroundBrush}"
                Text="右键包名可导出安装包 / 卸载应用" />
        </DockPanel>
    </Grid>
</UserControl>