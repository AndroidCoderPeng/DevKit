<UserControl
    x:Class="DevKit.Views.NetConfigurationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:DevKit.ViewModels"
    Width="960"
    Height="660"
    d:DataContext="{d:DesignInstance Type=vm:NetConfigurationViewModel}"
    Background="{DynamicResource DevKitBackgroundBrush}"
    mc:Ignorable="d">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <!--  ========== 颜色 ==========  -->
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5F6B7A" />
        <SolidColorBrush x:Key="TertiaryTextBrush" Color="#93A0AE" />
        <SolidColorBrush x:Key="BorderStrongBrush" Color="#DFE3EA" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F9FC" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EAF1FE" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2E7CF6" />
        <SolidColorBrush x:Key="TerminalBodyBrush" Color="#0C1016" />
        <SolidColorBrush x:Key="TerminalBorderBrush" Color="#39434F" />
        <SolidColorBrush x:Key="TerminalDimBrush" Color="#9EAAB8" />

        <!--  ========== 下拉项 ==========  -->
        <Style x:Key="FieldComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource DevKitTextBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border
                            x:Name="ItemBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ========== 输入框（下拉框） ==========  -->
        <Style x:Key="FieldComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource DevKitTextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource FieldComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!--  外框  -->
                            <Border
                                x:Name="ComboBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                SnapsToDevicePixels="True" />

                            <!--  选中项 + 箭头  -->
                            <Grid Margin="12,0,12,0">
                                <ContentPresenter
                                    x:Name="ContentSite"
                                    Margin="0,0,18,0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    IsHitTestVisible="False"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                <Path
                                    x:Name="Arrow"
                                    Width="10"
                                    Height="6"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Data="M 0,0 L 5,5 L 10,0"
                                    Stroke="{StaticResource SecondaryTextBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1" />
                            </Grid>

                            <!--  点击层（放最上层以捕获鼠标）  -->
                            <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="ClickMode" Value="Press" />
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="VerticalAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <!--  下拉浮层  -->
                            <Popup
                                x:Name="PART_Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                PopupAnimation="Slide">
                                <Border
                                    x:Name="DropDownBorder"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,4,0,0"
                                    Padding="4"
                                    Background="White"
                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <ScrollViewer
                                        CanContentScroll="True"
                                        SnapsToDevicePixels="True"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="40" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="Background" Value="White" />
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Arrow" Property="Data" Value="M 0,5 L 5,0 L 10,5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="SelectedItem" Value="{x:Null}" />
                                    <Condition Property="Tag" Value="" />
                                </MultiTrigger.Conditions>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ========== 工具栏按钮 ==========  -->
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource DevKitTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonContainerBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="ButtonContainerBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="TextElement.Foreground" Value="#2E7CF6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="#D9E7FD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ========== 卡片 ==========  -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource DevKitBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <!--  ========== 本机信息项 ==========  -->
        <Style x:Key="InfoItemStyle" TargetType="ContentControl">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border
                            x:Name="InfoItemBorder"
                            Padding="12"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="10">

                            <!--  单一入口：所有信息卡共享的点击行为  -->
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="MouseLeftButtonUp">
                                    <b:InvokeCommandAction Command="{Binding InfoItemCopyCommand}" CommandParameter="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource TertiaryTextBrush}"
                                        Text="{TemplateBinding Tag}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontFamily="Consolas"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource DevKitTextBrush}"
                                        Text="{TemplateBinding Content}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock
                                    x:Name="InfoItemCopyIcon"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontFamily="/DevKit;component/Fonts/#iconfont"
                                    FontSize="16"
                                    Foreground="{StaticResource AccentBrush}"
                                    Opacity="0"
                                    Text="&#xe66c;" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InfoItemBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="InfoItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="InfoItemCopyIcon" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ========== 命令列表项 ==========  -->
        <Style x:Key="CommandItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="CommandItemBorder"
                            Padding="12,10"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{DynamicResource DevKitBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CommandItemBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="CommandItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CommandItemBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="CommandItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ========== 开关 ==========  -->
        <Style x:Key="SwitchStyle" TargetType="CheckBox">
            <Setter Property="Background" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border
                            x:Name="SwitchTrack"
                            Width="34"
                            Height="18"
                            Background="{TemplateBinding Background}"
                            CornerRadius="9">
                            <Ellipse
                                x:Name="SwitchThumb"
                                Width="15"
                                Height="15"
                                Margin="2,0,0,0"
                                HorizontalAlignment="Left"
                                Fill="White">
                                <Ellipse.Effect>
                                    <DropShadowEffect
                                        BlurRadius="3"
                                        Direction="270"
                                        Opacity="0.25"
                                        ShadowDepth="1"
                                        Color="#13223D" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ========== 开关外壳（胶囊） ==========  -->
        <Style x:Key="SwitchPillStyle" TargetType="Border">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DevKitBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="15" />
        </Style>

        <!--  ========== 主按钮（执行） ==========  -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="PrimaryButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryButtonBorder" Property="Background" Value="#1F6EE8" />
                                <Setter TargetName="PrimaryButtonBorder" Property="BorderBrush" Value="#1F6EE8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryButtonBorder" Property="Background" Value="#1A5FCC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ========== 终端标题栏按钮（深色） ==========  -->
        <Style x:Key="TerminalButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource TerminalBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TerminalDimBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="TerminalButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TerminalButtonBorder" Property="Background" Value="#14FFFFFF" />
                                <Setter TargetName="TerminalButtonBorder" Property="BorderBrush" Value="#4C5765" />
                                <Setter Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  终端内的深色开关  -->
        <Style
            x:Key="TerminalSwitchStyle"
            BasedOn="{StaticResource SwitchStyle}"
            TargetType="CheckBox">
            <Setter Property="Background" Value="#4A5462" />
        </Style>

        <!--  终端内的深色开关外壳（胶囊）  -->
        <Style
            x:Key="TerminalSwitchPillStyle"
            BasedOn="{StaticResource SwitchPillStyle}"
            TargetType="Border">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource TerminalBorderBrush}" />
            <Setter Property="CornerRadius" Value="13" />
        </Style>

        <!--  ========== 输入框（带水印） ==========  -->
        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource DevKitTextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="FieldBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                            <Grid Margin="10,0">
                                <TextBlock
                                    x:Name="PlaceholderText"
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{StaticResource TertiaryTextBrush}"
                                    IsHitTestVisible="False"
                                    Text="IP或域名，如 8.8.8.8 / www.baidu.com"
                                    Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  空文本 -> 显示水印；同时覆盖 null，绑定为 null 时 Value="" 是不匹配的  -->
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldBorder" Property="Background" Value="White" />
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="{StaticResource SecondaryTextBrush}"
                Text="网络适配器" />

            <ComboBox
                x:Name="AdapterComboBox"
                Grid.Column="1"
                Width="392"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Background="White"
                BorderThickness="1"
                ItemsSource="{Binding AddressItems}"
                Style="{StaticResource FieldComboBoxStyle}">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="SelectionChanged">
                        <b:InvokeCommandAction Command="{Binding AddressItemSelectedCommand}" CommandParameter="{Binding ElementName=AdapterComboBox, Path=SelectedItem}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </ComboBox>

            <Button
                Grid.Column="2"
                Margin="8,0"
                Command="{Binding RefreshIpAddressCommand}"
                Style="{StaticResource ToolButtonStyle}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="/DevKit;component/Fonts/#iconfont"
                            FontSize="16"
                            Text="&#xe602;" />
                        <TextBlock
                            Margin="8,0,0,0"
                            FontSize="13"
                            Text="刷新" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource DevKitBorderBrush}" />

        <!--  ============================================================ 内容  ============================================================  -->
        <Grid Grid.Row="2" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  本机网络信息  -->
            <Border
                Grid.Row="0"
                Padding="16"
                Style="{StaticResource CardStyle}">
                <Grid>
                    <UniformGrid
                        Grid.Row="0"
                        Margin="0,0,-10,-10"
                        Columns="4"
                        Rows="2">
                        <ContentControl
                            Content="{Binding Ip4, FallbackValue=127.0.0.1}"
                            Style="{StaticResource InfoItemStyle}"
                            Tag="IPv4 地址" />

                        <ContentControl
                            Content="{Binding SubnetMask, FallbackValue=255.255.255.0}"
                            Style="{StaticResource InfoItemStyle}"
                            Tag="子网掩码" />

                        <ContentControl
                            Content="{Binding Gateway, FallbackValue=192.168.3.1}"
                            Style="{StaticResource InfoItemStyle}"
                            Tag="默认网关" />

                        <ContentControl
                            Content="{Binding DeviceMac}"
                            Style="{StaticResource InfoItemStyle}"
                            Tag="物理地址（MAC）" />

                        <ContentControl
                            Content="{Binding Dns}"
                            Style="{StaticResource InfoItemStyle}"
                            Tag="DNS 服务器" />

                        <Border
                            Margin="0,0,10,10"
                            Padding="12"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel Orientation="Vertical">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource TertiaryTextBrush}"
                                    Text="适配器类型" />

                                <TextBlock
                                    Margin="0,8,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource DevKitTextBrush}">
                                    <Run Text="{Binding AdapterType}" />
                                    <Run Text=" · " />
                                    <Run FontWeight="SemiBold" Text="{Binding NetSpeed, StringFormat={}{0} Mbps}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="0,0,10,10"
                            Padding="12"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel Orientation="Vertical">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource TertiaryTextBrush}"
                                    Text="DHCP" />

                                <TextBlock
                                    Margin="0,8,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource DevKitTextBrush}"
                                    Text="{Binding Dhcp}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="0,0,10,10"
                            Padding="12"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource TertiaryTextBrush}"
                                    Text="连接状态" />
                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                    <Ellipse
                                        Width="12"
                                        Height="12"
                                        VerticalAlignment="Center"
                                        Fill="{Binding ConnectionStateColor, FallbackValue={StaticResource TerminalDimBrush}}" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{DynamicResource DevKitTextBrush}"
                                        Text="{Binding ConnectionState, FallbackValue=未连接}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Panel.ZIndex="999"
                        Background="#CC2B2B2B"
                        CornerRadius="16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsToastVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            Margin="18,9"
                            FontSize="13"
                            Foreground="White"
                            Text="{Binding ToastMessage}" />
                    </Border>
                </Grid>
            </Border>

            <!--  命令列表 + 命令输出终端  -->
            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  命令面板  -->
                <Border
                    Grid.Column="0"
                    Padding="16"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource DevKitTextBrush}"
                                Text="常用命令" />

                            <Border
                                Width="24"
                                Height="18"
                                Margin="8,0,0,0"
                                Background="{StaticResource SurfaceHoverBrush}"
                                CornerRadius="10">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource AccentBrush}"
                                    Text="{Binding CommandItems.Count}" />
                            </Border>
                        </StackPanel>

                        <ListBox
                            x:Name="CommandListBox"
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource CommandItemStyle}"
                            ItemsSource="{Binding CommandItems}"
                            ScrollViewer.CanContentScroll="False"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock
                                                x:Name="CommandText"
                                                FontFamily="Consolas"
                                                FontSize="15"
                                                Foreground="{StaticResource DevKitTextBrush}"
                                                Text="{Binding Command}"
                                                TextTrimming="CharacterEllipsis" />

                                            <TextBlock
                                                x:Name="ParamFlagTextBlock"
                                                Margin="4,0,0,0"
                                                FontSize="15"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource AccentBrush}"
                                                Text="@">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NeedParams}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            Foreground="{StaticResource TertiaryTextBrush}"
                                            Text="{Binding Description}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="CommandText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="CommandText" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>

                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="SelectionChanged">
                                    <b:InvokeCommandAction Command="{Binding CommandItemSelectedCommand}" CommandParameter="{Binding ElementName=CommandListBox, Path=SelectedItem}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </ListBox>

                        <StackPanel Grid.Row="2">
                            <Grid Margin="0,0,0,8">
                                <Line
                                    SnapsToDevicePixels="True"
                                    Stroke="{DynamicResource DevKitBorderBrush}"
                                    StrokeDashArray="2,2"
                                    StrokeThickness="1.5"
                                    X1="0"
                                    X2="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                    Y1="0.5"
                                    Y2="0.5" />
                            </Grid>

                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="13"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="参数" />

                            <TextBox IsEnabled="{Binding SelectedItem.NeedParams, ElementName=CommandListBox}" Style="{StaticResource FieldTextBoxStyle}" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource SwitchPillStyle}">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,7,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="循环" />
                                        <CheckBox IsChecked="{Binding IsLoopBoxChecked}" Style="{StaticResource SwitchStyle}" />
                                    </StackPanel>
                                </Border>

                                <Button
                                    Grid.Column="1"
                                    Margin="14,0,0,0"
                                    Command="{Binding TestNetCommand}"
                                    IsEnabled="{Binding SelectedItem.NeedParams, ElementName=CommandListBox}"
                                    Style="{StaticResource PrimaryButtonStyle}">
                                    <Button.Content>
                                        <StackPanel Margin="12,0" Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="/DevKit;component/Fonts/#iconfont"
                                                FontSize="16"
                                                Text="&#xe877;" />
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                FontSize="13"
                                                Text="执行" />
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  终端  -->
                <Border
                    Grid.Column="1"
                    Margin="14,0,0,0"
                    Background="#0C0C0C"
                    CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  终端标题栏  -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                Margin="12,8"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Ellipse
                                    Width="12"
                                    Height="12"
                                    Fill="#ff5f57" />
                                <Ellipse
                                    Width="12"
                                    Height="12"
                                    Margin="8,0"
                                    Fill="#febc2e" />
                                <Ellipse
                                    Width="12"
                                    Height="12"
                                    Fill="#28c840" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{StaticResource TerminalDimBrush}"
                                    Text="cmd.exe" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Text="{Binding ElementName=CommandListBox, Path=SelectedItem.Command, StringFormat={}&#160;—&#160;{0}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#9EAAB8" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                Margin="0,8,8,8"
                                Orientation="Horizontal">
                                <Button Command="{Binding ClearTerminalCommand}" Style="{StaticResource TerminalButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="/DevKit;component/Fonts/#iconfont"
                                            FontSize="16"
                                            Text="&#xe666;" />

                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="清空" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    Margin="8,0,0,0"
                                    Command="{Binding CopyTerminalCommand}"
                                    Style="{StaticResource TerminalButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="/DevKit;component/Fonts/#iconfont"
                                            FontSize="16"
                                            Text="&#xe66c;" />

                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="复制" />
                                    </StackPanel>
                                </Button>

                                <Border Margin="8,0,0,0" Style="{StaticResource TerminalSwitchPillStyle}">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,7,0"
                                            VerticalAlignment="Center"
                                            FontSize="11.5"
                                            Foreground="{StaticResource TerminalDimBrush}"
                                            Text="自动滚动" />
                                        <CheckBox IsChecked="{Binding IsAutoScrolBoxChecked}" Style="{StaticResource TerminalSwitchStyle}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Background="#1fe7ebf1" />

                        <!--  命令输出  -->
                        <TextBox
                            Grid.Row="2"
                            Padding="12,-8,12,0"
                            VerticalAlignment="Top"
                            AcceptsReturn="True"
                            Background="{StaticResource TerminalBodyBrush}"
                            BorderThickness="0"
                            CaretBrush="#3DDC84"
                            FontFamily="Consolas"
                            FontSize="14"
                            Foreground="#C9D1D9"
                            HorizontalScrollBarVisibility="Disabled"
                            IsReadOnly="True"
                            Text="{Binding OutputResult}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
