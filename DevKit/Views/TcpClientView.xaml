<UserControl
    x:Class="DevKit.Views.TcpClientView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:bhv="clr-namespace:DevKit.Behaviors"
    xmlns:cache="clr-namespace:DevKit.Cache"
    xmlns:cvt="clr-namespace:DevKit.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:DevKit.Models"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:DevKit.ViewModels"
    Width="1000"
    Height="730"
    d:DataContext="{d:DesignInstance Type=vm:TcpClientViewModel}"
    Background="{DynamicResource DevKitBackgroundBrush}"
    mc:Ignorable="d">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <SolidColorBrush x:Key="TextBlockForegroundBrush" Color="#5f6b7a" />

        <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F9FC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#93A0AE" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A2E7CF6" />
        <SolidColorBrush x:Key="AccentBorderBrush" Color="#592E7CF6" />
        <SolidColorBrush x:Key="SendTextBrush" Color="#2E7CF6" />
        <SolidColorBrush x:Key="ReceiveTextBrush" Color="#17A95C" />
        <SolidColorBrush x:Key="DangerBrush" Color="#E5484D" />

        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#F7F9FC" />
            <Setter Property="BorderBrush" Value="#DFE3EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="FieldBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#2E7CF6" />
                                <Setter TargetName="FieldBorder" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  主按钮：蓝底白字  -->
        <Style x:Key="PrimaryCompactButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="#2E7CF6" />
            <Setter Property="BorderBrush" Value="#2E7CF6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonContainerBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="#1C6AE0" />
                                <Setter TargetName="ButtonContainerBorder" Property="BorderBrush" Value="#1C6AE0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="#1556C0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  小方形图标按钮：卡片头部的「+」新增  -->
        <Style x:Key="MiniSquareButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DevKitBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="MiniBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MiniBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="MiniBorder" Property="BorderBrush" Value="{StaticResource SendTextBrush}" />
                                <Setter TargetName="MiniBorder" Property="TextElement.Foreground" Value="{StaticResource SendTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MiniBorder" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  扩展指令行的迷你操作按钮：默认透明，行悬浮时出现  -->
        <Style x:Key="CmdMiniButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontFamily" Value="/DevKit;component/Fonts/#iconfont" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource DevKitBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="CmdMiniBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CmdMiniBorder" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  编辑：悬浮蓝色描边  -->
        <Style
            x:Key="CmdEditButtonStyle"
            BasedOn="{StaticResource CmdMiniButtonStyle}"
            TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SendTextBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SendTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  立即发送：悬浮蓝底白字  -->
        <Style
            x:Key="CmdSendButtonStyle"
            BasedOn="{StaticResource CmdMiniButtonStyle}"
            TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SendTextBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SendTextBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  删除：悬浮红底白字  -->
        <Style
            x:Key="CmdDeleteButtonStyle"
            BasedOn="{StaticResource CmdMiniButtonStyle}"
            TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CmdContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DFE3EA" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="MinWidth" Value="126" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CmdMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#1B1B1B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border
                            x:Name="MenuItemBorder"
                            Padding="8,10"
                            Background="Transparent"
                            CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Icon}" />
                                <ContentPresenter
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    ContentSource="Header"
                                    RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="#EAF1FE" />
                                <Setter Property="Foreground" Value="#2E7CF6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <cvt:MessageTagBgConverter x:Key="MessageTagBgConverterKey" />
        <cvt:MessageTypeConverter x:Key="MessageTypeConverterKey" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  未连接  #FFF7F9FC  #FFEEEEF0  -->
            <!--  连接中  #66F2994A  #1FF2994A  -->
            <!--  已连接  #5917A95C  #1F17A95C  -->
            <Border
                Grid.Column="0"
                Margin="14"
                Background="#FFF7F9FC"
                BorderBrush="#FFEEEEF0"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Margin="10,6" Orientation="Horizontal">

                    <!--  未连接  #E7EBF0  #93A0AE  -->
                    <!--  连接中  #FBE1C9  #F2994A  -->
                    <!--  已连接  #BEE7D1  #16A34A  -->
                    <Border
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Background="#E7EBF0"
                        CornerRadius="10">
                        <Border
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#93A0AE"
                            CornerRadius="5" />
                    </Border>

                    <!--  未连接  #5F6B7A  -->
                    <!--  连接中  #F2994A  -->
                    <!--  已连接  #16A34A  -->
                    <TextBlock
                        Margin="8,0,4,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="#5F6B7A"
                        Text="{Binding ConnectionState, FallbackValue=未连接}" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Margin="0,20"
                Background="{StaticResource DevKitBorderBrush}" />

            <Border
                Grid.Column="2"
                Height="36"
                Margin="14,8"
                Background="#F7F9FC"
                BorderThickness="1"
                CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource DevKitBorderBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=IpTextBox}" Value="True">
                                <Setter Property="BorderBrush" Value="#2E7CF6" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect
                                            BlurRadius="6"
                                            Opacity="0.18"
                                            ShadowDepth="0"
                                            Color="#2E7CF6" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontFamily="/DevKit;component/Fonts/#iconfont"
                        FontSize="18"
                        Foreground="#93A0AE"
                        Text="&#xe8b2;" />

                    <Grid Grid.Column="1">
                        <TextBox
                            x:Name="IpTextBox"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            Foreground="{DynamicResource DevKitTextBrush}"
                            Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="#93A0AE"
                            IsHitTestVisible="False"
                            Text="服务端 IP，如：192.168.3.11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=IpTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <TextBlock
                Grid.Column="3"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Foreground="{StaticResource TextBlockForegroundBrush}"
                Text=":" />

            <TextBox
                Grid.Column="4"
                Width="100"
                Height="36"
                Margin="14,0"
                HorizontalContentAlignment="Center"
                MaxLength="6"
                Style="{StaticResource FieldTextBoxStyle}" />

            <Button
                Grid.Column="5"
                Margin="0,0,14,0"
                Command="{Binding ConnectServerCommand}"
                Style="{StaticResource PrimaryCompactButtonStyle}">
                <Button.Content>
                    <StackPanel Margin="12,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="/DevKit;component/Fonts/#iconfont"
                            FontSize="16"
                            Text="&#xe667;" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Text="连接" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>

        <DockPanel
            Margin="10"
            LastChildFill="True"
            Visibility="Collapsed">
            <Grid Width="260">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True">
                    <TextBlock
                        Width="70"
                        VerticalAlignment="Center"
                        Text="服务端" />

                    <TextBox
                        Margin="10,0"
                        VerticalAlignment="Center"
                        BorderBrush="{DynamicResource DevKitBorderBrush}"
                        Text="{Binding RemoteAddress}"
                        TextWrapping="NoWrap" />
                </DockPanel>

                <DockPanel
                    Grid.Row="1"
                    Margin="0,10"
                    LastChildFill="True">
                    <TextBlock
                        Width="70"
                        VerticalAlignment="Center"
                        Text="端口号" />

                    <TextBox
                        Margin="10,0"
                        VerticalAlignment="Center"
                        BorderBrush="{DynamicResource DevKitBorderBrush}"
                        MaxLength="5"
                        Text="{Binding RemotePort}"
                        TextWrapping="NoWrap" />
                </DockPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock VerticalAlignment="Center" Text="状态" />

                        <Ellipse
                            Width="15"
                            Height="15"
                            Margin="15,0,0,0"
                            Fill="{Binding ConnectionStateColor}" />
                    </DockPanel>

                    <Button
                        Grid.Column="1"
                        Margin="10,0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding ConnectRemoteCommand}"
                        Content="{Binding ButtonState}"
                        Style="{StaticResource ButtonPrimary}" />
                </Grid>

                <UniformGrid
                    Grid.Row="3"
                    Margin="0,10,10,10"
                    Columns="2"
                    Rows="1">
                    <Button
                        Margin="0,0,5,0"
                        HorizontalAlignment="Stretch"
                        BorderBrush="{DynamicResource DevKitBorderBrush}"
                        Command="{Binding SaveCommunicationCommand}"
                        Content="保存数据" />

                    <Button
                        Margin="5,0,0,0"
                        HorizontalAlignment="Stretch"
                        BorderBrush="{DynamicResource DevKitBorderBrush}"
                        Command="{Binding ClearCommunicationCommand}"
                        Content="清空消息" />
                </UniformGrid>

                <DockPanel
                    Grid.Row="4"
                    Margin="0,0,10,0"
                    LastChildFill="True">
                    <TextBlock VerticalAlignment="Center" Text="扩展指令" />

                    <Button
                        HorizontalAlignment="Right"
                        BorderBrush="{DynamicResource DevKitBorderBrush}"
                        Command="{Binding AddExtensionCommand}"
                        Content="&#xe6aa;"
                        FontFamily="/DevKit;component/Fonts/#iconfont" />
                </DockPanel>

                <DataGrid
                    x:Name="ExCommandDataGrid"
                    Grid.Row="5"
                    Margin="0,10,10,0"
                    Padding="0"
                    AutoGenerateColumns="False"
                    Background="White"
                    BorderThickness="0"
                    GridLinesVisibility="All"
                    HorizontalGridLinesBrush="{DynamicResource DevKitBorderBrush}"
                    ItemsSource="{Binding ExCommandCollection}"
                    RowHeight="30"
                    VerticalGridLinesBrush="{DynamicResource DevKitBorderBrush}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Height" Value="30" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Height" Value="30" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Height" Value="30" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="TextBlock.TextAlignment" Value="Center" />
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="2*"
                            Binding="{Binding CommandValue}"
                            CanUserResize="False"
                            Header="指令值"
                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Annotation}"
                            CanUserResize="False"
                            Header="备注"
                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>

                    <!--  选中事件  -->
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="SelectionChanged">
                            <b:InvokeCommandAction Command="{Binding DataGridItemSelectedCommand}" CommandParameter="{Binding SelectedItem.CommandValue, ElementName=ExCommandDataGrid}" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>

                    <!--  右键菜单  -->
                    <DataGrid.ContextMenu>
                        <ContextMenu Width="120">
                            <MenuItem Command="{Binding SendCommand}" Header="发送" />
                            <MenuItem
                                Command="{Binding CopyCommand}"
                                CommandParameter="{Binding Path=PlacementTarget.(DataGrid.SelectedItem).(cache:ExCommandCache.CommandValue), RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                Header="复制" />
                            <MenuItem
                                Command="{Binding EditCommand}"
                                CommandParameter="{Binding Path=PlacementTarget.(DataGrid.SelectedItem).(cache:ExCommandCache.Id), RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                Header="编辑" />
                            <MenuItem
                                Command="{Binding DeleteCommand}"
                                CommandParameter="{Binding Path=PlacementTarget.(DataGrid.SelectedItem).(cache:ExCommandCache.Id), RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                Header="删除" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </Grid>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox
                    Grid.Row="0"
                    BorderBrush="{StaticResource DevKitBorderBrush}"
                    ItemsSource="{Binding Logs}"
                    ScrollViewer.CanContentScroll="False"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Border Background="{Binding IsSend, Converter={StaticResource MessageTagBgConverterKey}}" CornerRadius="3">
                                        <TextBlock
                                            Margin="3,1"
                                            FontSize="10"
                                            FontWeight="Light"
                                            Foreground="White"
                                            Text="{Binding IsSend, Converter={StaticResource MessageTypeConverterKey}}" />
                                    </Border>

                                    <TextBlock
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{Binding Time, StringFormat=[{0}]}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,2,0,0"
                                    FontSize="12"
                                    Text="{Binding Content}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Border x:Name="ItemContainerBorder" Padding="3">
                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemContainerBorder" Property="Background" Value="{DynamicResource DevKitBackgroundBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <!--  自动滑动到最底部  -->
                    <b:Interaction.Behaviors>
                        <bhv:AutoScrollToBottomBehavior />
                    </b:Interaction.Behaviors>

                    <ListBox.ContextMenu>
                        <ContextMenu Width="120">
                            <MenuItem
                                Command="{Binding CopyLogCommand}"
                                CommandParameter="{Binding Path=PlacementTarget.(ListBox.SelectedItem).(model:LogModel.Content), RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                Header="复制" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>

                <Grid
                    Grid.Row="1"
                    Height="60"
                    Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        Padding="4"
                        VerticalContentAlignment="Top"
                        BorderBrush="{DynamicResource DevKitBorderBrush}"
                        FontSize="14"
                        Text="{Binding UserInputText}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />

                    <Button
                        Grid.Column="1"
                        Width="65"
                        Height="60"
                        Margin="10,0,0,0"
                        Command="{Binding SendCommand}"
                        Content="发送"
                        Style="{StaticResource ButtonPrimary}" />
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        BorderBrush="{DynamicResource DevKitBorderBrush}"
                        Command="{Binding OpenScriptCommand}"
                        Content="脚本" />

                    <CheckBox
                        x:Name="LoopCheckBox"
                        Grid.Column="1"
                        Margin="10,0"
                        BorderBrush="{DynamicResource DevKitBorderBrush}"
                        Content="循环发送">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="Checked">
                                <b:InvokeCommandAction Command="{Binding TimeCheckedCommand}" />
                            </b:EventTrigger>

                            <b:EventTrigger EventName="Unchecked">
                                <b:InvokeCommandAction Command="{Binding TimeUncheckedCommand}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </CheckBox>

                    <TextBox
                        Grid.Column="2"
                        Width="60"
                        FontSize="14"
                        IsEnabled="{Binding ElementName=LoopCheckBox, Path=IsChecked}"
                        MaxLength="5"
                        Text="{Binding CommandInterval}" />

                    <TextBlock
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Text="ms/次" />

                    <ComboBox
                        x:Name="EncodeComboBox"
                        Grid.Column="4"
                        Width="80"
                        Margin="10,0"
                        BorderBrush="{DynamicResource DevKitBorderBrush}"
                        SelectedIndex="0">
                        <ComboBoxItem Content="16进制" />
                        <ComboBoxItem Content="ASCII" />

                        <!--  选中事件  -->
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="SelectionChanged">
                                <b:InvokeCommandAction Command="{Binding ComboBoxItemSelectedCommand}" CommandParameter="{Binding SelectedIndex, ElementName=EncodeComboBox}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </ComboBox>

                    <CheckBox
                        Grid.Column="5"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Right"
                        BorderBrush="{DynamicResource DevKitBorderBrush}"
                        Content="16进制"
                        IsChecked="{Binding IsHexSelected}" />
                </Grid>
            </Grid>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2.5*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  会话统计  -->
                    <Border
                        Grid.Row="0"
                        Background="White"
                        BorderBrush="{DynamicResource DevKitBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Margin="14,12">
                            <!--  标题 + 分隔线  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource DevKitTextBrush}"
                                    Text="会话统计" />

                                <Border
                                    Grid.Column="1"
                                    Height="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource DevKitBorderBrush}" />
                            </Grid>

                            <!--  保持时长  -->
                            <Border
                                Margin="0,12,0,0"
                                Padding="12,10"
                                Background="{StaticResource SurfaceBrush}"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Text="保持时长" />

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource DevKitTextBrush}"
                                        Text="{Binding SessionDuration, FallbackValue=—}" />
                                </Grid>
                            </Border>

                            <!--  发送 / 接收  -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Padding="12,10"
                                    Background="{StaticResource SurfaceBrush}"
                                    CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            Text="发送" />

                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource SendTextBrush}"
                                                Text="{Binding SendCount, FallbackValue=0}" />

                                            <TextBlock
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Bottom"
                                                FontSize="11"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                Text="{Binding SendByteSize, StringFormat={}{0} B}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Padding="12,10"
                                    Background="{StaticResource SurfaceBrush}"
                                    CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            Text="接收" />

                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource ReceiveTextBrush}"
                                                Text="{Binding ReceiveCount, FallbackValue=0}" />

                                            <TextBlock
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Bottom"
                                                FontSize="11"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                Text="{Binding ReceiveByteSize, StringFormat={}{0} B}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  扩展指令  -->
                    <Border
                        Grid.Row="1"
                        Margin="0,16,0,0"
                        Background="White"
                        BorderBrush="{DynamicResource DevKitBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <DockPanel Margin="14,12">
                            <!--  标题 + 数量 + 分隔线 + 新增  -->
                            <Grid DockPanel.Dock="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource DevKitTextBrush}"
                                    Text="扩展指令" />

                                <Border
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Padding="8,4"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource AccentSoftBrush}"
                                    CornerRadius="10">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource SendTextBrush}"
                                        Text="{Binding ExCommandCollection.Count}" />
                                </Border>

                                <Border
                                    Grid.Column="2"
                                    Height="1"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource DevKitBorderBrush}" />

                                <Button
                                    Grid.Column="3"
                                    Command="{Binding AddExtensionCommand}"
                                    Content="&#xe6aa;"
                                    FontFamily="/DevKit;component/Fonts/#iconfont"
                                    FontSize="14"
                                    Style="{StaticResource MiniSquareButtonStyle}"
                                    ToolTip="新增指令" />
                            </Grid>

                            <!--  指令列表 + 空态  -->
                            <Grid Margin="0,12,0,0">
                                <ListBox
                                    x:Name="ExCommandListBox"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding ExCommandCollection}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock
                                                        x:Name="CommandValueTextBlock"
                                                        FontSize="13"
                                                        Foreground="{DynamicResource DevKitTextBrush}"
                                                        Text="{Binding CommandValue}" />

                                                    <TextBlock
                                                        x:Name="AnnotationTextBlock"
                                                        Margin="0,4,0,0"
                                                        FontSize="11"
                                                        Foreground="{StaticResource MutedTextBrush}"
                                                        Text="{Binding Annotation}" />
                                                </StackPanel>

                                                <StackPanel
                                                    x:Name="ButtonPanel"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Visibility="Collapsed">
                                                    <Button
                                                        Command="{Binding DataContext.QuickSendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding CommandValue}"
                                                        Content="&#xe67b;"
                                                        Style="{StaticResource CmdSendButtonStyle}"
                                                        ToolTip="立即发送" />

                                                    <Button
                                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Id}"
                                                        Content="&#xe6d4;"
                                                        Style="{StaticResource CmdEditButtonStyle}"
                                                        ToolTip="编辑" />

                                                    <Button
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Id}"
                                                        Content="&#xe666;"
                                                        Style="{StaticResource CmdDeleteButtonStyle}"
                                                        ToolTip="删除" />
                                                </StackPanel>
                                            </Grid>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter TargetName="ButtonPanel" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="CommandValueTextBlock" Property="TextTrimming" Value="CharacterEllipsis" />
                                                    <Setter TargetName="AnnotationTextBlock" Property="TextTrimming" Value="CharacterEllipsis" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>

                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border
                                                            x:Name="CmdItemBorder"
                                                            Margin="0,0,0,6"
                                                            Padding="10"
                                                            Background="{StaticResource SurfaceBrush}"
                                                            BorderBrush="Transparent"
                                                            BorderThickness="1"
                                                            CornerRadius="8">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="CmdItemBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                                <Setter TargetName="CmdItemBorder" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="CmdItemBorder" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <!--  点击整行填入输入框  -->
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="SelectionChanged">
                                            <b:InvokeCommandAction Command="{Binding DataGridItemSelectedCommand}" CommandParameter="{Binding SelectedItem.CommandValue, ElementName=ExCommandListBox}" />
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>

                                    <ListBox.ContextMenu>
                                        <ContextMenu Style="{StaticResource CmdContextMenuStyle}">
                                            <MenuItem
                                                Command="{Binding CopyCommand}"
                                                CommandParameter="{Binding Path=PlacementTarget.(ListBox.SelectedItem).(cache:ExCommandCache.CommandValue), RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                Header="复制"
                                                Style="{StaticResource CmdMenuItemStyle}">
                                                <MenuItem.Icon>
                                                    <TextBlock
                                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                                        FontSize="16"
                                                        Text="&#xe66c;" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                </ListBox>

                                <!--  空态：无指令时覆盖显示  -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ExCommandCollection.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Rectangle
                                        Fill="{StaticResource SurfaceBrush}"
                                        RadiusX="8"
                                        RadiusY="8"
                                        Stroke="#DFE3EA"
                                        StrokeDashArray="3 3" />

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            Text="暂无扩展指令" />

                                        <TextBlock
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            Text="点击右上角「+」新增常用指令" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="0,16,16,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Background="White"
                        BorderBrush="{DynamicResource DevKitBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8" />

                    <Border
                        Grid.Row="1"
                        Margin="0,16,0,0"
                        Background="White"
                        BorderBrush="{DynamicResource DevKitBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <TextBlock
                Margin="16"
                Foreground="{StaticResource TextBlockForegroundBrush}"
                Text="{Binding ConnectStateInfo, FallbackValue=未连接}" />

            <TextBlock
                Grid.Column="1"
                Margin="16"
                HorizontalAlignment="Right"
                Foreground="{StaticResource TextBlockForegroundBrush}"
                Text="{Binding LastDataTime, StringFormat={}{0} · 消息列表自动滚动, FallbackValue=消息列表自动滚动}" />
        </Grid>
    </Grid>
</UserControl>