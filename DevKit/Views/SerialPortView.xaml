<Window
    x:Class="DevKit.Views.SerialPortView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:DevKit.ViewModels"
    Title="串口通信"
    Width="1066"
    Height="768"
    d:DataContext="{d:DesignInstance Type=vm:SerialPortViewModel}"
    Background="{StaticResource DevKitBackgroundBrush}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Foreground" Value="{StaticResource DevKitTextBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border
                            x:Name="ItemBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource DevKitAccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource DevKitAccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource DevKitOnAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SerialPortComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource DevKitTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="{StaticResource DevKitFontSize14}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!--  外框：底色 / 边框 / 圆角  -->
                            <Border
                                x:Name="RootBorder"
                                Background="{StaticResource DevKitSurfaceBrush}"
                                BorderBrush="{StaticResource DevKitBorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                SnapsToDevicePixels="True" />

                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  左侧图标  -->
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource DevKitIconFontFamily}"
                                    FontSize="{StaticResource DevKitFontSize18}"
                                    Foreground="{StaticResource DevKitTextMutedBrush}"
                                    Text="&#xe8a7;" />

                                <!--  选中项文本  -->
                                <ContentPresenter
                                    x:Name="ContentSite"
                                    Grid.Column="1"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    IsHitTestVisible="False"
                                    SnapsToDevicePixels="True" />

                                <!--  右侧箭头  -->
                                <Path
                                    x:Name="Arrow"
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Data="M 0,0 L 5,5 L 10,0"
                                    Stroke="{StaticResource DevKitTextSecondaryBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1" />
                            </Grid>

                            <!--  点击层：放在最上层捕获鼠标、驱动 IsDropDownOpen  -->
                            <ToggleButton
                                ClickMode="Press"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!--  下拉浮层（POPUP 名称必须保留为 PART_Popup）  -->
                            <Popup
                                x:Name="PART_Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="Slide">
                                <Border
                                    x:Name="DropDownBorder"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,4,0,0"
                                    Padding="2"
                                    Background="White"
                                    BorderBrush="{StaticResource DevKitBorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <ScrollViewer
                                        CanContentScroll="True"
                                        SnapsToDevicePixels="True"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!--  hover：边框变主色  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource DevKitAccentBrush}" />
                            </Trigger>

                            <!--  展开：箭头翻转  -->
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Arrow" Property="Data" Value="M 0,5 L 5,0 L 10,5" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommonComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource DevKitTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="{StaticResource DevKitFontSize14}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!--  外框：底色 / 边框 / 圆角  -->
                            <Border
                                x:Name="RootBorder"
                                Background="{StaticResource DevKitSurfaceBrush}"
                                BorderBrush="{StaticResource DevKitBorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                SnapsToDevicePixels="True" />

                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  选中项文本  -->
                                <ContentPresenter
                                    x:Name="ContentSite"
                                    Grid.Column="0"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    IsHitTestVisible="False"
                                    SnapsToDevicePixels="True" />

                                <!--  右侧箭头  -->
                                <Path
                                    x:Name="Arrow"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Data="M 0,0 L 5,5 L 10,0"
                                    Stroke="{StaticResource DevKitTextSecondaryBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1" />
                            </Grid>

                            <!--  点击层：放在最上层捕获鼠标、驱动 IsDropDownOpen  -->
                            <ToggleButton
                                ClickMode="Press"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!--  下拉浮层（POPUP 名称必须保留为 PART_Popup）  -->
                            <Popup
                                x:Name="PART_Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="Slide">
                                <Border
                                    x:Name="DropDownBorder"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,4,0,0"
                                    Padding="2"
                                    Background="White"
                                    BorderBrush="{StaticResource DevKitBorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <ScrollViewer
                                        CanContentScroll="True"
                                        SnapsToDevicePixels="True"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!--  hover：边框变主色  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource DevKitAccentBrush}" />
                            </Trigger>

                            <!--  展开：箭头翻转  -->
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Arrow" Property="Data" Value="M 0,5 L 5,0 L 10,5" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="14"
                Background="{Binding StateOuterBackgroundColor}"
                BorderBrush="{Binding StateOuterBorderColor}"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Margin="10,6" Orientation="Horizontal">
                    <Border
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Background="{Binding StateInnerBackgroundColor}"
                        CornerRadius="10">
                        <Border
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{Binding StateInnerBorderColor}"
                            CornerRadius="5" />
                    </Border>

                    <TextBlock
                        Margin="8,0,4,0"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource DevKitFontSize14}"
                        FontWeight="SemiBold"
                        Foreground="{Binding StateTextColor}"
                        Text="{Binding StateText, FallbackValue=未打开}" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Width="2"
                Margin="0,20"
                Background="{StaticResource DevKitBorderBrush}" />

            <ComboBox
                Grid.Column="2"
                Margin="14,8"
                ItemsSource="{Binding DevicePortSource}"
                SelectedItem="{Binding SelectedPort, Mode=TwoWay}"
                Style="{StaticResource SerialPortComboBoxStyle}" />

            <Button
                Grid.Column="3"
                VerticalAlignment="Center"
                Style="{StaticResource DevKitButtonStyle}">
                <Button.Content>
                    <StackPanel Margin="8,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DevKitIconFontFamily}"
                            FontSize="{StaticResource DevKitFontSize16}"
                            Text="&#xe602;" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource DevKitFontSize13}"
                            Foreground="{StaticResource DevKitTextBrush}"
                            Text="刷新" />
                    </StackPanel>
                </Button.Content>
            </Button>

            <Border
                Grid.Column="4"
                Width="2"
                Margin="14,20"
                Background="{StaticResource DevKitBorderBrush}" />

            <ComboBox
                Grid.Column="5"
                Margin="0,8"
                ItemsSource="{Binding BaudRateSource}"
                SelectedItem="{Binding SelectedBaudRate, Mode=TwoWay}"
                Style="{StaticResource CommonComboBoxStyle}" />

            <Border
                Grid.Column="6"
                Width="2"
                Margin="14,20"
                Background="{StaticResource DevKitBorderBrush}" />

            <Border Grid.Column="7" />

            <!-- 参数域 -->
            <Border
                Grid.Column="8"
                Width="2"
                Margin="14,20"
                Background="{StaticResource DevKitBorderBrush}" />

            <Button
                Grid.Column="9"
                Margin="0,0,14,0"
                Command="{Binding OptionPortCommand}"
                Style="{StaticResource DevKitPrimaryButtonStyle}">
                <Button.Content>
                    <StackPanel Margin="12,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DevKitIconFontFamily}"
                            FontSize="{StaticResource DevKitFontSize16}"
                            Text="&#xe667;" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource DevKitFontSize14}"
                            Text="{Binding ButtonStateText}" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>

        <Grid Grid.Row="2" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="16"
                Foreground="{Binding StateTextColor}">
                <Run Text="{Binding ConnectionState}" />
                <Run Text=" " />
                <Run Text="{Binding RemoteAddress}" />
                <Run Text=":" />
                <Run Text="{Binding RemotePort}" />
            </TextBlock>

            <Border
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Panel.ZIndex="999"
                Background="{StaticResource DevKitToastBrush}"
                CornerRadius="16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsToastVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock
                    Margin="18,9"
                    FontSize="{StaticResource DevKitFontSize14}"
                    Foreground="{StaticResource DevKitOnAccentBrush}"
                    Text="{Binding ToastMessage}" />
            </Border>

            <TextBlock
                Grid.Column="2"
                Margin="16"
                HorizontalAlignment="Right"
                Foreground="{StaticResource DevKitTextSecondaryBrush}"
                Text="{Binding LastDataTime, StringFormat={}{0} · 消息列表自动滚动, FallbackValue=消息列表自动滚动}" />
        </Grid>
    </Grid>
</Window>
