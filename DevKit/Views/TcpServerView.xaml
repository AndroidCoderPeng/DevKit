<UserControl
    x:Class="DevKit.Views.TcpServerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:DevKit.ViewModels"
    Width="1024"
    Height="760"
    d:DataContext="{d:DesignInstance Type=vm:TcpServerViewModel}"
    Background="{DynamicResource DevKitBackgroundBrush}"
    mc:Ignorable="d">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{StaticResource DevKitSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DevKitBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="FieldBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource DevKitAccentBrush}" />
                                <Setter TargetName="FieldBorder" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  开关样式复选框  -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource DevKitTextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" TextElement.Foreground="{TemplateBinding Foreground}">
                            <Border
                                x:Name="SwitchTrack"
                                Width="32"
                                Height="18"
                                VerticalAlignment="Center"
                                Background="{StaticResource DevKitBorderStrongBrush}"
                                CornerRadius="9">
                                <Ellipse
                                    x:Name="SwitchThumb"
                                    Width="14"
                                    Height="14"
                                    Margin="2,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Fill="White" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource DevKitAccentBrush}" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  主按钮：蓝底白字  -->
        <Style x:Key="PrimaryCompactButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{StaticResource DevKitAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonContainerBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="{StaticResource DevKitAccentHoverBrush}" />
                                <Setter TargetName="ButtonContainerBorder" Property="BorderBrush" Value="{StaticResource DevKitAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="{StaticResource DevKitAccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  消息条上的「复制」小按钮：默认透明、悬浮出现  -->
        <Style x:Key="CopyMiniButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource DevKitTextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="CopyBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CopyBorder" Property="Background" Value="{StaticResource DevKitAccent12Brush}" />
                                <Setter Property="Foreground" Value="{StaticResource DevKitAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  未连接  #FFF7F9FC  #FFEEEEF0  -->
            <!--  连接中  #66F2994A  #1FF2994A  -->
            <!--  已连接  #5917A95C  #1F17A95C  -->
            <Border
                Grid.Column="0"
                Margin="14"
                Background="{Binding StateOuterBackgroundColor}"
                BorderBrush="{Binding StateOuterBorderColor}"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Margin="10,6" Orientation="Horizontal">

                    <!--  未连接  #E7EBF0  #93A0AE  -->
                    <!--  连接中  #FBE1C9  #F2994A  -->
                    <!--  已连接  #BEE7D1  #16A34A  -->
                    <Border
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Background="{Binding StateInnerBackgroundColor}"
                        CornerRadius="10">
                        <Border
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{Binding StateInnerBorderColor}"
                            CornerRadius="5" />
                    </Border>

                    <!--  未连接  #5F6B7A  -->
                    <!--  连接中  #F2994A  -->
                    <!--  已连接  #16A34A  -->
                    <TextBlock
                        Margin="8,0,4,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{Binding StateTextColor}"
                        Text="{Binding ListenState, FallbackValue=未监听}" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Margin="0,20"
                Background="{StaticResource DevKitBorderBrush}" />

            <Border
                Grid.Column="2"
                Height="36"
                Margin="14,8"
                Background="{StaticResource DevKitSurfaceBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource DevKitBorderBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=IpTextBox}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource DevKitAccentBrush}" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect
                                            BlurRadius="6"
                                            Opacity="0.18"
                                            ShadowDepth="0"
                                            Color="{StaticResource DevKitAccentColor}" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontFamily="/DevKit;component/Fonts/#iconfont"
                        FontSize="18"
                        Foreground="{StaticResource DevKitTextMutedBrush}"
                        Text="&#xe8b2;" />

                    <ComboBox
                        Grid.Column="1"
                        Margin="4,0,0,0"
                        ItemsSource="{Binding LocalHostSource}">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="Foreground" Value="{StaticResource DevKitTextBrush}" />
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                </Grid>
            </Border>

            <TextBlock
                Grid.Column="3"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Foreground="{StaticResource DevKitTextSecondaryBrush}"
                Text=":" />

            <TextBox
                Grid.Column="4"
                Width="100"
                Height="36"
                Margin="14,0"
                HorizontalContentAlignment="Center"
                MaxLength="6"
                Style="{StaticResource FieldTextBoxStyle}"
                Text="{Binding RemotePort, UpdateSourceTrigger=PropertyChanged}" />

            <CheckBox
                x:Name="ReusePortSwitch"
                Grid.Column="5"
                Command="{Binding ReusePortSwitchCommand}"
                CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                Content="复用端口"
                IsChecked="{Binding IsReusePortEnabled, Mode=TwoWay}"
                Style="{StaticResource ToggleSwitchStyle}" />

            <Button
                Grid.Column="6"
                Margin="14,0"
                HorizontalAlignment="Right"
                Command="{Binding ListenPortCommand}"
                Style="{StaticResource PrimaryCompactButtonStyle}">
                <Button.Content>
                    <StackPanel Margin="12,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="/DevKit;component/Fonts/#iconfont"
                            FontSize="16"
                            Text="&#xe667;" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Text="{Binding ButtonStateText}" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2.5*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  会话统计  -->
                    <Border
                        Grid.Row="0"
                        Background="White"
                        BorderBrush="{DynamicResource DevKitBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Margin="14,12">
                            <!--  标题 + 分隔线  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource DevKitTextBrush}"
                                    Text="监听概览" />

                                <Border
                                    Grid.Column="1"
                                    Height="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource DevKitBorderBrush}" />
                            </Grid>

                            <!--  保持时长  -->
                            <Border
                                Margin="0,12,0,0"
                                Padding="12,10"
                                Background="{StaticResource DevKitSurfaceBrush}"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{StaticResource DevKitTextMutedBrush}"
                                        Text="运行时长" />

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource DevKitTextBrush}"
                                        Text="{Binding RunningTime, FallbackValue=--:--:--}" />
                                </Grid>
                            </Border>


                            <UniformGrid
                                Margin="0,12"
                                Columns="2"
                                Rows="2">
                                <!--  在线客户端 / 未读消息  -->
                                <Border
                                    Margin="0,0,6,6"
                                    Padding="12,10"
                                    Background="{StaticResource DevKitSurfaceBrush}"
                                    CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{StaticResource DevKitTextMutedBrush}"
                                            Text="在线客户端" />

                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource DevKitSuccessBrush}"
                                                Text="{Binding OnlineClienCount, FallbackValue=0}" />

                                            <TextBlock
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Bottom"
                                                FontSize="11"
                                                Foreground="{StaticResource DevKitTextMutedBrush}"
                                                Text="{Binding ClienCount, StringFormat={}共 {0} 个}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border
                                    Margin="6,0,0,6"
                                    Padding="12,10"
                                    Background="{StaticResource DevKitSurfaceBrush}"
                                    CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{StaticResource DevKitTextMutedBrush}"
                                            Text="未读消息" />

                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource DevKitWarningBrush}"
                                                Text="{Binding UnReadMessageCount, FallbackValue=0}" />

                                            <TextBlock
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Bottom"
                                                FontSize="11"
                                                Foreground="{StaticResource DevKitTextMutedBrush}"
                                                Text="待查看" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!--  发送 / 接收  -->
                                <Border
                                    Margin="0,6,6,0"
                                    Padding="12,10"
                                    Background="{StaticResource DevKitSurfaceBrush}"
                                    CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{StaticResource DevKitTextMutedBrush}"
                                            Text="发送" />

                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource DevKitAccentBrush}"
                                                Text="{Binding SendCount, FallbackValue=0}" />

                                            <TextBlock
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Bottom"
                                                FontSize="11"
                                                Foreground="{StaticResource DevKitTextMutedBrush}"
                                                Text="{Binding SendByteSize, StringFormat={}共 {0} B}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Margin="6,6,0,0"
                                    Padding="12,10"
                                    Background="{StaticResource DevKitSurfaceBrush}"
                                    CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{StaticResource DevKitTextMutedBrush}"
                                            Text="接收" />

                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource DevKitSuccessBrush}"
                                                Text="{Binding ReceiveCount, FallbackValue=0}" />

                                            <TextBlock
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Bottom"
                                                FontSize="11"
                                                Foreground="{StaticResource DevKitTextMutedBrush}"
                                                Text="{Binding ReceiveByteSize, StringFormat={}共 {0} B}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="0,16,16,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="16"
                Foreground="{Binding StateTextColor}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} {1}:{2}">
                        <Binding Path="ListenState" />
                        <Binding Path="ListenAddress" />
                        <Binding Path="ListenPort" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <Border
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Panel.ZIndex="999"
                Background="{StaticResource DevKitToastBrush}"
                CornerRadius="16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsToastVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock
                    Margin="18,9"
                    FontSize="13"
                    Foreground="White"
                    Text="{Binding ToastMessage}" />
            </Border>

            <TextBlock
                Grid.Column="2"
                Margin="16"
                HorizontalAlignment="Right"
                Foreground="{StaticResource DevKitTextSecondaryBrush}"
                Text="{Binding LastDataTime, StringFormat={}{0} · 消息列表自动滚动, FallbackValue=消息列表自动滚动}" />
        </Grid>
    </Grid>
</UserControl>
