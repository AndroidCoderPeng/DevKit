<UserControl
    x:Class="DevKit.Views.ColorResourceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:cvt="clr-namespace:DevKit.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:DevKit.ViewModels"
    Width="1080"
    Height="800"
    d:DataContext="{d:DesignInstance Type=vm:ColorResourceViewModel}"
    Background="{DynamicResource DevKitBackgroundBrush}"
    mc:Ignorable="d">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <SolidColorBrush x:Key="ChannelABrush" Color="#7C8B9D" />

        <!--  分段控件内的单选按钮  -->
        <Style x:Key="SegmentRadioStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource DevKitTextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="SegmentBorder"
                            Background="Transparent"
                            CornerRadius="16"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DevKitAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="{StaticResource DevKitAccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ========== 开关外壳（胶囊） ==========  -->
        <Style x:Key="SwitchPillStyle" TargetType="Border">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource DevKitSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DevKitBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="19" />
        </Style>

        <!--  ========== 开关 ==========  -->
        <Style x:Key="SwitchStyle" TargetType="CheckBox">
            <Setter Property="Background" Value="{StaticResource DevKitBorderStrongBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border
                            x:Name="SwitchTrack"
                            Width="44"
                            Height="24"
                            Background="{TemplateBinding Background}"
                            CornerRadius="12">
                            <Ellipse
                                x:Name="SwitchThumb"
                                Width="18"
                                Height="18"
                                Margin="3,0,0,0"
                                HorizontalAlignment="Left"
                                Fill="White">
                                <Ellipse.Effect>
                                    <DropShadowEffect
                                        BlurRadius="3"
                                        Direction="270"
                                        Opacity="0.25"
                                        ShadowDepth="1"
                                        Color="{StaticResource DevKitShadowColor}" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource DevKitAccentBrush}" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  普通按钮：白底灰框，hover 蓝  -->
        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource DevKitBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource DevKitTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonContainerBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="{StaticResource DevKitAccentSoftBrush}" />
                                <Setter TargetName="ButtonContainerBorder" Property="BorderBrush" Value="{StaticResource DevKitAccentBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource DevKitAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="{StaticResource DevKitAccentPressedSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  棋盘格底纹：预览色块的透明区域  -->
        <DrawingBrush
            x:Key="CheckerBrush"
            Stretch="Fill"
            TileMode="Tile"
            Viewbox="0,0,18,18"
            ViewboxUnits="Absolute"
            Viewport="0,0,18,18"
            ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H18 V18 H0 Z" />
                    <GeometryDrawing Brush="#E9EDF3" Geometry="M0,0 H9 V9 H0 Z M9,9 H18 V18 H9 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!--  主按钮：accent 蓝底白字  -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="{StaticResource DevKitAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DevKitAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="PrimaryBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="{StaticResource DevKitAccentHoverBrush}" />
                                <Setter TargetName="PrimaryBorder" Property="BorderBrush" Value="{StaticResource DevKitAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="{StaticResource DevKitAccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  圆角输入框  -->
        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Width" Value="72" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Background" Value="{StaticResource DevKitSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DevKitBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="FieldBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource DevKitAccentBrush}" />
                                <Setter TargetName="FieldBorder" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  颜色通道 Slider  -->
        <Style x:Key="ChannelSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="16" />
            <Setter Property="Maximum" Value="255" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="LargeChange" Value="16" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <!--  轨道底色：未选段  -->
                            <Border
                                Height="6"
                                VerticalAlignment="Center"
                                Background="{StaticResource DevKitBorderStrongBrush}"
                                CornerRadius="3" />

                            <Track x:Name="PART_Track">
                                <!--  已选段：通道色  -->
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton
                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"
                                        Command="{x:Static Slider.DecreaseLarge}"
                                        Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border
                                                    Height="6"
                                                    VerticalAlignment="Center"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="3" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <!--  未选段：保持透明  -->
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>

                                <!--  滑块  -->
                                <Track.Thumb>
                                    <Thumb
                                        Width="16"
                                        Height="16"
                                        Focusable="False"
                                        Foreground="{TemplateBinding Foreground}">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse
                                                    x:Name="ThumbCircle"
                                                    Fill="White"
                                                    Stroke="{TemplateBinding Foreground}"
                                                    StrokeThickness="2">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect
                                                            BlurRadius="4"
                                                            Direction="270"
                                                            Opacity="0.25"
                                                            ShadowDepth="1"
                                                            Color="{StaticResource DevKitShadowColor}" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbCircle" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform CenterX="8" CenterY="8" ScaleX="1.25" ScaleY="1.25" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Color 卡片按钮：点击打开所在文件夹  -->
        <Style x:Key="ColorCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DevKitSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DevKitBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="CardBorder"
                            Padding="12,8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="18">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource DevKitAccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource DevKitAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <cvt:ForegroundConverter x:Key="ForegroundConverterKey" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="16,12"
                VerticalAlignment="Center"
                Orientation="Horizontal">

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{StaticResource DevKitTextSecondaryBrush}"
                    Text="转换模式" />

                <Border
                    Margin="8,0,0,0"
                    Padding="3"
                    Background="{StaticResource DevKitSurfaceBrush}"
                    BorderBrush="{DynamicResource DevKitBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            Content="RGB → HEX"
                            GroupName="ColorMode"
                            IsChecked="{Binding IsToHexSelected, Mode=TwoWay}"
                            Style="{StaticResource SegmentRadioStyle}" />

                        <RadioButton
                            Content="HEX → RGB"
                            GroupName="ColorMode"
                            IsChecked="{Binding IsHexToRgbSelected, Mode=TwoWay}"
                            Style="{StaticResource SegmentRadioStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border
                Grid.Column="1"
                Margin="16,0"
                HorizontalAlignment="Right"
                Style="{StaticResource SwitchPillStyle}">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{StaticResource DevKitTextSecondaryBrush}"
                        Text="透明通道" />
                    <CheckBox IsChecked="{Binding IsAlphaBoxChecked}" Style="{StaticResource SwitchStyle}" />
                </StackPanel>
            </Border>

            <Button
                Grid.Column="2"
                Command="{Binding RandomColorCommand}"
                Style="{StaticResource CompactButtonStyle}">
                <Button.Content>
                    <StackPanel Margin="16,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="/DevKit;component/Fonts/#iconfont"
                            FontSize="16"
                            Text="&#xe750;" />
                        <TextBlock
                            Margin="8,0,0,0"
                            FontSize="13"
                            Text="随机" />
                    </StackPanel>
                </Button.Content>
            </Button>

            <Button
                Grid.Column="3"
                Margin="16,0"
                Command="{Binding ResetCommand}"
                Style="{StaticResource CompactButtonStyle}">
                <Button.Content>
                    <StackPanel Margin="16,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="/DevKit;component/Fonts/#iconfont"
                            FontSize="16"
                            Text="&#xe602;" />
                        <TextBlock
                            Margin="8,0,0,0"
                            FontSize="13"
                            Text="重置" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="16"
                Background="White"
                BorderBrush="{StaticResource DevKitBorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <!--  ========== 预览色块 ==========  -->
                    <Border
                        Grid.Row="0"
                        Height="192"
                        Background="{StaticResource CheckerBrush}"
                        CornerRadius="16"
                        Cursor="Hand"
                        SnapsToDevicePixels="True"
                        ToolTip="点击复制当前颜色">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding CopyColorHexValueCommand}" MouseAction="LeftClick" />
                        </Border.InputBindings>

                        <Grid>
                            <!--  当前颜色：含 Alpha，可透出下层棋盘格  -->
                            <Border Background="{Binding ColorViewBrush}" CornerRadius="16" />

                            <!--  1px 内描边  -->
                            <Border
                                BorderBrush="#1413223D"
                                BorderThickness="1"
                                CornerRadius="16"
                                IsHitTestVisible="False" />

                            <!--  Alpha 徽章  -->
                            <Border
                                Margin="12"
                                Padding="12,4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="#BDFFFFFF"
                                CornerRadius="12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    Foreground="{StaticResource DevKitTextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAlphaBoxChecked}" Value="True">
                                                    <Setter Property="Text" Value="{Binding AlphaValue, StringFormat={}Alpha {0}, FallbackValue=Alpha 255}" />
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding IsAlphaBoxChecked}" Value="False">
                                                    <Setter Property="Text" Value="不透明" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!--  悬停提示  -->
                            <Border
                                Margin="12"
                                Padding="12,4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="#BDFFFFFF"
                                CornerRadius="12"
                                IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{StaticResource DevKitTextSecondaryBrush}"
                                    Text="点击复制" />
                            </Border>
                        </Grid>
                    </Border>

                    <!--  ========== HEX 行 ==========  -->
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Height="36"
                            Background="{StaticResource DevKitSurfaceBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource DevKitBorderBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsToHexSelected}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Setter Property="Opacity" Value="0.6" />
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=ColorHexTextBox}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource DevKitAccentBrush}" />
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect
                                                        BlurRadius="6"
                                                        Opacity="0.18"
                                                        ShadowDepth="0"
                                                        Color="{StaticResource DevKitAccentColor}" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DevKitTextMutedBrush}"
                                    Text="#" />

                                <TextBox
                                    x:Name="ColorHexTextBox"
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontFamily="Consolas"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource DevKitTextBrush}"
                                    MaxLength="8"
                                    Text="{Binding ColorHexValue, UpdateSourceTrigger=PropertyChanged}">
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="TextChanged">
                                            <b:InvokeCommandAction Command="{Binding ColorHexTextChangedCommand}" CommandParameter="{Binding ElementName=ColorHexTextBox, Path=Text}" />
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                </TextBox>
                            </Grid>
                        </Border>

                        <Button
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Command="{Binding CopyColorHexValueCommand}"
                            Style="{StaticResource PrimaryButtonStyle}">
                            <Button.Content>
                                <StackPanel Margin="8,0" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="16"
                                        Text="&#xe66c;" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="White"
                                        Text="复制" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </Grid>

                    <!--  ========== 通道滑块 ==========  -->
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsToHexSelected}" Value="False">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!--  A  -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAlphaBoxChecked}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Setter Property="Opacity" Value="0.6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Width="28"
                                Height="28"
                                VerticalAlignment="Center"
                                Background="{StaticResource ChannelABrush}"
                                CornerRadius="8">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="A" />
                            </Border>

                            <Slider
                                Grid.Column="1"
                                Margin="12,0"
                                Foreground="{StaticResource ChannelABrush}"
                                Style="{StaticResource ChannelSliderStyle}"
                                Value="{Binding AlphaValue, Mode=TwoWay}" />

                            <TextBox
                                x:Name="AlphaInputTextBox"
                                Grid.Column="2"
                                Style="{StaticResource FieldTextBoxStyle}"
                                Text="{Binding AlphaValue, UpdateSourceTrigger=PropertyChanged}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="TextChanged">
                                        <b:InvokeCommandAction Command="{Binding AlphaColorTextChangedCommand}" CommandParameter="{Binding ElementName=AlphaInputTextBox, Path=Text}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TextBox>
                        </Grid>

                        <!--  R  -->
                        <Grid Margin="0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Width="28"
                                Height="28"
                                VerticalAlignment="Center"
                                Background="{StaticResource DevKitDangerBrush}"
                                CornerRadius="8">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="R" />
                            </Border>

                            <Slider
                                Grid.Column="1"
                                Margin="12,0"
                                Foreground="{StaticResource DevKitDangerBrush}"
                                Style="{StaticResource ChannelSliderStyle}"
                                Value="{Binding RedColor, Mode=TwoWay}" />

                            <TextBox
                                x:Name="RedInputTextBox"
                                Grid.Column="2"
                                Style="{StaticResource FieldTextBoxStyle}"
                                Text="{Binding RedColor, UpdateSourceTrigger=PropertyChanged}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="TextChanged">
                                        <b:InvokeCommandAction Command="{Binding RedColorTextChangedCommand}" CommandParameter="{Binding ElementName=RedInputTextBox, Path=Text}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TextBox>
                        </Grid>

                        <!--  G  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Width="28"
                                Height="28"
                                VerticalAlignment="Center"
                                Background="{StaticResource DevKitSuccessBrush}"
                                CornerRadius="8">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="G" />
                            </Border>

                            <Slider
                                Grid.Column="1"
                                Margin="12,0"
                                Foreground="{StaticResource DevKitSuccessBrush}"
                                Style="{StaticResource ChannelSliderStyle}"
                                Value="{Binding GreenColor, Mode=TwoWay}" />

                            <TextBox
                                x:Name="GreenInputTextBox"
                                Grid.Column="2"
                                Style="{StaticResource FieldTextBoxStyle}"
                                Text="{Binding GreenColor, UpdateSourceTrigger=PropertyChanged}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="TextChanged">
                                        <b:InvokeCommandAction Command="{Binding GreenColorTextChangedCommand}" CommandParameter="{Binding ElementName=GreenInputTextBox, Path=Text}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TextBox>
                        </Grid>

                        <!--  B  -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Width="28"
                                Height="28"
                                VerticalAlignment="Center"
                                Background="{StaticResource DevKitAccentBrush}"
                                CornerRadius="8">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="B" />
                            </Border>

                            <Slider
                                Grid.Column="1"
                                Margin="12,0"
                                Foreground="{StaticResource DevKitAccentBrush}"
                                Style="{StaticResource ChannelSliderStyle}"
                                Value="{Binding BlueColor, Mode=TwoWay}" />

                            <TextBox
                                x:Name="BlueInputTextBox"
                                Grid.Column="2"
                                Style="{StaticResource FieldTextBoxStyle}"
                                Text="{Binding BlueColor, UpdateSourceTrigger=PropertyChanged}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="TextChanged">
                                        <b:InvokeCommandAction Command="{Binding BlueColorTextChangedCommand}" CommandParameter="{Binding ElementName=BlueInputTextBox, Path=Text}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TextBox>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,16">
                        <Line
                            SnapsToDevicePixels="True"
                            Stroke="{DynamicResource DevKitBorderBrush}"
                            StrokeDashArray="4,3"
                            StrokeThickness="1"
                            X1="0"
                            X2="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                            Y1="0.5"
                            Y2="0.5" />
                    </Grid>

                    <!--  ========== 最近使用 ==========  -->
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Foreground="{StaticResource DevKitTextMutedBrush}"
                            Text="最近使用" />

                        <ListBox
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding RecentlyColors}"
                            ScrollViewer.CanContentScroll="False"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <!--  空状态模板  -->
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <Grid>
                                        <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                            <ItemsPresenter />
                                        </ScrollViewer>

                                        <StackPanel
                                            x:Name="EmptyHint"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontFamily="/DevKit;component/Fonts/#iconfont"
                                                FontSize="40"
                                                Foreground="{StaticResource DevKitIconMutedBrush}"
                                                Text="&#xe660;" />
                                            <TextBlock
                                                Margin="0,10,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="13"
                                                Foreground="{StaticResource DevKitTextMutedBrush}"
                                                Text="暂无颜色处理记录" />
                                        </StackPanel>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter TargetName="EmptyHint" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ListBox.Template>

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,8,8" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Command="{Binding DataContext.RecentlyColorSelectedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ColorCardButtonStyle}">
                                        <Button.Content>
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <Ellipse
                                                    Width="12"
                                                    Height="12"
                                                    Fill="{Binding}" />

                                                <TextBlock
                                                    Margin="10,0,0,0"
                                                    FontFamily="Consolas"
                                                    FontSize="14"
                                                    Text="{Binding}" />
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Margin="16,0,0,0"
                Background="White"
                BorderBrush="{StaticResource DevKitBorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="微软雅黑"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="Black"
                            Text="预设色板" />

                        <Border
                            Grid.Column="1"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource DevKitAccent12Brush}"
                            CornerRadius="12">
                            <TextBlock
                                Margin="8,2"
                                FontFamily="微软雅黑"
                                Foreground="{StaticResource DevKitAccentBrush}"
                                Text="{Binding ColorResources.Count, FallbackValue=0}" />
                        </Border>

                        <Border
                            Grid.Column="2"
                            Width="256"
                            Height="34"
                            HorizontalAlignment="Right"
                            Background="{StaticResource DevKitSurfaceBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource DevKitBorderBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=ColorSearchTextBox}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource DevKitAccentBrush}" />
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect
                                                        BlurRadius="6"
                                                        Opacity="0.18"
                                                        ShadowDepth="0"
                                                        Color="{StaticResource DevKitAccentColor}" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  搜索图标  -->
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontFamily="/DevKit;component/Fonts/#iconfont"
                                    FontSize="18"
                                    Foreground="{StaticResource DevKitTextMutedBrush}"
                                    Text="&#xe6cc;" />

                                <!--  输入框 + placeholder  -->
                                <Grid Grid.Column="1">
                                    <TextBox
                                        x:Name="ColorSearchTextBox"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="13"
                                        Foreground="{DynamicResource DevKitTextBrush}"
                                        Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource DevKitTextMutedBrush}"
                                        IsHitTestVisible="False"
                                        Text="搜索名称或色值，如 主色 / F2E7CF">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=ColorSearchTextBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <ListBox
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding ColorResources}"
                        ScrollViewer.CanContentScroll="False"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,8,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ColorItemClickedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Width" Value="136" />
                                            <Setter Property="Background" Value="{Binding Hex}" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border
                                                            x:Name="CardBorder"
                                                            Padding="16,12"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="8">
                                                            <ContentPresenter />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>

                                    <Button.Content>
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                                <TextBlock
                                                    FontSize="16"
                                                    Foreground="{Binding Hex, Converter={StaticResource ForegroundConverterKey}}"
                                                    Text="{Binding Name}" />

                                                <TextBlock
                                                    x:Name="HexTextBlock"
                                                    Margin="0,8,0,0"
                                                    FontFamily="Consolas"
                                                    FontSize="14"
                                                    Foreground="{Binding Hex, Converter={StaticResource ForegroundConverterKey}}"
                                                    Text="{Binding Hex}" />
                                            </StackPanel>

                                            <TextBlock
                                                x:Name="CopyIconTextBlock"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                FontFamily="/DevKit;component/Fonts/#iconfont"
                                                FontSize="16"
                                                Foreground="{Binding Hex, Converter={StaticResource ForegroundConverterKey}}"
                                                Text="&#xe66c;">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Button.Content>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Background="{StaticResource DevKitBorderBrush}" />

                    <TextBlock
                        Grid.Row="3"
                        Margin="16,18"
                        Foreground="{StaticResource DevKitTextSecondaryBrush}"
                        Text="单击色板 → 复制 HEX 并回填到左侧通道； RGB → HEX 模式下左侧色值由通道自动计算。" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="16"
                Foreground="{StaticResource DevKitTextSecondaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsToHexSelected}" Value="True">
                                <Setter Property="Text" Value="RGB → HEX 模式 · 拖动通道实时同步" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsToHexSelected}" Value="False">
                                <Setter Property="Text" Value="HEX → RGB 模式 · 输入色值反解通道" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock
                Grid.Column="1"
                Margin="16"
                HorizontalAlignment="Right"
                Foreground="{StaticResource DevKitTextSecondaryBrush}"
                Text="{Binding CurrentColorHex, StringFormat={}当前颜色 {0}}" />
        </Grid>
    </Grid>
</UserControl>
