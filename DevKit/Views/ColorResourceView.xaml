<UserControl
    x:Class="DevKit.Views.ColorResourceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:cvt="clr-namespace:DevKit.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:DevKit.ViewModels"
    Width="1080"
    Height="800"
    d:DataContext="{d:DesignInstance Type=vm:ColorResourceViewModel}"
    Background="{DynamicResource DevKitBackgroundBrush}"
    mc:Ignorable="d">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <SolidColorBrush x:Key="TextBlockForegroundBrush" Color="#5f6b7a" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F9FC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#93A0AE" />
        <SolidColorBrush x:Key="BorderStrongBrush" Color="#DFE3EA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2E7CF6" />

        <!--  通道标识色  -->
        <SolidColorBrush x:Key="ChannelABrush" Color="#7C8B9D" />
        <SolidColorBrush x:Key="ChannelRBrush" Color="#E5484D" />
        <SolidColorBrush x:Key="ChannelGBrush" Color="#16A34A" />
        <SolidColorBrush x:Key="ChannelBBrush" Color="#2E7CF6" />

        <!--  分段控件内的单选按钮  -->
        <Style x:Key="SegmentRadioStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="SegmentBorder"
                            Background="Transparent"
                            CornerRadius="16"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ========== 开关外壳（胶囊） ==========  -->
        <Style x:Key="SwitchPillStyle" TargetType="Border">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DevKitBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="19" />
        </Style>

        <!--  ========== 开关 ==========  -->
        <Style x:Key="SwitchStyle" TargetType="CheckBox">
            <Setter Property="Background" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border
                            x:Name="SwitchTrack"
                            Width="44"
                            Height="24"
                            Background="{TemplateBinding Background}"
                            CornerRadius="12">
                            <Ellipse
                                x:Name="SwitchThumb"
                                Width="18"
                                Height="18"
                                Margin="3,0,0,0"
                                HorizontalAlignment="Left"
                                Fill="White">
                                <Ellipse.Effect>
                                    <DropShadowEffect
                                        BlurRadius="3"
                                        Direction="270"
                                        Opacity="0.25"
                                        ShadowDepth="1"
                                        Color="#13223D" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  普通按钮：白底灰框，hover 蓝  -->
        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DFE3EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource DevKitTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonContainerBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="#EAF1FE" />
                                <Setter TargetName="ButtonContainerBorder" Property="BorderBrush" Value="#2E7CF6" />
                                <Setter Property="TextElement.Foreground" Value="#2E7CF6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonContainerBorder" Property="Background" Value="#D9E7FD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  棋盘格底纹：预览色块的透明区域  -->
        <DrawingBrush
            x:Key="CheckerBrush"
            Stretch="Fill"
            TileMode="Tile"
            Viewbox="0,0,18,18"
            ViewboxUnits="Absolute"
            Viewport="0,0,18,18"
            ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H18 V18 H0 Z" />
                    <GeometryDrawing Brush="#E9EDF3" Geometry="M0,0 H9 V9 H0 Z M9,9 H18 V18 H9 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!--  主按钮：accent 蓝底白字  -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="PrimaryBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="#1F6EE8" />
                                <Setter TargetName="PrimaryBorder" Property="BorderBrush" Value="#1F6EE8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="#1A5CC4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  圆角输入框  -->
        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Width" Value="72" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Background" Value="#F7F9FC" />
            <Setter Property="BorderBrush" Value="#DFE3EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="FieldBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#2E7CF6" />
                                <Setter TargetName="FieldBorder" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <cvt:ColorTagForegroundConverter x:Key="ColorTagForegroundConverterKey" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="16,12"
                VerticalAlignment="Center"
                Orientation="Horizontal">

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{StaticResource TextBlockForegroundBrush}"
                    Text="转换模式" />

                <Border
                    Margin="8,0,0,0"
                    Padding="3"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DevKitBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            Content="RGB → HEX"
                            GroupName="ColorMode"
                            IsChecked="{Binding IsHexSelected, Mode=TwoWay}"
                            Style="{StaticResource SegmentRadioStyle}" />

                        <RadioButton
                            Content="HEX → RGB"
                            GroupName="ColorMode"
                            Style="{StaticResource SegmentRadioStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border
                Grid.Column="1"
                Margin="16,0"
                HorizontalAlignment="Right"
                Style="{StaticResource SwitchPillStyle}">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="透明通道" />
                    <CheckBox IsChecked="{Binding IsAlphaBoxChecked}" Style="{StaticResource SwitchStyle}" />
                </StackPanel>
            </Border>

            <Button
                Grid.Column="2"
                Command="{Binding RandomColorCommand}"
                Style="{StaticResource CompactButtonStyle}">
                <Button.Content>
                    <StackPanel Margin="16,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="/DevKit;component/Fonts/#iconfont"
                            FontSize="16"
                            Text="&#xe750;" />
                        <TextBlock
                            Margin="8,0,0,0"
                            FontSize="13"
                            Text="随机" />
                    </StackPanel>
                </Button.Content>
            </Button>

            <Button
                Grid.Column="3"
                Margin="16,0"
                Command="{Binding ResetCommand}"
                Style="{StaticResource CompactButtonStyle}">
                <Button.Content>
                    <StackPanel Margin="16,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="/DevKit;component/Fonts/#iconfont"
                            FontSize="16"
                            Text="&#xe602;" />
                        <TextBlock
                            Margin="8,0,0,0"
                            FontSize="13"
                            Text="重置" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="16"
                Background="White"
                BorderBrush="{StaticResource DevKitBorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  ========== 预览色块 ==========  -->
                    <Border
                        Grid.Row="0"
                        Height="192"
                        Background="{StaticResource CheckerBrush}"
                        CornerRadius="16"
                        Cursor="Hand"
                        SnapsToDevicePixels="True"
                        ToolTip="点击复制当前颜色">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding CopyColorHexValueCommand}" MouseAction="LeftClick" />
                        </Border.InputBindings>

                        <Grid>
                            <!--  当前颜色：含 Alpha，可透出下层棋盘格  -->
                            <Border Background="{Binding ColorViewBrush}" CornerRadius="16" />

                            <!--  1px 内描边  -->
                            <Border
                                BorderBrush="#1413223D"
                                BorderThickness="1"
                                CornerRadius="16"
                                IsHitTestVisible="False" />

                            <!--  Alpha 徽章  -->
                            <Border
                                Margin="12"
                                Padding="12,4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="#BDFFFFFF"
                                CornerRadius="12">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    Foreground="#1B1B1B"
                                    Text="{Binding AlphaValue, StringFormat={}A {0}}" />
                            </Border>

                            <!--  悬停提示  -->
                            <Border
                                Margin="12"
                                Padding="12,4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="#BDFFFFFF"
                                CornerRadius="12"
                                IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#5F6B7A"
                                    Text="点击复制" />
                            </Border>
                        </Grid>
                    </Border>

                    <!--  ========== HEX 行 ==========  -->
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Height="36"
                            Background="#F7F9FC"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource DevKitBorderBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=ColorHexTextBox}" Value="True">
                                            <Setter Property="BorderBrush" Value="#2E7CF6" />
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect
                                                        BlurRadius="6"
                                                        Opacity="0.18"
                                                        ShadowDepth="0"
                                                        Color="#2E7CF6" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="#93A0AE"
                                    Text="#" />

                                <TextBox
                                    x:Name="ColorHexTextBox"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontFamily="Consolas"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource DevKitTextBrush}"
                                    MaxLength="8"
                                    Text="{Binding ColorHexValue, UpdateSourceTrigger=PropertyChanged}">
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="TextChanged">
                                            <b:InvokeCommandAction Command="{Binding ColorHexTextChangedCommand}" CommandParameter="{Binding ElementName=HexInputTextBox, Path=Text}" />
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                </TextBox>
                            </Grid>
                        </Border>

                        <Button
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Command="{Binding CopyColorHexValueCommand}"
                            Style="{StaticResource PrimaryButtonStyle}">
                            <Button.Content>
                                <StackPanel Margin="8,0" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="16"
                                        Text="&#xe66c;" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="White"
                                        Text="复制" />
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </Grid>

                    <!--  ========== 通道滑块 ==========  -->
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">

                        <!--  A  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="28"
                                Height="28"
                                VerticalAlignment="Center"
                                Background="{StaticResource ChannelABrush}"
                                CornerRadius="8">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="A" />
                            </Border>

                            <Slider
                                Grid.Column="1"
                                Margin="12,0"
                                VerticalAlignment="Center"
                                IsSnapToTickEnabled="True"
                                LargeChange="16"
                                Maximum="255"
                                Minimum="0"
                                SmallChange="1"
                                TickFrequency="1"
                                Value="{Binding AlphaValue, Mode=TwoWay}" />

                            <TextBox
                                x:Name="AlphaInputTextBox"
                                Grid.Column="2"
                                Style="{StaticResource FieldTextBoxStyle}"
                                Text="{Binding AlphaValue, UpdateSourceTrigger=PropertyChanged}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="TextChanged">
                                        <b:InvokeCommandAction Command="{Binding AlphaColorTextChangedCommand}" CommandParameter="{Binding ElementName=AlphaInputTextBox, Path=Text}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TextBox>
                        </Grid>

                        <!--  R  -->
                        <Grid Margin="0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="28"
                                Height="28"
                                VerticalAlignment="Center"
                                Background="{StaticResource ChannelRBrush}"
                                CornerRadius="8">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="R" />
                            </Border>

                            <Slider
                                Grid.Column="1"
                                Margin="12,0"
                                VerticalAlignment="Center"
                                IsSnapToTickEnabled="True"
                                LargeChange="16"
                                Maximum="255"
                                Minimum="0"
                                SmallChange="1"
                                TickFrequency="1"
                                Value="{Binding RedColor, Mode=TwoWay}" />

                            <TextBox
                                x:Name="RedInputTextBox"
                                Grid.Column="2"
                                Style="{StaticResource FieldTextBoxStyle}"
                                Text="{Binding RedColor, UpdateSourceTrigger=PropertyChanged}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="TextChanged">
                                        <b:InvokeCommandAction Command="{Binding RedColorTextChangedCommand}" CommandParameter="{Binding ElementName=RedInputTextBox, Path=Text}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TextBox>
                        </Grid>

                        <!--  G  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="28"
                                Height="28"
                                VerticalAlignment="Center"
                                Background="{StaticResource ChannelGBrush}"
                                CornerRadius="8">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="G" />
                            </Border>

                            <Slider
                                Grid.Column="1"
                                Margin="12,0"
                                VerticalAlignment="Center"
                                IsSnapToTickEnabled="True"
                                LargeChange="16"
                                Maximum="255"
                                Minimum="0"
                                SmallChange="1"
                                TickFrequency="1"
                                Value="{Binding GreenColor, Mode=TwoWay}" />

                            <TextBox
                                x:Name="GreenInputTextBox"
                                Grid.Column="2"
                                Style="{StaticResource FieldTextBoxStyle}"
                                Text="{Binding GreenColor, UpdateSourceTrigger=PropertyChanged}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="TextChanged">
                                        <b:InvokeCommandAction Command="{Binding GreenColorTextChangedCommand}" CommandParameter="{Binding ElementName=GreenInputTextBox, Path=Text}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TextBox>
                        </Grid>

                        <!--  B  -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="28"
                                Height="28"
                                VerticalAlignment="Center"
                                Background="{StaticResource ChannelBBrush}"
                                CornerRadius="8">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="B" />
                            </Border>

                            <Slider
                                Grid.Column="1"
                                Margin="12,0"
                                VerticalAlignment="Center"
                                IsSnapToTickEnabled="True"
                                LargeChange="16"
                                Maximum="255"
                                Minimum="0"
                                SmallChange="1"
                                TickFrequency="1"
                                Value="{Binding BlueColor, Mode=TwoWay}" />

                            <TextBox
                                x:Name="BlueInputTextBox"
                                Grid.Column="2"
                                Style="{StaticResource FieldTextBoxStyle}"
                                Text="{Binding BlueColor, UpdateSourceTrigger=PropertyChanged}">
                                <b:Interaction.Triggers>
                                    <b:EventTrigger EventName="TextChanged">
                                        <b:InvokeCommandAction Command="{Binding BlueColorTextChangedCommand}" CommandParameter="{Binding ElementName=BlueInputTextBox, Path=Text}" />
                                    </b:EventTrigger>
                                </b:Interaction.Triggers>
                            </TextBox>
                        </Grid>
                    </StackPanel>

                    <!--  ========== 最近使用 ==========  -->
                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                        <TextBlock
                            FontSize="11.5"
