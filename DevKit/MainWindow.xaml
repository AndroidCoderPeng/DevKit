<Window
    x:Class="DevKit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:DevKit.ViewModels"
    Title="DevKit（开发者工具箱）"
    Width="434"
    Height="756"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    Background="{DynamicResource DevKitBackgroundBrush}"
    ResizeMode="CanMinimize"
    WindowStartupLocation="Manual"
    mc:Ignorable="d">

    <Window.Resources>
        <Style x:Key="TopmostSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Track"
                            Background="{StaticResource DevKitBorderStrongBrush}"
                            CornerRadius="12">
                            <Ellipse
                                x:Name="Thumb"
                                Width="18"
                                Height="18"
                                Margin="3,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Fill="White"
                                RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect
                                        BlurRadius="4"
                                        Direction="270"
                                        Opacity="0.25"
                                        ShadowDepth="1"
                                        Color="{StaticResource DevKitShadowColor}" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource DevKitAccentBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="Thumb"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                To="12"
                                                Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="Thumb"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                To="0"
                                                Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="White"
                BorderBrush="{DynamicResource DevKitBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontFamily="/DevKit;component/Fonts/#iconfont"
                        FontSize="16"
                        Foreground="{StaticResource DevKitTextSecondaryBrush}"
                        Text="&#xe6c2;" />

                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource DevKitTextSecondaryBrush}"
                        Text="置顶显示" />

                    <ToggleButton
                        Grid.Column="2"
                        Checked="TopmostToggleButton_Checked"
                        Style="{StaticResource TopmostSwitchStyle}"
                        Unchecked="TopmostToggleButton_Unchecked" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="4,16,4,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    FontFamily="微软雅黑"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="Black"
                    Text="Android工具" />

                <Border
                    Grid.Column="1"
                    Margin="8,0"
                    Background="{StaticResource DevKitAccent12Brush}"
                    CornerRadius="12">
                    <TextBlock
                        Margin="8,2"
                        FontFamily="微软雅黑"
                        Foreground="{StaticResource DevKitAccentBrush}"
                        Text="{Binding AndroidTools.Count}" />
                </Border>

                <Border
                    Grid.Column="2"
                    Height="1"
                    Background="{DynamicResource DevKitBorderBrush}" />
            </Grid>

            <ListBox
                Grid.Row="2"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding AndroidTools}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border
                            x:Name="MenuItemBorder"
                            Width="114"
                            Height="104"
                            Margin="4"
                            Background="White"
                            BorderBrush="{StaticResource DevKitBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                <Border
                                    Width="48"
                                    Height="48"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource DevKitAndroidGreen12Brush}"
                                    CornerRadius="12">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="24"
                                        Foreground="{StaticResource DevKitSuccessBrush}"
                                        Text="{Binding MenuIcon}" />
                                </Border>

                                <TextBlock
                                    x:Name="NameTextBlock"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource DevKitTextSecondaryBrush}"
                                    Text="{Binding MenuName}" />
                            </StackPanel>
                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="{StaticResource DevKitAndroidGreen12Brush}" />
                                <Setter TargetName="MenuItemBorder" Property="BorderBrush" Value="{StaticResource DevKitAndroidGreen35Brush}" />
                                <Setter TargetName="NameTextBlock" Property="Foreground" Value="{StaticResource DevKitSuccessBrush}" />
                                <Setter TargetName="NameTextBlock" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Foreground" Value="{StaticResource DevKitTextSecondaryBrush}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="PreviewMouseUp">
                        <b:InvokeCommandAction Command="{Binding DataContext.ToolItemClickedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </ListBox>

            <Grid Grid.Row="3" Margin="4,16,4,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    FontFamily="微软雅黑"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="Black"
                    Text="Socket通信工具" />

                <Border
                    Grid.Column="1"
                    Margin="8,0"
                    Background="{StaticResource DevKitAccent12Brush}"
                    CornerRadius="12">
                    <TextBlock
                        Margin="8,2"
                        FontFamily="微软雅黑"
                        Foreground="{StaticResource DevKitAccentBrush}"
                        Text="{Binding SocketTools.Count}" />
                </Border>

                <Border
                    Grid.Column="2"
                    Height="1"
                    Background="{DynamicResource DevKitBorderBrush}" />
            </Grid>

            <ListBox
                Grid.Row="4"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding SocketTools}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border
                            x:Name="CardBorder"
                            Width="114"
                            Height="104"
                            Margin="4"
                            Background="White"
                            BorderBrush="{StaticResource DevKitBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">


                            <StackPanel VerticalAlignment="Center">
                                <Border
                                    Width="48"
                                    Height="48"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource DevKitAccent12Brush}"
                                    CornerRadius="12">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="24"
                                        Foreground="{StaticResource DevKitAccentBrush}"
                                        Text="{Binding MenuIcon}" />
                                </Border>

                                <TextBlock
                                    x:Name="NameTextBlock"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource DevKitTextSecondaryBrush}"
                                    Text="{Binding MenuName}" />
                            </StackPanel>
                        </Border>

                        <DataTemplate.Triggers>
                            <Trigger SourceName="CardBorder" Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource DevKitAccent12Brush}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource DevKitAccent35Brush}" />
                                <Setter TargetName="NameTextBlock" Property="Foreground" Value="{StaticResource DevKitAccentBrush}" />
                                <Setter TargetName="NameTextBlock" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Foreground" Value="{StaticResource DevKitTextSecondaryBrush}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="PreviewMouseUp">
                        <b:InvokeCommandAction Command="{Binding DataContext.ToolItemClickedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </ListBox>

            <Grid Grid.Row="5" Margin="4,16,4,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    FontFamily="微软雅黑"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="Black"
                    Text="其他工具" />

                <Border
                    Grid.Column="1"
                    Margin="8,0"
                    Background="{StaticResource DevKitAccent12Brush}"
                    CornerRadius="12">
                    <TextBlock
                        Margin="8,2"
                        FontFamily="微软雅黑"
                        Foreground="{StaticResource DevKitAccentBrush}"
                        Text="{Binding OtherTools.Count}" />
                </Border>

                <Border
                    Grid.Column="2"
                    Height="1"
                    Background="{DynamicResource DevKitBorderBrush}" />
            </Grid>

            <ListBox
                Grid.Row="6"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding OtherTools}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border
                            x:Name="CardBorder"
                            Width="114"
                            Height="104"
                            Margin="4"
                            Background="White"
                            BorderBrush="{StaticResource DevKitBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel VerticalAlignment="Center">
                                <Border
                                    Width="48"
                                    Height="48"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource DevKitPurple12Brush}"
                                    CornerRadius="12">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="/DevKit;component/Fonts/#iconfont"
                                        FontSize="24"
                                        Foreground="{StaticResource DevKitPurpleBrush}"
                                        Text="{Binding MenuIcon}" />
                                </Border>

                                <TextBlock
                                    x:Name="NameTextBlock"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource DevKitTextSecondaryBrush}"
                                    Text="{Binding MenuName}" />
                            </StackPanel>
                        </Border>

                        <DataTemplate.Triggers>
                            <Trigger SourceName="CardBorder" Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource DevKitPurple12Brush}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource DevKitPurple35Brush}" />
                                <Setter TargetName="NameTextBlock" Property="Foreground" Value="{StaticResource DevKitPurpleBrush}" />
                                <Setter TargetName="NameTextBlock" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Foreground" Value="{StaticResource DevKitTextSecondaryBrush}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="PreviewMouseUp">
                        <b:InvokeCommandAction Command="{Binding DataContext.ToolItemClickedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </ListBox>
        </Grid>

        <DockPanel
            Grid.Row="1"
            Background="White"
            LastChildFill="True">
            <TextBlock
                Margin="16"
                Foreground="{StaticResource DevKitTextSecondaryBrush}"
                Text="DevKit · 已就绪" />

            <TextBlock
                Margin="16"
                HorizontalAlignment="Right"
                Foreground="{StaticResource DevKitTextSecondaryBrush}"
                Text="点击工具卡片即可打开" />
        </DockPanel>
    </Grid>
</Window>