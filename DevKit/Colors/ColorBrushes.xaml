<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:o="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <!--  ===== 颜色值 =====  -->
    <Color x:Key="DevKitAccentColor">#2E7CF6</Color>
    <Color x:Key="DevKitAccentLightColor">#6AA9FF</Color>
    <Color x:Key="DevKitShadowColor">#13223D</Color>
    <Color x:Key="DevKitAndroidGreenColor">#3DDC84</Color>
    <Color x:Key="DevKitSuccessColor">#17A95C</Color>
    <Color x:Key="DevKitGreenLightColor">#6FE0A5</Color>

    <!--  ===== 背景 =====  -->
    <SolidColorBrush
        x:Key="DevKitBackgroundBrush"
        o:Freeze="True"
        Color="#F7F9FC" />

    <!--  ===== 品牌主色（蓝） =====  -->
    <SolidColorBrush
        x:Key="DevKitAccentBrush"
        o:Freeze="True"
        Color="{StaticResource DevKitAccentColor}" />
    <SolidColorBrush
        x:Key="DevKitAccentHoverBrush"
        o:Freeze="True"
        Color="#1C6AE0" />
    <SolidColorBrush
        x:Key="DevKitAccentPressedBrush"
        o:Freeze="True"
        Color="#1556C0" />
    <SolidColorBrush
        x:Key="DevKitAccentLightBrush"
        o:Freeze="True"
        Color="{StaticResource DevKitAccentLightColor}" />
    <SolidColorBrush
        x:Key="DevKitAccentSoftBrush"
        o:Freeze="True"
        Color="#EAF1FE" />
    <SolidColorBrush
        x:Key="DevKitAccentPressedSoftBrush"
        o:Freeze="True"
        Color="#D9E7FD" />
    <SolidColorBrush
        x:Key="DevKitAccent12Brush"
        o:Freeze="True"
        Color="#1F2E7CF6" />
    <SolidColorBrush
        x:Key="DevKitAccent35Brush"
        o:Freeze="True"
        Color="#592E7CF6" />

    <!--  ===== 文本 =====  -->
    <SolidColorBrush
        x:Key="DevKitTextBrush"
        o:Freeze="True"
        Color="#1B1B1B" />
    <SolidColorBrush
        x:Key="DevKitTextSecondaryBrush"
        o:Freeze="True"
        Color="#5F6B7A" />
    <SolidColorBrush
        x:Key="DevKitTextMutedBrush"
        o:Freeze="True"
        Color="#93A0AE" />

    <!--  ===== 成功 / 绿 =====  -->
    <SolidColorBrush
        x:Key="DevKitSuccessBrush"
        o:Freeze="True"
        Color="{StaticResource DevKitSuccessColor}" />
    <SolidColorBrush
        x:Key="DevKitSuccess12Brush"
        o:Freeze="True"
        Color="#1F17A95C" />
    <SolidColorBrush
        x:Key="DevKitSuccess35Brush"
        o:Freeze="True"
        Color="#5917A95C" />
    <SolidColorBrush
        x:Key="DevKitGreenLightBrush"
        o:Freeze="True"
        Color="{StaticResource DevKitGreenLightColor}" />
    <SolidColorBrush
        x:Key="DevKitAndroidGreenBrush"
        o:Freeze="True"
        Color="{StaticResource DevKitAndroidGreenColor}" />
    <SolidColorBrush
        x:Key="DevKitAndroidGreen12Brush"
        o:Freeze="True"
        Color="#1F3DDC84" />
    <SolidColorBrush
        x:Key="DevKitAndroidGreen18Brush"
        o:Freeze="True"
        Color="#2E3DDC84" />
    <SolidColorBrush
        x:Key="DevKitAndroidGreen35Brush"
        o:Freeze="True"
        Color="#593DDC84" />
    <SolidColorBrush
        x:Key="DevKitGreenHoverBrush"
        o:Freeze="True"
        Color="#E9F7F0" />

    <!--  ===== 危险 / 红 =====  -->
    <SolidColorBrush
        x:Key="DevKitDangerBrush"
        o:Freeze="True"
        Color="#E5484D" />
    <SolidColorBrush
        x:Key="DevKitDangerHoverBrush"
        o:Freeze="True"
        Color="#D13C41" />
    <SolidColorBrush
        x:Key="DevKitDangerPressedBrush"
        o:Freeze="True"
        Color="#C93A3F" />
    <SolidColorBrush
        x:Key="DevKitDangerSoftBrush"
        o:Freeze="True"
        Color="#FDEBEC" />
    <SolidColorBrush
        x:Key="DevKitDangerBorderBrush"
        o:Freeze="True"
        Color="#F0C4C6" />
    <SolidColorBrush
        x:Key="DevKitDanger40Brush"
        o:Freeze="True"
        Color="#66E5484D" />

    <!--  ===== 警告 / 紫 =====  -->
    <SolidColorBrush
        x:Key="DevKitWarningBrush"
        o:Freeze="True"
        Color="#F2994A" />
    <SolidColorBrush
        x:Key="DevKitPurpleBrush"
        o:Freeze="True"
        Color="#7C5CFF" />
    <SolidColorBrush
        x:Key="DevKitPurple12Brush"
        o:Freeze="True"
        Color="#1F7C5CFF" />
    <SolidColorBrush
        x:Key="DevKitPurple35Brush"
        o:Freeze="True"
        Color="#597C5CFF" />

    <!--  ===== 表面 / 边框 =====  -->
    <SolidColorBrush
        x:Key="DevKitSurfaceBrush"
        o:Freeze="True"
        Color="#F7F9FC" />
    <SolidColorBrush
        x:Key="DevKitBorderBrush"
        o:Freeze="True"
        Color="#EEEFF0" />
    <SolidColorBrush
        x:Key="DevKitBorderStrongBrush"
        o:Freeze="True"
        Color="#DFE3EA" />
    <SolidColorBrush
        x:Key="DevKitIconMutedBrush"
        o:Freeze="True"
        Color="#C6CDD6" />

    <!--  ===== 终端 =====  -->
    <SolidColorBrush
        x:Key="DevKitTerminalBackgroundBrush"
        o:Freeze="True"
        Color="#0C0C0C" />
    <SolidColorBrush
        x:Key="DevKitTerminalDividerBrush"
        o:Freeze="True"
        Color="#1FE7EBF1" />
    <SolidColorBrush
        x:Key="DevKitTerminalTextBrush"
        o:Freeze="True"
        Color="#C9D1D9" />
    <SolidColorBrush
        x:Key="DevKitTerminalTextDimBrush"
        o:Freeze="True"
        Color="#D9FFFFFF" />
    <SolidColorBrush
        x:Key="DevKitTrafficRedBrush"
        o:Freeze="True"
        Color="#FF5F57" />
    <SolidColorBrush
        x:Key="DevKitTrafficYellowBrush"
        o:Freeze="True"
        Color="#FEBC2E" />
    <SolidColorBrush
        x:Key="DevKitTrafficGreenBrush"
        o:Freeze="True"
        Color="#28C840" />

    <!--  JniReverse 散色并入色板  -->
    <SolidColorBrush
        x:Key="DevKitTextPlaceholderBrush"
        o:Freeze="True"
        Color="#8D97A5" />
    <SolidColorBrush
        x:Key="DevKitSuccessDarkBrush"
        o:Freeze="True"
        Color="#267453" />
    <SolidColorBrush
        x:Key="DevKitSuccessMutedBrush"
        o:Freeze="True"
        Color="#6F9683" />

    <!--  ===== 阴影 / 遮罩 =====  -->
    <SolidColorBrush
        x:Key="DevKitShadowBrush"
        o:Freeze="True"
        Color="{StaticResource DevKitShadowColor}" />
    <SolidColorBrush
        x:Key="DevKitToastBrush"
        o:Freeze="True"
        Color="#CC2B2B2B" />
</ResourceDictionary>